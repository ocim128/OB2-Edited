<Page x:Class="OpenBullet2.Native.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Home"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Performance-Optimized Section Header -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernHeading3}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        
        <!-- Lightweight Metric Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderMain}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        
        <!-- Collection Item Card Style -->
        <Style x:Key="CollectionItemStyle" TargetType="Border" BasedOn="{StaticResource MetricCardStyle}">
            <Setter Property="MinHeight" Value="90" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        
        <!-- Metric Value Style -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        
        <!-- Metric Label Style -->
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernCaptionText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        
        <!-- Performance Indicator Style -->
        <Style x:Key="PerformanceValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  VirtualizingPanel.IsVirtualizing="True" 
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
        <Grid Margin="12,8,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- System Performance Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="System Performance" 
                           Style="{StaticResource SectionHeaderStyle}" 
                           Margin="0,0,0,12" />
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- CPU Usage Card -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Cpu64Bit" 
                                                             Width="16" Height="16" 
                                                             Foreground="{StaticResource Modern.ThemeMain}"
                                                             VerticalAlignment="Center" 
                                                             Margin="0,0,6,0" />
                                <TextBlock Text="CPU Usage" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F1}%'}" 
                                       Style="{StaticResource MetricValueStyle}" 
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding CpuUsage}" 
                                         Maximum="100" 
                                         Height="4" 
                                         Background="{StaticResource Modern.BackgroundSecondary}"
                                         Foreground="{StaticResource Modern.ThemeMain}"
                                         BorderThickness="0"
                                         UseLayoutRounding="True" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Memory Usage Card -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="2,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Memory" 
                                                              Width="16" Height="16" 
                                                              Foreground="{StaticResource Modern.Success}"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,6,0" />
                                <TextBlock Text="Memory" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MemoryUsage}" 
                                       Style="{StaticResource MetricValueStyle}" 
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding MemoryUsagePercent}" 
                                         Maximum="100" 
                                         Height="4" 
                                         Background="{StaticResource Modern.BackgroundSecondary}"
                                         Foreground="{StaticResource Modern.Success}"
                                         BorderThickness="0"
                                         UseLayoutRounding="True" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Uptime Card -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="ClockOutline" 
                                                              Width="16" Height="16" 
                                                              Foreground="{StaticResource Modern.Warning}"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,6,0" />
                                <TextBlock Text="Uptime" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ApplicationUptime}" 
                                       Style="{StaticResource MetricValueStyle}" 
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Application running time" 
                                       Style="{StaticResource ModernCaptionText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Quick Actions Section -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Quick Actions" 
                           Style="{StaticResource SectionHeaderStyle}" 
                           Margin="0,0,0,12" />
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Configs Shortcut -->
                    <Button Grid.Column="0" 
                            Name="ConfigsShortcut"
                            Click="ConfigsShortcut_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,4,0"
                            Height="100"
                            Background="{StaticResource Modern.BackgroundSecondary}"
                            BorderBrush="{StaticResource Modern.BorderSecondary}"
                            BorderThickness="1">
                        <Border CornerRadius="8" Padding="16">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Configs" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Manage your configs" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    
                    <!-- Jobs Shortcut -->
                    <Button Grid.Column="1" 
                            Name="JobsShortcut"
                            Click="JobsShortcut_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="8,0,0,0"
                            Height="100"
                            Background="{StaticResource Modern.BackgroundSecondary}"
                            BorderBrush="{StaticResource Modern.BorderSecondary}"
                            BorderThickness="1">
                        <Border CornerRadius="8" Padding="16">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Jobs" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="View and manage jobs" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Your Collection Section -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Your Collection" 
                           Style="{StaticResource SectionHeaderStyle}" 
                           Margin="0,0,0,16" />
                
                <!-- Primary Collection Items -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Jobs -->
                    <Border Grid.Column="0" Style="{StaticResource CollectionItemStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Briefcase" 
                                                              Width="16" Height="16" 
                                                              Foreground="{StaticResource Modern.ThemeMain}"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Jobs" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding JobsCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Proxies -->
                    <Border Grid.Column="1" Style="{StaticResource CollectionItemStyle}" Margin="3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="ServerNetwork" 
                                                              Width="16" Height="16" 
                                                              Foreground="{StaticResource Modern.Success}"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Proxies" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProxiesCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Wordlists -->
                    <Border Grid.Column="2" Style="{StaticResource CollectionItemStyle}" Margin="3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" 
                                                              Width="16" Height="16" 
                                                              Foreground="{StaticResource Modern.Warning}"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Wordlists" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding WordlistsCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Lines -->
                    <Border Grid.Column="3" Style="{StaticResource CollectionItemStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="FormatLineSpacing" 
                                                              Width="16" Height="16" 
                                                              Foreground="#F59E0B"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Lines" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding WordlistLines}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Secondary Collection Items -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Hits -->
                    <Border Grid.Column="0" Style="{StaticResource CollectionItemStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Target" 
                                                              Width="16" Height="16" 
                                                              Foreground="#EF4444"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Hits" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding HitsCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Configs -->
                    <Border Grid.Column="1" Style="{StaticResource CollectionItemStyle}" Margin="3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Cog" 
                                                              Width="16" Height="16" 
                                                              Foreground="#06B6D4"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Configs" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConfigsCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Guests -->
                    <Border Grid.Column="2" Style="{StaticResource CollectionItemStyle}" Margin="3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="AccountGroup" 
                                                              Width="16" Height="16" 
                                                              Foreground="#84CC16"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Guests" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GuestsCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Plugins -->
                    <Border Grid.Column="3" Style="{StaticResource CollectionItemStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Puzzle" 
                                                              Width="16" Height="16" 
                                                              Foreground="#F97316"
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0" />
                                <TextBlock Text="Plugins" 
                                           Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PluginsCount}" 
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
