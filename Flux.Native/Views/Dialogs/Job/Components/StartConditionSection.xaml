<UserControl x:Class="Flux.Native.Views.Dialogs.Job.Components.StartConditionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:uc="clr-namespace:Flux.Native.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="400">
    <Border Style="{StaticResource SectionCard}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ContentControl Style="{StaticResource Icon.Size16}"
                                Content="{StaticResource Icon.Clock}"
                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                VerticalAlignment="Center"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Start Condition" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Choose when the job should begin processing."
                               FontSize="10"
                               Foreground="#CCFFFFFF"/>
                </StackPanel>
            </StackPanel>
            <WrapPanel>
                <RadioButton Content="Start in" x:Name="startInButton"
                             IsChecked="{Binding StartInMode}"
                             Foreground="White" FontSize="11" Margin="0,0,15,0"/>
                <RadioButton Content="Start at" x:Name="startAtButton"
                             IsChecked="{Binding StartAtMode}"
                             Foreground="White" FontSize="11"/>
            </WrapPanel>

            <TabControl x:Name="startConditionTabControl" Background="Transparent" 
                        BorderThickness="0" Margin="0,12,0,0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem>
                    <uc:TimeSpanPicker TimeSpan="{Binding StartIn, Mode=TwoWay}" />
                </TabItem>
                <TabItem>
                    <StackPanel Orientation="Horizontal">
                        <mah:DateTimePicker Width="180" SelectedTimeFormat="Long"
                                            SelectedDateTime="{Binding StartAtTime, Mode=TwoWay}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Border>
</UserControl>
