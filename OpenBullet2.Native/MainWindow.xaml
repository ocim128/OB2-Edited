<mah:MetroWindow x:Class="OpenBullet2.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBullet2.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
        mc:Ignorable="d"
        Title="OpenBullet 2 - 0.3.3.8 [Akunlama MOD]" 
        MinWidth="900" MinHeight="650"
        Background="{StaticResource Modern.BackgroundMain}"
        BorderThickness="0"
        GlowBrush="{StaticResource Modern.ThemeMain}"
        ResizeMode="CanResizeWithGrip"
        WindowTitleBrush="{StaticResource Modern.BackgroundSecondary}"
        NonActiveWindowTitleBrush="{StaticResource Modern.BackgroundMain}"
        WindowTransitionsEnabled="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        TitleCharacterCasing="Normal"
        TitleForeground="{StaticResource Modern.ForegroundMain}"
        TitleAlignment="Left"
        ShowMinButton="True"
        ShowMaxRestoreButton="True"
        ShowCloseButton="True"
        Icon="/Images/logohq_square_padded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        SizeChanged="OnWindowSizeChanged"
        Loaded="OnWindowLoaded">



    <!-- Enhanced Title Bar with Fluent Design -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" 
                          FontFamily="Segoe UI" 
                          FontSize="13" 
                          FontWeight="Medium" 
                          Foreground="{StaticResource Modern.ForegroundMain}" 
                          VerticalAlignment="Center"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!-- Custom Window Button Styles -->
    <!-- Removed duplicate button styles - using ModernTheme.xaml styles for better performance -->

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:CustomCommands.NewConfig}" Gesture="CTRL+N" />
        <KeyBinding Command="{x:Static local:CustomCommands.OpenConfig}" Gesture="CTRL+O" />
        <KeyBinding Command="{x:Static local:CustomCommands.SaveConfig}" Gesture="CTRL+S" />
        <KeyBinding Command="{x:Static local:CustomCommands.Refresh}" Gesture="CTRL+R" />
        <KeyBinding Command="{x:Static local:CustomCommands.Quit}" Gesture="CTRL+Q" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHome}" Gesture="CTRL+D1" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToJobs}" Gesture="CTRL+D2" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToMonitor}" Gesture="CTRL+D3" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToProxies}" Gesture="CTRL+D4" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToWordlists}" Gesture="CTRL+D5" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToConfigs}" Gesture="CTRL+D6" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHits}" Gesture="CTRL+D7" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToPlugins}" Gesture="CTRL+D8" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToOBSettings}" Gesture="CTRL+D9" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToRLSettings}" Gesture="CTRL+D0" />
    </Window.InputBindings>

    <!-- Responsive Layout Grid -->
    <Grid x:Name="Root">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopNavRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Enhanced Navigation Header with Fluent Design -->
        <Border x:Name="NavigationHeader"
                Grid.Row="0" 
                Background="{StaticResource Modern.BackgroundSecondary}" 
                CornerRadius="0,0,12,12" 
                BorderBrush="{StaticResource Modern.BorderMain}" 
                BorderThickness="0,0,0,1"
                Effect="{StaticResource Modern.Shadow.Small}">
            <StackPanel x:Name="topMenu" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="16,8">
                    <StackPanel.Resources>
                        <!-- Enhanced Navigation Menu Style with Fluent Design -->
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundSecondary}" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="Padding" Value="16,12" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="UseLayoutRounding" Value="True" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Style.Triggers>
                                <!-- Smooth hover animation -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
                                    <Setter Property="Background" Value="{StaticResource Modern.BackgroundHover}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                To="1.05" Duration="0:0:0.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                To="1.05" Duration="0:0:0.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                To="1" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                To="1" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Selected state with modern accent color -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Selected">
                                    <Setter Property="Foreground" Value="{StaticResource Modern.TextOnAccent}" />
                                    <Setter Property="Background" Value="{StaticResource Modern.ThemeMain}" />
                                </DataTrigger>

                                <!-- When selected AND hovered, maintain enhanced appearance -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="Tag" Value="Selected" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource Modern.TextOnAccent}" />
                                    <Setter Property="Background" Value="{StaticResource Modern.ThemeSecondary}" />
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                
                    <!-- Navigation Menu Items with Enhanced Tooltips -->
                    <TextBlock x:Name="menuOptionHome" Text="HOME" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Home Dashboard" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="View system overview, performance metrics, and quick actions" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+1" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionJobs" Text="JOBS" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Job Management" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Create, configure, and manage checking jobs" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+2" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionMonitor" Text="MONITOR" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Live Monitoring" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Monitor running jobs in real-time with detailed statistics" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+3" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionProxies" Text="PROXIES" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Proxy Management" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Import, test, and manage proxy lists for your jobs" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+4" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionWordlists" Text="WORDLISTS" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Wordlist Library" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Manage username, password, and custom wordlists" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+5" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionConfigs" Text="CONFIGS" MouseDown="HandleNavigation" MouseEnter="ConfigsMenuOptionMouseEnter" MouseLeave="ConfigsMenuOptionMouseLeave">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Configuration Editor" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Browse, edit, and create automation configurations" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Hover to see editor options • Shortcut: Ctrl+6" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionHits" Text="HITS" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Successful Results" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="View and export successful hits from your jobs" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+7" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionPlugins" Text="PLUGINS" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Plugin Manager" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Install and manage plugins to extend functionality" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+8" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionSettings" Text="SETTINGS" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Application Settings" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Configure OpenBullet preferences and behaviors" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+9" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionRLSettings" Text="RL SETTINGS" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="RuriLib Settings" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Advanced engine configuration and performance tuning" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    <TextBlock Text="Shortcut: Ctrl+0" FontSize="11" FontStyle="Italic" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionAbout" Text="ABOUT" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="About OpenBullet" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="View version information, credits, and license details" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock x:Name="menuOptionUpdate" Text="CHECK UPDATES" MouseDown="HandleNavigation">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Update Manager" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Check for and install application updates" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
            </StackPanel>
        </Border>

        <!-- Modern Config Submenu -->
        <Border x:Name="configSubmenu"
                Background="#FF1E1E1E"
                BorderBrush="#FF2E2E2E"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="1000"
                Height="auto"
                Width="160"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                MouseEnter="ConfigSubmenuMouseEnter"
                MouseLeave="ConfigSubmenuMouseLeave"
                Padding="12">
            <StackPanel>
                <StackPanel.Resources>
                    <!-- Submenu Item Style -->
                    <Style TargetType="TextBlock" x:Key="SubmenuItemStyle">
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="#FFCCCCCC" />
                        <Setter Property="FontFamily" Value="Segoe UI" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A82F7" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                
                <!-- Config Editor Menu Items -->
                <TextBlock x:Name="menuOptionMetadata" Text="📝 Metadata" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config metadata"/>
                <TextBlock x:Name="menuOptionReadme" Text="📄 Readme" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config readme"/>
                <TextBlock x:Name="menuOptionStacker" Text="🔧 Stacker" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config stacker"/>
                <TextBlock x:Name="menuOptionLoliCode" Text="💻 LoliCode" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config LoliCode"/>
                <TextBlock x:Name="menuOptionConfigSettings" Text="⚙️ Settings" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config settings"/>
                <TextBlock x:Name="menuOptionCSharpCode" Text="🔷 C# Code" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config C# code"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area with Enhanced Transitions -->
        <Border x:Name="MainContentBorder"
                Grid.Row="1" 
                Background="Transparent" 
                CornerRadius="8" 
                BorderBrush="#FF333333"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <!-- Main content frame with smooth transitions -->
                <Frame x:Name="mainFrame" 
                       NavigationUIVisibility="Hidden" 
                       Background="Transparent"
                       BorderThickness="0"
                       RenderTransformOrigin="0.5,0.5">
                    <Frame.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="MainFrameTranslate" X="0" Y="0" />
                            <ScaleTransform x:Name="MainFrameScale" ScaleX="1" ScaleY="1" />
                        </TransformGroup>
                    </Frame.RenderTransform>
                </Frame>
                
                <!-- Enhanced loading overlay with smooth animations -->
                <Border x:Name="LoadingOverlay" 
                        Background="#80000000"
                        Opacity="0"
                        IsHitTestVisible="False"
                        CornerRadius="8">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Border Background="{StaticResource Modern.BackgroundCard}"
                                CornerRadius="12"
                                Padding="32,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Effect="{StaticResource DropShadowEffect}">
                            <StackPanel Orientation="Horizontal">
                                <mah:ProgressRing IsActive="True" 
                                                 Width="24" Height="24"
                                                 Foreground="{StaticResource Modern.ThemeMain}"
                                                 Margin="0,0,12,0" />
                                <TextBlock Text="Loading..." 
                                          Style="{StaticResource ModernBodyText}"
                                          FontWeight="Medium"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <mah:ProgressRing 
            x:Name="loadingIndicator"
            Grid.Row="1"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
    </Grid>

</mah:MetroWindow>
