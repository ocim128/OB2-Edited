<Page x:Class="Flux.Native.Views.Dialogs.Job.MultiRunJobOptionsDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:uc="clr-namespace:Flux.Native.Controls"
      xmlns:ho="clr-namespace:Flux.Core.Models.Hits;assembly=Flux.Core"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="980"
      Title="MultiRunJobOptionsDialog"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.BitmapScalingMode="HighQuality"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <LinearGradientBrush x:Key="DialogBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121520" Offset="0"/>
            <GradientStop Color="#1B1F2C" Offset="0.6"/>
            <GradientStop Color="#11141E" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#AA000000"
                          BlurRadius="14"
                          ShadowDepth="0"
                          Opacity="0.45"/>

        <!-- Shared section card styling -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A2F44" Offset="0"/>
                        <GradientStop Color="#232839" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1E90FF"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SecondaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        
        <!-- Modern ScrollBar Page Button Style -->
        <Style x:Key="ModernScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar Thumb Style -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" 
                                Background="#CCCCCC" 
                                CornerRadius="6" 
                                Opacity="0.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#E6E6E6"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#F0F0F0"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern ScrollBar Style -->
        <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="18"/>
                                <RowDefinition Height="0.00001*"/>
                                <RowDefinition MaxHeight="18"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Background="Transparent" CornerRadius="6"/>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ModernScrollBarPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ModernScrollBarPageButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter TargetName="Bg" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced ScrollViewer Style -->
        <Style x:Key="ModernScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CanContentScroll" Value="True"/>
            <Setter Property="PanningMode" Value="VerticalFirst"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="Corner" Grid.Column="1" Fill="Transparent" Grid.Row="1"/>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" 
                                                    CanHorizontallyScroll="False" 
                                                    CanVerticallyScroll="False" 
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                    Content="{TemplateBinding Content}" 
                                                    Grid.Column="0" 
                                                    Margin="{TemplateBinding Padding}" 
                                                    Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Arrow" 
                                       Grid.Column="1" 
                                       Maximum="{TemplateBinding ScrollableHeight}" 
                                       Minimum="0" 
                                       Grid.Row="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Style="{StaticResource ModernScrollBar}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" 
                                       AutomationProperties.AutomationId="HorizontalScrollBar" 
                                       Cursor="Arrow" 
                                       Grid.Column="0" 
                                       Maximum="{TemplateBinding ScrollableWidth}" 
                                       Minimum="0" 
                                       Orientation="Horizontal" 
                                       Grid.Row="1" 
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" 
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Style="{StaticResource ModernScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource DialogBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,16" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{StaticResource Icon.Cog}" Width="18" Height="18" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Job Configuration" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" />
                    <TextBlock Text="Review the essentials on the left, data sources and outputs on the right."
                               FontSize="10"
                               Foreground="#CCFFFFFF"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10"
                      Style="{StaticResource ModernScrollViewer}">
            <Grid HorizontalAlignment="Center" MaxWidth="1080">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Start Condition Section -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl Style="{StaticResource Icon.Size16}"
                                                Content="{StaticResource Icon.Clock}"
                                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                                VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Start Condition" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="Choose when the job should begin processing."
                                               FontSize="10"
                                               Foreground="#CCFFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel>
                                <RadioButton Content="Start in" x:Name="startInButton"
                IsChecked="{Binding StartInMode}"
                                           Foreground="White" FontSize="11" Margin="0,0,15,0"/>
                                <RadioButton Content="Start at" x:Name="startAtButton"
                IsChecked="{Binding StartAtMode}"
                                           Foreground="White" FontSize="11"/>
                            </WrapPanel>

                            <TabControl x:Name="startConditionTabControl" Background="Transparent" 
                                        BorderThickness="0" Margin="0,12,0,0">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="{x:Type TabItem}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem>
                                <uc:TimeSpanPicker TimeSpan="{Binding StartIn, Mode=TwoWay}" />
                            </TabItem>
                            <TabItem>
                                <StackPanel Orientation="Horizontal">
                                        <mah:DateTimePicker Width="180" SelectedTimeFormat="Long"
                            SelectedDateTime="{Binding StartAtTime, Mode=TwoWay}" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                    </Border>

                    <!-- Config Selection Section -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,8,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl Style="{StaticResource Icon.Size16}"
                                                Content="{StaticResource Icon.Tune}"
                                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                                VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Configuration" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="Pick the config to run and tweak how the job behaves."
                                               FontSize="10"
                                               Foreground="#CCFFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Config Display -->
                            <Border Background="#1C2030" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                    BorderBrush="#22FFFFFF" BorderThickness="1"
                                    Visibility="{Binding IsConfigSelected, Converter={StaticResource ResourceKey=BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding ConfigIcon}" Width="28" Height="28" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ConfigNameAndAuthor}" 
                                              FontSize="11" Foreground="White" VerticalAlignment="Center"
                                              TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                            
                            <Button Click="SelectConfig" HorizontalAlignment="Left"
                                    Style="{StaticResource StyledPrimaryButton}" Padding="10,5" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                    <ContentControl Content="{StaticResource Icon.FolderOpen}" Width="12" Height="12"/>
                                    <TextBlock Text="Select Config" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11"/>
                            </StackPanel>
                        </Button>
                            <!-- Execution Settings -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Bots" Style="{StaticResource SecondaryLabelStyle}"/>
                                    <mah:NumericUpDown Minimum="1" Maximum="{Binding BotLimit}" Interval="1"
                                                       Value="{Binding Bots, Mode=TwoWay}" Width="90" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                    <TextBlock Text="Skip" Style="{StaticResource SecondaryLabelStyle}"/>
                                    <mah:NumericUpDown Minimum="0" Maximum="2147483647" Interval="1"
                                                       Value="{Binding Skip, Mode=TwoWay}" Width="120" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Proxy Mode" Style="{StaticResource SecondaryLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ProxyModes}" SelectedValue="{Binding ProxyMode}" 
                                              MinWidth="160" HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                    <TextBlock Text="No Valid Proxy Behaviour" Style="{StaticResource SecondaryLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding NoValidProxyBehaviours}" 
                                              SelectedValue="{Binding NoValidProxyBehaviour}"
                                              MinWidth="160" HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Reload Interval (sec, 0 = disabled)" Style="{StaticResource SecondaryLabelStyle}"/>
                                        <mah:NumericUpDown Minimum="0" Maximum="2147483647" Interval="1"
                                                          Value="{Binding PeriodicReloadIntervalSeconds}" Width="120" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Proxy Ban Time (sec)" Style="{StaticResource SecondaryLabelStyle}"/>
                                        <mah:NumericUpDown Minimum="0" Maximum="2147483647" Interval="1"
                                                          Value="{Binding ProxyBanTimeSeconds}" Width="120" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Proxy Behavior Settings -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Proxy Options" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,4"/>
                                <WrapPanel>
                                    <CheckBox Content="Shuffle proxies" IsChecked="{Binding ShuffleProxies}" 
                                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                                    <CheckBox Content="Never ban proxies" IsChecked="{Binding NeverBanProxies}" 
                                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                                    <CheckBox Content="Concurrent mode (rotating services)" 
                                              IsChecked="{Binding ConcurrentProxyMode}" 
                                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                                    <CheckBox Content="Mark lines as ToCheck on abort" 
                                              IsChecked="{Binding MarkAsToCheckOnAbort}" 
                                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Automation" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,4"/>
                                <CheckBox Content="CPM trigger (Ctrl+Alt+Shift+Y modem refresh)"
                                          IsChecked="{Binding CpmTriggerEnabled}"
                                          Foreground="White" FontSize="10" Margin="0,0,12,2"/>
                                <TextBlock Text="Starts 1 minute after the job runs. If CPM drops below 5000, triggers the modem refresh. Cooldown is 1 minute, retry every 5 seconds."
                                           FontSize="9" Foreground="#99FFFFFF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Data Pool Section -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SectionCard}" Margin="8,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl Style="{StaticResource Icon.Size16}"
                                                Content="{StaticResource Icon.Database}"
                                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                                VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Data Pool" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="Select what data to test and configure the pool source."
                                               FontSize="10"
                                               Foreground="#CCFFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            
                                        <!-- Data Pool Type Selection -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton Content="Wordlist" x:Name="wordlistDataPoolButton"
                IsChecked="{Binding WordlistDataPoolMode}"
                           Foreground="White" FontSize="10" Margin="0,0,8,0"
                           Style="{DynamicResource MahApps.Styles.RadioButton}"/>
                <RadioButton Content="File" x:Name="fileDataPoolButton"
                IsChecked="{Binding FileDataPoolMode}"
                           Foreground="White" FontSize="10" Margin="0,0,8,0"
                           Style="{DynamicResource MahApps.Styles.RadioButton}"/>
                <RadioButton Content="Range" x:Name="rangeDataPoolButton"
                IsChecked="{Binding RangeDataPoolMode}"
                           Foreground="White" FontSize="10" Margin="0,0,8,0"
                           Style="{DynamicResource MahApps.Styles.RadioButton}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Combinations" x:Name="combinationsDataPoolButton"
                IsChecked="{Binding CombinationsDataPoolMode}"
                           Foreground="White" FontSize="10" Margin="0,0,8,0"
                           Style="{DynamicResource MahApps.Styles.RadioButton}"/>
                <RadioButton Content="Infinite" x:Name="infiniteDataPoolButton"
                IsChecked="{Binding InfiniteDataPoolMode}"
                           Foreground="White" FontSize="10"
                           Style="{DynamicResource MahApps.Styles.RadioButton}"/>
                        </StackPanel>

                            <!-- Data Pool Options -->
                            <ContentControl Content="{Binding DataPoolOptions}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type local:WordlistDataPoolOptionsViewModel}">
                                    <StackPanel>
                                        <Border Background="#FF333333" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                               Visibility="{Binding HasWordlist, Converter={StaticResource ResourceKey=BoolToVis}}">
                                            <TextBlock Text="{Binding Info}" FontSize="10" Foreground="White" TextWrapping="Wrap"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="SelectWordlist"
                                                   Margin="0,0,6,0"
                                                   Padding="8,4"
                                                   FontSize="10"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource StyledPrimaryButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon.FolderOpen}" Width="10" Height="10"/>
                                                    <TextBlock Text="Select Wordlist" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="AddWordlist"
                                                   Padding="8,4"
                                                   FontSize="10"
                                        HorizontalAlignment="Left"
                                                   Style="{StaticResource StyledSuccessButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                                    <TextBlock Text="Add Wordlist" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:FileDataPoolOptionsViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                VerticalAlignment="Center"
                                Grid.Column="0">File name</Label>
                                        <TextBox
                                Grid.Column="1"
                                Text="{Binding FileName, Mode=TwoWay}"/>
                                        <Button Tag="{Binding}" Grid.Column="2" 
                                        Click="SelectFileForDataPool" 
                                        Margin="5 0 5 0" >
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Content="{StaticResource Icon.FolderFill}" />
                                            </StackPanel>
                                        </Button>
                                        <ComboBox
                                Grid.Column="3"
                                Margin="5 0 0 0"
                                ItemsSource="{Binding DataContext.WordlistTypes, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                SelectedValue="{Binding WordlistType}"
                                HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:RangeDataPoolOptionsViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                VerticalAlignment="Center"
                                Grid.Column="0">Start</Label>
                                        <mah:NumericUpDown
                                    Minimum="-2147483648"
                                    Grid.Column="1"
                                    Maximum="2147483647"
                                    Interval="1"
                                    Value="{Binding Start}"/>
                                        <Label
                                    VerticalAlignment="Center"
                                    Grid.Column="2">Amount</Label>
                                        <mah:NumericUpDown 
                                    Minimum="0"
                                    Grid.Column="3"
                                    Maximum="2147483647"
                                    Interval="1"
                                    Value="{Binding Amount}"/>
                                        <Label
                                VerticalAlignment="Center"
                                Grid.Column="4">Step</Label>
                                        <mah:NumericUpDown 
                                    Grid.Column="5"
                                    Minimum="0"
                                    Maximum="2147483647"
                                    Interval="1"
                                    Value="{Binding Step}"/>
                                        <CheckBox
                                    Grid.Column="6"
                                    Margin="5 0 0 0"
                                    Content="Pad"
                                    IsChecked="{Binding Pad}" />
                                        <ComboBox
                                    Grid.Column="7"
                                    Margin="5 0 0 0"
                                    ItemsSource="{Binding DataContext.WordlistTypes, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                    SelectedValue="{Binding WordlistType}"
                                    HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:CombinationsDataPoolOptionsViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                VerticalAlignment="Center"
                                Grid.Column="0">Charset</Label>
                                        <TextBox
                                    Grid.Column="1"
                                    ToolTip="{Binding GeneratedAmountText}"
                                    Text="{Binding CharSet}" />
                                        <Label
                                    VerticalAlignment="Center"
                                    Grid.Column="2">Length</Label>
                                        <mah:NumericUpDown 
                                    Minimum="0"
                                    Grid.Column="3"
                                    Maximum="2147483647"
                                    ToolTip="{Binding GeneratedAmountText}"
                                    Interval="1"
                                    Value="{Binding Length}"/>
                                        <ComboBox
                                    Grid.Column="4"
                                    Margin="5 0 0 0"
                                    ItemsSource="{Binding DataContext.WordlistTypes, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                    SelectedValue="{Binding WordlistType}"
                                    HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:InfiniteDataPoolOptionsViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Label
                                VerticalAlignment="Center"
                                Grid.Column="0">Wordlist Type</Label>
                                        <ComboBox
                                Margin="5 0 0 0"
                                ItemsSource="{Binding DataContext.WordlistTypes, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                SelectedValue="{Binding WordlistType}"
                                HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                        </StackPanel>
                    </Border>

                    <!-- Proxy Sources Section -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl Style="{StaticResource Icon.Size16}"
                                                Content="{StaticResource Icon.Network}"
                                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                                VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Proxy Sources" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="Add one or more proxy feeds. Sources are processed in order."
                                               FontSize="10"
                                               Foreground="#CCFFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Add Proxy Source Buttons -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Click="AddGroupProxySource" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="Group" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="10"/>
                                </StackPanel>
                            </Button>
                                <Button Click="AddFileProxySource" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="File" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="10"/>
                                </StackPanel>
                            </Button>
                                <Button Click="AddRemoteProxySource" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="Remote" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="10"/>
                                </StackPanel>
                            </Button>
                            </WrapPanel>
                            <!-- Proxy Sources List -->
                            <Border Background="#1B1E2B"
                                    CornerRadius="10"
                                    Padding="0"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1">
                                <ScrollViewer Height="140" 
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="10"
                                              Background="Transparent"
                                              CanContentScroll="True"
                                              Focusable="False"
                                              PreviewMouseWheel="ChildScrollViewer_PreviewMouseWheel"
                                              Style="{StaticResource ModernScrollViewer}">
                            <ItemsControl ItemsSource="{Binding ProxySourcesCollection}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type local:GroupProxySourceOptionsViewModel}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                          Text="Group:" 
                                    VerticalAlignment="Center" 
                                                          FontSize="10" 
                                                          Foreground="#FFB0B0B0"/>
                                                <ComboBox Grid.Column="1"
                                    ItemsSource="{Binding DataContext.ProxyGroupNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         SelectedValue="{Binding GroupName}" 
                                                         FontSize="10"
                                                         Margin="4,0,4,0" Style="{StaticResource CleanComboBox}"/>
                                                <Button Tag="{Binding}" Grid.Column="2" 
                                        Click="RemoveProxySource" 
                                                        Style="{StaticResource StyledDangerButton}"
                                                        Width="24" Height="20"
                                                        Padding="2">
                                                    <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:FileProxySourceOptionsViewModel}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                          Text="File:" 
                                    VerticalAlignment="Center" 
                                                          FontSize="10" 
                                                          Foreground="#FFB0B0B0"/>
                                                <TextBox Grid.Column="1"
                                                        Text="{Binding FileName, Mode=TwoWay}" 
                                                        FontSize="10"
                                                        Margin="2,0"/>
                                                <Button Tag="{Binding}" Grid.Column="2" 
                                        Click="SelectFileForProxySource" 
                                                        Width="24" Height="20"
                                                        Padding="2"
                                                        Style="{StaticResource StyledPrimaryButton}">
                                                    <ContentControl Content="{StaticResource Icon.FolderOpen}" Width="10" Height="10"/>
                                                </Button>
                                                <ComboBox Grid.Column="3"
                                    ItemsSource="{Binding DataContext.ProxyTypes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         SelectedValue="{Binding DefaultType}" 
                                                         FontSize="10"
                                                         Margin="2,0" Style="{StaticResource CleanComboBox}"/>
                                                <Button Tag="{Binding}" Grid.Column="4" 
                                        Click="RemoveProxySource" 
                                                        Style="{StaticResource StyledDangerButton}"
                                                        Width="24" Height="20"
                                                        Padding="2">
                                                    <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:RemoteProxySourceOptionsViewModel}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                          Text="URL:" 
                                    VerticalAlignment="Center" 
                                                          FontSize="10" 
                                                          Foreground="#FFB0B0B0"/>
                                                <TextBox Grid.Column="1"
                                                        Text="{Binding Url}" 
                                                        FontSize="10"
                                                        Margin="2,0"/>
                                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DataContext.ProxyTypes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         SelectedValue="{Binding DefaultType}" 
                                                         FontSize="10"
                                                         Margin="2,0" Style="{StaticResource CleanComboBox}"/>
                                                <Button Tag="{Binding}" Grid.Column="3" 
                                        Click="RemoveProxySource" 
                                                        Style="{StaticResource StyledDangerButton}"
                                                        Width="24" Height="20"
                                                        Padding="2">
                                                    <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                                </ScrollViewer>
                            </Border>
                    </StackPanel>
                    </Border>

                    <!-- Hit Outputs Section -->
                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl Style="{StaticResource Icon.Size16}"
                                                Content="{StaticResource Icon.DatabaseExport}"
                                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                                VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Hit Outputs" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="Route results wherever you need them. Combine multiple outputs if required."
                                               FontSize="10"
                                               Foreground="#CCFFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Hit Output Buttons -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Click="AddDatabaseHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="6,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="DB" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                                </StackPanel>
                            </Button>
                                <Button Click="AddFileSystemHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="6,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="File" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                                </StackPanel>
                            </Button>
                                <Button Click="AddDiscordWebhookHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="6,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="Discord" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                                </StackPanel>
                            </Button>
                                <Button Click="AddTelegramBotHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="6,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="Telegram" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                                </StackPanel>
                            </Button>
                                <Button Click="AddCustomWebhookHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                                        Padding="6,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                                        <TextBlock Text="Webhook" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                                </StackPanel>
                            </Button>
                            </WrapPanel>
                            
                            <!-- Hit Outputs List -->
                            <Border Background="#1B1E2B"
                                    CornerRadius="10"
                                    Padding="0"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1">
                                <ScrollViewer Height="110" 
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="10"
                                              Background="Transparent"
                                              CanContentScroll="True"
                                              Focusable="False"
                                              PreviewMouseWheel="ChildScrollViewer_PreviewMouseWheel"
                                              Style="{StaticResource ModernScrollViewer}">
                            <ItemsControl ItemsSource="{Binding HitOutputsCollection}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type ho:DatabaseHitOutputOptions}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                          Text="Database:" 
                                            VerticalAlignment="Center" 
                                                          FontSize="10" 
                                                          Foreground="#FFB0B0B0"/>
                                                <TextBlock Grid.Column="1" 
                                                          Text="No settings required" 
                                            VerticalAlignment="Center" 
                                                          FontSize="10" 
                                                          Foreground="#FFCCCCCC"/>
                                                <Button Tag="{Binding}" Grid.Column="2" 
                                            Click="RemoveHitOutput" 
                                                        Style="{StaticResource StyledDangerButton}"
                                                        Width="24" Height="20"
                                                        Padding="2">
                                                    <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type ho:FileSystemHitOutputOptions}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                          Text="File System:" 
                                            VerticalAlignment="Center" 
                                                          FontSize="10" 
                                                          Foreground="#FFB0B0B0"/>
                                                <TextBox Grid.Column="1"
                                                        Text="{Binding BaseDir}" 
                                                        FontSize="10"
                                                        Margin="2,0"
                                                        ToolTip="{Binding BaseDir}"/>
                                                <Button Tag="{Binding}" Grid.Column="2" 
                                            Click="RemoveHitOutput" 
                                                        Style="{StaticResource StyledDangerButton}"
                                                        Width="24" Height="20"
                                                        Padding="2">
                                                    <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type ho:DiscordWebhookHitOutputOptions}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                              Text="Discord:" 
                                            VerticalAlignment="Center"
                                                              FontSize="10" 
                                                              Foreground="#FFB0B0B0"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding Webhook}" 
                                                            FontSize="10"
                                                            Margin="2,0"
                                                            ToolTip="Webhook URL"/>
                                                    <Button Tag="{Binding}" Grid.Column="2" 
                                            Click="RemoveHitOutput" 
                                                            Style="{StaticResource StyledDangerButton}"
                                                            Width="24" Height="20"
                                                            Padding="2">
                                                        <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                            Text="{Binding Username}" 
                                                            FontSize="10"
                                                            Margin="2,0"
                                                            ToolTip="Username"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding AvatarUrl}" 
                                                            FontSize="10"
                                                            Margin="2,0"
                                                            ToolTip="Avatar URL"/>
                                                    <CheckBox Grid.Column="2"
                                                             Content="Hits only"
                                                             IsChecked="{Binding OnlyHits}" 
                                                             FontSize="9"
                                                             Foreground="White"
                                                             Margin="2,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type ho:TelegramBotHitOutputOptions}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                              Text="Telegram:" 
                                                              VerticalAlignment="Center" 
                                                              FontSize="10" 
                                                              Foreground="#FFB0B0B0"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding ApiServer}" 
                                                            FontSize="10"
                                                            Margin="2,0"
                                                            ToolTip="API Server"/>
                                                    <Button Tag="{Binding}" Grid.Column="2" 
                                                            Click="RemoveHitOutput" 
                                                            Style="{StaticResource StyledDangerButton}"
                                                            Width="24" Height="20"
                                                            Padding="2">
                                                        <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                    </Button>
                                                </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                            Text="{Binding Token}" 
                                                            FontSize="10"
                                                            Margin="2,0"
                                                            ToolTip="Bot Token"/>
                                                    <mah:NumericUpDown Grid.Column="1"
                                            Minimum="-2147483648"
                                            Maximum="2147483647"
                                            Interval="1"
                                                                      Value="{Binding ChatId}"
                                                                      FontSize="10"
                                                                      Margin="2,0"
                                                                      ToolTip="Chat ID"/>
                                                    <CheckBox Grid.Column="2"
                                                             Content="Hits only"
                                                             IsChecked="{Binding OnlyHits}" 
                                                             FontSize="9"
                                                             Foreground="White"
                                                             Margin="2,0"/>
                                                </Grid>
                                                    </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type ho:CustomWebhookHitOutputOptions}">
                                        <Border Padding="0,4,0,4" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                          Text="Webhook:" 
                                            VerticalAlignment="Center"
                                                          FontSize="10" 
                                                          Foreground="#FFB0B0B0"/>
                                                <TextBox Grid.Column="1"
                                                        Text="{Binding Url}" 
                                                        FontSize="10"
                                                        Margin="2,0"
                                                        ToolTip="Webhook URL"/>
                                                <TextBox Grid.Column="2"
                                                        Text="{Binding User}" 
                                                        FontSize="10"
                                                        Margin="2,0"
                                                        ToolTip="User"/>
                                                <CheckBox Grid.Column="3"
                                                         Content="Hits only"
                                                         IsChecked="{Binding OnlyHits}" 
                                                         FontSize="9"
                                                         Foreground="White"
                                                         Margin="2,0"/>
                                                <Button Tag="{Binding}" Grid.Column="4" 
                                            Click="RemoveHitOutput" 
                                                        Style="{StaticResource StyledDangerButton}"
                                                        Width="24" Height="20"
                                                        Padding="2">
                                                    <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                                </ScrollViewer>
                            </Border>
                    </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

        <!-- Modern Footer -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                    
                    <!-- Status/Info Area -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Review your selections before saving." 
                                   FontSize="10" Foreground="#FFB0B0B0"/>
                        <TextBlock Text="Changes are applied immediately once you press Save Configuration."
                                   FontSize="9" Foreground="#99FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <Button Grid.Column="1" Click="Accept"
                Style="{StaticResource StyledSuccessButton}"
                            Padding="14,6" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{StaticResource Icon.Check}" Width="12" Height="12"/>
                            <TextBlock Text="Save Configuration" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        </Grid>

</Page>
