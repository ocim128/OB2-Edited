<UserControl x:Class="Flux.Native.Controls.ConditionalConstantStringViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flux.Native.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="400">
    <StackPanel Margin="0 4 0 0" Orientation="Vertical" >
        <TextBlock Text="Default Value"
                   FontWeight="SemiBold"
                   Margin="0 0 0 4"/>
        <controls:StringSettingViewer x:Name="defaultValueViewer"/>

        <DockPanel Margin="0 16 0 8">
            <TextBlock Text="Conditional Overrides"
                       FontWeight="SemiBold"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"/>
            <Button Content="Add Condition"
                    x:Name="addConditionButton"
                    Click="AddCondition"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ModernButton}"
                    Margin="8 0 0 0"/>
        </DockPanel>

        <StackPanel x:Name="casesPanel" Orientation="Vertical" />
    </StackPanel>
</UserControl>
