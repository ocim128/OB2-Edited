<Project>
  <!-- Global Build Optimization Properties -->
  <PropertyGroup>
    <!-- Enable parallel builds and use all CPU cores -->
    <BuildInParallel>true</BuildInParallel>
    <MaxCpuCount>0</MaxCpuCount>
    
    <!-- Faster package restore -->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    
    <!-- Compiler optimizations -->
    <UseSharedCompilation>true</UseSharedCompilation>
    <!-- <Features>strict</Features> DISABLED - Can cause issues -->
    
    <!-- Suppress common warnings to speed up build -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8604;CS8625;CS8622;CS8601;CS8603;CS0618;SYSLIB0039;CA1416;CS1998</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Memory optimizations -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    
    <!-- Skip unnecessary tasks -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    
    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Fast incremental builds -->
  <PropertyGroup Condition="'$(Configuration)' == 'testing' OR '$(Configuration)' == 'Debug'">
    <OptimizeImplicitlyTriggeredBuild>true</OptimizeImplicitlyTriggeredBuild>
    <DisableFastUpToDateCheck>false</DisableFastUpToDateCheck>
  </PropertyGroup>
  
  <!-- Performance optimization for release builds -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  
  <!-- Build Output Size Optimizations -->
  <PropertyGroup>
    <!-- Reduce assembly metadata -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    
    <!-- Optimize serialization -->
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    
    <!-- Reduce debug information -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    
    <!-- Assembly linking optimizations (disabled for WinForms compatibility) -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">false</PublishTrimmed>
    <!-- <TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode> -->
    <!-- <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings> -->
    
    <!-- Compression settings -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    
    <!-- Remove unused references -->
    <TrimUnusedDependencies>true</TrimUnusedDependencies>
    
    <!-- Optimize IL -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>

    <!-- Only include English satellite resource assemblies to shrink output size -->
    <SatelliteResourceLanguages>en;en-US</SatelliteResourceLanguages>
    
    <!-- Exclude unnecessary runtime identifiers to reduce build output size -->
    <ExcludeAssets Condition="'$(Configuration)' == 'testing' OR '$(Configuration)' == 'Debug'">runtimes/android;runtimes/ios;runtimes/linux;runtimes/osx;runtimes/browser;runtimes/tizen;runtimes/freebsd</ExcludeAssets>
    
    <!-- Prevent copying of cross-platform runtime files -->
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'testing' OR '$(Configuration)' == 'Debug'">win-x64</RuntimeIdentifiers>
    <UseAppHost Condition="'$(Configuration)' == 'testing' OR '$(Configuration)' == 'Debug'">true</UseAppHost>
  </PropertyGroup>
  
  <!-- Exclude specific NuGet package assets that cause bloat -->
  <ItemGroup Condition="'$(Configuration)' == 'testing' OR '$(Configuration)' == 'Debug'">
    <!-- Exclude non-Windows runtime assets from all packages -->
    <PackageReference Update="*">
      <ExcludeAssets>$(ExcludeAssets);runtimes/android;runtimes/ios;runtimes/linux;runtimes/osx;runtimes/browser;runtimes/tizen;runtimes/freebsd</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>