<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Faster package downloads -->
    <add key="maxHttpRequestsPerSource" value="16" />
    <add key="http_timeout" value="600" />
    
    <!-- Local package cache optimization -->
    <add key="globalPackagesFolder" value="packages" />
    <add key="repositoryPath" value="packages" />
    
    <!-- Disable signature verification for faster installs -->
    <add key="signatureValidationMode" value="accept" />
    
    <!-- Parallel downloads -->
    <add key="degreeOfParallelism" value="8" />
  </config>
  
  <packageRestore>
    <!-- Enable automatic package restore -->
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  
  <packageSources>
    <!-- Use closest NuGet mirror for faster downloads -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
