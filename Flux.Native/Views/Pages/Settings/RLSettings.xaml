<Page x:Class="Flux.Native.Views.Pages.Settings.RLSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Flux.Native.Controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d"
      d:DesignHeight="1450"
      d:DesignWidth="800"
      Title="RLSettings">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernHeading3}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource Modern.ThemeMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,20">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Modern.ThemeMain}" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="{StaticResource Modern.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="General Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        <controls:MetadataFieldsPresenter ItemsSource="{Binding GeneralFields}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Modern.Success}" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="16" Height="16" Foreground="{StaticResource Modern.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Proxy Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        <controls:MetadataFieldsPresenter ItemsSource="{Binding ProxyFields}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Modern.Warning}" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Robot" Width="16" Height="16" Foreground="{StaticResource Modern.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Captcha Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>

                        <controls:MetadataFieldsPresenter ItemsSource="{Binding CaptchaGeneralFields}" />
                        <controls:MetadataFieldsPresenter ItemsSource="{Binding CaptchaServiceFields}" />

                        <Button x:Name="checkBalanceButton"
                                Click="CheckCaptchaBalance"
                                Margin="0,16,0,0"
                                Width="200"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ModernPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CurrencyUsd" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Check Balance" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Modern.Error}" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="GoogleChrome" Width="16" Height="16" Foreground="{StaticResource Modern.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Puppeteer Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        <controls:MetadataFieldsPresenter ItemsSource="{Binding PuppeteerFields}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Modern.Error}" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Theater" Width="16" Height="16" Foreground="{StaticResource Modern.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Playwright Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        <controls:MetadataFieldsPresenter ItemsSource="{Binding PlaywrightFields}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="installBrowsersButton"
                                    Content="Install Browsers"
                                    Click="InstallPlaywrightBrowsers"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    Width="150"
                                    Margin="0,0,16,0"/>
                            <mah:ProgressRing x:Name="playwrightInstallProgressRing"
                                              IsActive="True"
                                              Visibility="Collapsed"
                                              Width="20"
                                              Height="20"
                                              Margin="0,0,12,0"
                                              Foreground="{StaticResource Modern.ThemeMain}"/>
                            <TextBlock x:Name="playwrightInstallStatus"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Modern.ThemeMain}"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Modern.Error}" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Web" Width="16" Height="16" Foreground="{StaticResource Modern.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Selenium Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        <controls:MetadataFieldsPresenter ItemsSource="{Binding SeleniumFields}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource Modern.BackgroundSecondary}"
                BorderBrush="{StaticResource Modern.BorderSecondary}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="resetButton" Click="Reset" Style="{StaticResource ModernDangerButton}" Margin="0,0,12,0" Width="100">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Reset" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="saveButton" Click="Save" Style="{StaticResource ModernPrimaryButton}" Width="120">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Save Changes" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
