<Page x:Class="Flux.Native.Views.Dialogs.Job.MultiRunJobOptionsDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
      xmlns:components="clr-namespace:Flux.Native.Views.Dialogs.Job.Components"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:uc="clr-namespace:Flux.Native.Controls"
      xmlns:ho="clr-namespace:Flux.Core.Models.Hits;assembly=Flux.Core"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="980"
      Title="MultiRunJobOptionsDialog"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.BitmapScalingMode="HighQuality"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Background="{DynamicResource Modern.Gradient.DialogBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,16" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{StaticResource Icon.Cog}" Width="18" Height="18" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Job Configuration" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" />
                    <TextBlock Text="Review the essentials on the left, data sources and outputs on the right."
                               FontSize="10"
                               Foreground="#CCFFFFFF"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10"
                      Style="{StaticResource ModernScrollViewer}">
            <Grid HorizontalAlignment="Center" MaxWidth="1080">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Start Condition Section -->
                    <components:StartConditionSection Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />

                    <!-- Config Selection Section -->
                    <!-- Config Selection Section -->
                    <components:ConfigSelectionSection Grid.Row="1" Grid.Column="0" />

                    <!-- Data Pool Section -->
                    <!-- Data Pool Section -->
                    <components:DataPoolSection Grid.Row="1" Grid.Column="1" />

                    <!-- Proxy Sources Section -->
                    <!-- Proxy Sources Section -->
                    <components:ProxySourcesSection Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" />

                    <!-- Hit Outputs Section -->
                    <!-- Hit Outputs Section -->
                    <components:HitOutputsSection Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" />
                </Grid>
            </ScrollViewer>

        <!-- Modern Footer -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                    
                    <!-- Status/Info Area -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Review your selections before saving." 
                                   FontSize="10" Foreground="#FFB0B0B0"/>
                        <TextBlock Text="Changes are applied immediately once you press Save Configuration."
                                   FontSize="9" Foreground="#99FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <Button Grid.Column="1" Click="Accept"
                Style="{StaticResource StyledSuccessButton}"
                            Padding="14,6" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{StaticResource Icon.Check}" Width="12" Height="12"/>
                            <TextBlock Text="Save Configuration" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        </Grid>

</Page>
