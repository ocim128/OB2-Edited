<Page x:Class="Flux.Native.Views.Dialogs.Job.CreateJobDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateJobDialog">

    <Border Background="{DynamicResource Modern.BackgroundSecondary}" 
            CornerRadius="12" 
            BorderBrush="{DynamicResource Modern.BorderSecondary}" 
            BorderThickness="1"
            MinWidth="460"
            MaxWidth="520">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="8" BlurRadius="16" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section (Minimalist - No Icon) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Create New Job"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundMain}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Choose the type of job you want to create"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{DynamicResource Modern.ForegroundMuted}"
                           FontWeight="Normal"/>
            </StackPanel>

            <!-- Job Type Options -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                
                <!-- Multi Run Job Option -->
                <Border Background="{DynamicResource BackgroundMain}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderMain}"
                        BorderThickness="1"
                        Margin="0,0,0,12"
                        Cursor="Hand"
                        MouseLeftButtonUp="CreateMultiRunJob">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Modern.BorderFocus}"/>
                                    <Setter Property="Background" Value="{DynamicResource Modern.BackgroundHover}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <Grid Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Simple Color Indicator -->
                        <Ellipse Grid.Column="0" 
                                 Width="10" 
                                 Height="10" 
                                 Fill="{DynamicResource Modern.Success}" 
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                        
                        <!-- Content Section -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Multi Run Job" 
                                       FontFamily="Segoe UI"
                                       FontSize="15" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ForegroundMain}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Run configs against wordlists to find valid credentials" 
                                       FontFamily="Segoe UI"
                                       FontSize="12" 
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Proxy Check Job Option -->
                <Border Background="{DynamicResource BackgroundMain}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderMain}"
                        BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonUp="CreateProxyCheckJob">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Modern.BorderFocus}"/>
                                    <Setter Property="Background" Value="{DynamicResource Modern.BackgroundHover}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <Grid Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Simple Color Indicator -->
                        <Ellipse Grid.Column="0" 
                                 Width="10" 
                                 Height="10" 
                                 Fill="{DynamicResource Modern.ThemeMain}" 
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                        
                        <!-- Content Section -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Proxy Check Job" 
                                       FontFamily="Segoe UI"
                                       FontSize="15" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ForegroundMain}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Test proxy lists to verify they are working and alive" 
                                       FontFamily="Segoe UI"
                                       FontSize="12" 
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                
                <Button Content="Cancel"
                        Width="100"
                        Height="38"
                        Style="{StaticResource StyledButton}"
                        FontWeight="Medium"
                        Click="Cancel"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
