<UserControl x:Class="Flux.Native.Views.Controls.Tools.PerformanceBenchmarkToolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d">
    <Border Style="{StaticResource ModernCardLite}"
            Background="{DynamicResource Modern.BackgroundSecondary}"
            Padding="20"
            Visibility="{Binding CardVisibility}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconMaterial Kind="Speedometer"
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource Modern.ThemeAccent}"/>
                <TextBlock Text="Performance Benchmark"
                           Style="{StaticResource H3TextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Test application performance and monitor system resources in real-time."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Memory Usage:"
                           Style="{StaticResource BodyTextStyle}"
                           Grid.Row="0"
                           Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{Binding MemoryUsageBrush}"
                           HorizontalAlignment="Right"
                           Text="{Binding MemoryUsageText}"/>
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{DynamicResource Modern.ForegroundMain}"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4"
                           Text="{Binding MemoryUsageValue}"/>

                <TextBlock Text="CPU Usage:"
                           Style="{StaticResource BodyTextStyle}"
                           Grid.Row="1"
                           Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{Binding CpuUsageBrush}"
                           HorizontalAlignment="Right"
                           Text="{Binding CpuUsageText}"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{DynamicResource Modern.ForegroundMain}"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4"
                           Text="{Binding CpuUsageValue}"/>

                <TextBlock Text="System Status:"
                           Style="{StaticResource BodyTextStyle}"
                           Grid.Row="2"
                           Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{Binding SystemStatusBrush}"
                           HorizontalAlignment="Right"
                           Text="{Binding SystemStatusText}"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{DynamicResource Modern.ForegroundMain}"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4"
                           Text="{Binding SystemStatusValue}"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource StyledWarningButton}"
                        Content="Clear Stats"
                        Width="100"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearStatsCommand}"
                        AutomationProperties.Name="Clear benchmark statistics"/>
                <Button Style="{StaticResource StyledPrimaryButton}"
                        Content="Run Test"
                        Width="100"
                        Grid.Column="1"
                        Command="{Binding RunBenchmarkCommand}"
                        AutomationProperties.Name="Run performance benchmark"/>
            </Grid>

            <Border Background="{DynamicResource Modern.Success}"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="{Binding StatusVisibility}">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Foreground="{Binding StatusBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    MinHeight="120">
                <TextBox Style="{StaticResource MatchingTextBox}"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         Height="120"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Benchmark output"
                         Text="{Binding OutputLog, Mode=OneWay}"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
