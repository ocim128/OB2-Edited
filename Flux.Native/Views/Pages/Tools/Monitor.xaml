<Page x:Class="Flux.Native.Views.Pages.Tools.Monitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:toolControls="clr-namespace:Flux.Native.Views.Controls.Tools"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Tools"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent" Margin="20">
        <ScrollViewer x:Name="ToolsScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource ModernScrollViewer}"
                      CanContentScroll="False"
                      Loaded="ToolsScrollViewer_Loaded"
                      SizeChanged="ToolsScrollViewer_SizeChanged">
            <DockPanel LastChildFill="True">
                <Border Style="{StaticResource ModernCardLite}"
                        Background="{DynamicResource Modern.BackgroundSecondary}"
                        Margin="0,0,0,20"
                        Padding="20"
                        DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock Text="Tool Command Center"
                                   Style="{StaticResource H3TextStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Search, filter, and jump straight to your favorite automation helpers."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource Modern.ForegroundMuted}"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource MatchingTextBox}"
                                     mah:TextBoxHelper.Watermark="Search tools..."
                                     mah:TextBoxHelper.UseFloatingWatermark="False"
                                     Margin="0,0,16,0"
                                     AutomationProperties.Name="Search tools box"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource CleanComboBox}"
                                      Margin="0,0,16,0"
                                      AutomationProperties.Name="Tool category filter"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource StyledButton}"
                                    Content="Reset"
                                    Width="90"
                                    Command="{Binding ResetFiltersCommand}"
                                    IsEnabled="{Binding AreFiltersActive}"
                                    AutomationProperties.Name="Reset tool filters button"/>
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource StyledButton}"
                                    Content="OTP toolkit"
                                    Margin="0,0,10,10"
                                    Tag="OTP Toolkit"
                                    Click="NavigateToToolCard"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Bookmarklet parser"
                                    Margin="0,0,10,10"
                                    Tag="Bookmarklet Parser"
                                    Click="NavigateToToolCard"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Text cleaner"
                                    Margin="0,0,10,10"
                                    Tag="Text Cleaner"
                                    Click="NavigateToToolCard"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Firefox switcher"
                                    Margin="0,0,10,10"
                                    Tag="Firefox Switcher"
                                    Click="NavigateToToolCard"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Line reducer"
                                    Margin="0,0,10,10"
                                    Tag="Line Reducer"
                                    Click="NavigateToToolCard"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Performance bench"
                                    Margin="0,0,10,10"
                                    Tag="Performance Benchmark"
                                    Click="NavigateToToolCard"/>
                        </WrapPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource Modern.ForegroundMuted}"
                                   Visibility="{Binding FilterStatusVisibility}"
                                   Text="{Binding FilterStatus}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCardLite}"
                        Background="{DynamicResource Modern.BackgroundTertiary}"
                        Margin="0,0,0,20"
                        Padding="16"
                        DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Toolbox"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"
                                                    Foreground="{StaticResource Modern.ThemeMain}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Automation Toolkit"
                                       Style="{StaticResource H3TextStyle}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Quick automation suite for power users"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel x:Name="ToolCardPanel"
                           ItemWidth="360"
                           Margin="0"
                           Orientation="Horizontal">
                    <toolControls:OtpToolControl x:Name="OtpToolCard"
                                                 Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                                                 MinWidth="300"
                                                 MaxWidth="420"
                                                 Margin="0,0,16,16"
                                                 DataContext="{Binding OtpTool}"/>
                    <toolControls:BookmarkletToolControl x:Name="BookmarkletToolCard"
                                                         Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                                                         MinWidth="300"
                                                         MaxWidth="420"
                                                         Margin="0,0,16,16"
                                                         DataContext="{Binding BookmarkletTool}"/>
                    <toolControls:TextCleanerToolControl x:Name="TextCleanerToolCard"
                                                         Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                                                         MinWidth="300"
                                                         MaxWidth="420"
                                                         Margin="0,0,16,16"
                                                         DataContext="{Binding TextCleanerTool}"/>
                    <toolControls:FirefoxToolControl x:Name="FirefoxToolCard"
                                                     Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                                                     MinWidth="300"
                                                     MaxWidth="420"
                                                     Margin="0,0,16,16"
                                                     DataContext="{Binding FirefoxTool}"/>
                    <toolControls:LineReducerToolControl x:Name="LineReducerToolCard"
                                                         Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                                                         MinWidth="300"
                                                         MaxWidth="420"
                                                         Margin="0,0,16,16"
                                                         DataContext="{Binding LineReducerTool}"/>
                    <toolControls:PerformanceBenchmarkToolControl x:Name="BenchmarkToolCard"
                                                                  Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                                                                  MinWidth="300"
                                                                  MaxWidth="420"
                                                                  Margin="0,0,16,16"
                                                                  DataContext="{Binding PerformanceBenchmarkTool}"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource Modern.Error}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0"
                               Visibility="{Binding NoMatchesVisibility}"
                               Text="No tools match your filters. Adjust the search or reset filters to show every tool."/>
                </WrapPanel>
            </DockPanel>
        </ScrollViewer>
    </Grid>
</Page>
