<mah:MetroWindow x:Class="OpenBullet2.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBullet2.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
        mc:Ignorable="d"
        Title="OpenBullet 2 - 0.3.3.8 [Akunlama MOD]" 
        MinWidth="800" MinHeight="600"
        Background="{StaticResource Modern.BackgroundMain}"
        BorderThickness="0"
        GlowBrush="{StaticResource Modern.ThemeMain}"
        ResizeMode="CanResizeWithGrip"
        WindowTitleBrush="{StaticResource Modern.BackgroundSecondary}"
        NonActiveWindowTitleBrush="{StaticResource Modern.BackgroundMain}"
        WindowTransitionsEnabled="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        TitleCharacterCasing="Normal"
        TitleForeground="{StaticResource Modern.ForegroundMain}"
        TitleAlignment="Left"
        ShowMinButton="True"
        ShowMaxRestoreButton="True"
        ShowCloseButton="True"
        Icon="/Images/logohq_square_padded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        SizeChanged="OnWindowSizeChanged"
        Loaded="OnWindowLoaded">



    <!-- Enhanced Title Bar with Fluent Design -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" 
                          FontFamily="Segoe UI" 
                          FontSize="13" 
                          FontWeight="Medium" 
                          Foreground="{StaticResource Modern.ForegroundMain}" 
                          VerticalAlignment="Center"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!-- Custom Window Button Styles -->
    <!-- Removed duplicate button styles - using ModernTheme.xaml styles for better performance -->

    <Window.Resources>
        <!-- Responsive Design Resources -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Converters -->
        <converters:LessThanConverter x:Key="LessThanConverter" />
        
        <!-- Responsive Navigation Styles -->
        <Style x:Key="ResponsiveNavButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <!-- Hide text on smaller windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Padding" Value="8" />
                </DataTrigger>
                <!-- Compact mode for medium windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1200}" Value="True">
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="Margin" Value="1,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Responsive Text Style -->
        <Style x:Key="ResponsiveNavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- Hide text on very small windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- Smaller font on medium windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1200}" Value="True">
                    <Setter Property="FontSize" Value="12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Responsive Icon Style -->
        <Style x:Key="ResponsiveNavIcon" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- Larger icons when text is hidden -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Responsive Container Styles -->
        <Style x:Key="ResponsiveStackPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="10" />
            <Style.Triggers>
                <!-- Smaller margins on smaller windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="Margin" Value="5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1200}" Value="True">
                    <Setter Property="Margin" Value="8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Responsive Grid Style -->
        <Style x:Key="ResponsiveGrid" TargetType="Grid">
            <Setter Property="Margin" Value="15" />
            <Style.Triggers>
                <!-- Smaller margins on smaller windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="Margin" Value="8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1200}" Value="True">
                    <Setter Property="Margin" Value="12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Responsive Content Text Style -->
        <Style x:Key="ResponsiveContentText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="5" />
            <Style.Triggers>
                <!-- Smaller font on smaller windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1200}" Value="True">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Margin" Value="4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Responsive Border Style -->
        <Style x:Key="ResponsiveBorder" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />
            <Style.Triggers>
                <!-- Smaller padding on smaller windows -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="Margin" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1200}" Value="True">
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="Margin" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:CustomCommands.NewConfig}" Gesture="CTRL+N" />
        <KeyBinding Command="{x:Static local:CustomCommands.OpenConfig}" Gesture="CTRL+O" />
        <KeyBinding Command="{x:Static local:CustomCommands.SaveConfig}" Gesture="CTRL+S" />
        <KeyBinding Command="{x:Static local:CustomCommands.Refresh}" Gesture="CTRL+R" />
        <KeyBinding Command="{x:Static local:CustomCommands.Quit}" Gesture="CTRL+Q" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHome}" Gesture="CTRL+D1" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToJobs}" Gesture="CTRL+D2" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToMonitor}" Gesture="CTRL+D3" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToProxies}" Gesture="CTRL+D4" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToWordlists}" Gesture="CTRL+D5" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToConfigs}" Gesture="CTRL+D6" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHits}" Gesture="CTRL+D7" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToPlugins}" Gesture="CTRL+D8" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToOBSettings}" Gesture="CTRL+D9" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToRLSettings}" Gesture="CTRL+D0" />
    </Window.InputBindings>

    <!-- Responsive Layout Grid -->
    <Grid x:Name="Root" Style="{StaticResource ResponsiveGrid}">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopNavRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Navigation Header - Minimal and Fluent -->
        <Border x:Name="NavigationHeader"
                Grid.Row="0" 
                Background="{StaticResource Modern.BackgroundSecondary}" 
                BorderBrush="{StaticResource Modern.BorderMain}" 
                BorderThickness="0,0,0,1">
            <StackPanel x:Name="topMenu" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Style="{StaticResource ResponsiveStackPanel}">
                    <!-- Using styles from ModernTheme.xaml for better performance -->
                    <!-- Reduced margins for better responsiveness on smaller screens -->
                
                    <!-- Navigation Menu Items -->
                    <Button x:Name="menuOptionHome" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Home" ToolTip="Home Dashboard (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Home" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Home" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionJobs" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Jobs" ToolTip="Job Management (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlayBox" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Jobs" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionMonitor" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Monitor" ToolTip="Live Monitoring (Ctrl+3)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Monitor" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Monitor" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionProxies" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Proxies" ToolTip="Proxy Management (Ctrl+4)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ServerNetwork" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Proxies" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionWordlists" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Wordlists" ToolTip="Wordlist Library (Ctrl+5)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocument" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Wordlists" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionConfigs" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Configs" MouseEnter="ConfigsMenuOptionMouseEnter" MouseLeave="ConfigsMenuOptionMouseLeave" ToolTip="Configuration Editor (Ctrl+6)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CodeJson" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Configs" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionHits" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Hits" ToolTip="Successful Results (Ctrl+7)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Target" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Hits" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionPlugins" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="Plugins" ToolTip="Plugin Manager (Ctrl+8)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Puzzle" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Plugins" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionSettings" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="OBSettings" ToolTip="Application Settings (Ctrl+9)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cog" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Settings" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionRLSettings" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="RLSettings" ToolTip="RuriLib Settings">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Wrench" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="RL Settings" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionCheckUpdate" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="CheckUpdate" ToolTip="Check for Updates">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Update" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="Check Update" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionAbout" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="About" ToolTip="About OpenBullet">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Information" Style="{StaticResource ResponsiveNavIcon}"/>
                            <TextBlock Text="About" Style="{StaticResource ResponsiveNavText}"/>
                        </StackPanel>
                    </Button>
            </StackPanel>
        </Border>

        <!-- Modern Config Submenu -->
        <Border x:Name="configSubmenu"
                Background="{StaticResource Modern.BackgroundCard}"
                BorderBrush="{StaticResource Modern.BorderMain}"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="1000"
                Height="auto"
                Width="160"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                MouseEnter="ConfigSubmenuMouseEnter"
                MouseLeave="ConfigSubmenuMouseLeave"
                Style="{StaticResource ResponsiveBorder}">
            <StackPanel>
                <!-- Using ModernButton style from ModernTheme.xaml -->
                
                <!-- Config Editor Menu Items -->
                <Button x:Name="menuOptionMetadata" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="ConfigMetadata" ToolTip="Metadata" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Information" Style="{StaticResource ResponsiveNavIcon}"/>
                        <TextBlock Text="Metadata" Style="{StaticResource ResponsiveNavText}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionReadme" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="ConfigReadme" ToolTip="Readme" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocument" Style="{StaticResource ResponsiveNavIcon}"/>
                        <TextBlock Text="Readme" Style="{StaticResource ResponsiveNavText}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionStacker" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="ConfigStacker" ToolTip="Stacker" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="LayersTriple" Style="{StaticResource ResponsiveNavIcon}"/>
                        <TextBlock Text="Stacker" Style="{StaticResource ResponsiveNavText}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionLoliCode" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="ConfigLoliCode" ToolTip="LoliCode" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CodeBraces" Style="{StaticResource ResponsiveNavIcon}"/>
                        <TextBlock Text="LoliCode" Style="{StaticResource ResponsiveNavText}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionConfigSettings" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="ConfigSettings" ToolTip="Settings" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Cog" Style="{StaticResource ResponsiveNavIcon}"/>
                        <TextBlock Text="Settings" Style="{StaticResource ResponsiveNavText}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionCSharpCode" Style="{StaticResource ResponsiveNavButton}" Click="HandleNavigationClick" Tag="ConfigCSharpCode" ToolTip="C# Code" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="LanguageCsharp" Style="{StaticResource ResponsiveNavIcon}"/>
                        <TextBlock Text="C# Code" Style="{StaticResource ResponsiveNavText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area with Enhanced Transitions -->
        <Border x:Name="MainContentBorder"
                Grid.Row="1" 
                Background="Transparent" 
                CornerRadius="8" 
                BorderBrush="#FF333333"
                BorderThickness="1"
                ClipToBounds="True"
                Style="{StaticResource ResponsiveBorder}">
            <Grid>
                <!-- Main content frame with smooth transitions -->
                <Frame x:Name="MainFrame" 
                       NavigationUIVisibility="Hidden" 
                       Background="Transparent" />
                
                <!-- Simplified loading indicator -->
            </Grid>
        </Border>

        <mah:ProgressRing 
            x:Name="loadingIndicator"
            Grid.Row="1"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
    </Grid>

</mah:MetroWindow>
