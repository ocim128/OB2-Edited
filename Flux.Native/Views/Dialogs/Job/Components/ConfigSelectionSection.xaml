<UserControl x:Class="Flux.Native.Views.Dialogs.Job.Components.ConfigSelectionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:Flux.Native.Controls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ContentControl Style="{StaticResource Icon.Size16}"
                                Content="{StaticResource Icon.Tune}"
                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                VerticalAlignment="Center"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Configuration" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Pick the config to run and tweak how the job behaves."
                               FontSize="10"
                               Foreground="{DynamicResource Modern.TextMutedOnDark}"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Config Display -->
            <Border Background="{DynamicResource Modern.PanelDark}" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource Modern.OverlayLight}" BorderThickness="1"
                    Visibility="{Binding IsConfigSelected, Converter={StaticResource ResourceKey=BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding ConfigIcon}" Width="28" Height="28" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConfigNameAndAuthor}" 
                              FontSize="11" Foreground="{DynamicResource Modern.ForegroundMain}" VerticalAlignment="Center"
                              TextWrapping="Wrap"/>
                </Grid>
            </Border>
            
            <Button Click="SelectConfig" HorizontalAlignment="Left"
                    Style="{StaticResource StyledPrimaryButton}" Padding="10,5" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource Icon.FolderOpen}" Width="12" Height="12"/>
                    <TextBlock Text="Select Config" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
            <controls:MetadataFieldsPresenter ItemsSource="{Binding ExecutionFields}" />

            <!-- Proxy Behavior Settings -->
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Proxy Options" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,4"/>
                <controls:MetadataFieldsPresenter ItemsSource="{Binding ProxyOptionFields}" />
            </StackPanel>
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="Automation" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,4"/>
                <controls:MetadataFieldsPresenter ItemsSource="{Binding AutomationFields}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
