<Page x:Class="OpenBullet2.Native.Views.Pages.Configs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:uc="clr-namespace:OpenBullet2.Native.Controls"
      xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Configs">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LessThanConverter x:Key="LessThanConverter" />
    </Page.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="40" MinHeight="35" MaxHeight="80" />
        </Grid.RowDefinitions>

        <!-- Modern Header Section -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CompactCardStyle}">
                    <Style.Triggers>
                        <!-- Hide toolbar when window width is very small -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1050}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Current Config:" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedConfig.Name}" Style="{StaticResource LabelTextStyle}" Foreground="#FF1E90FF" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Total Configs:" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Total}" Style="{StaticResource LabelTextStyle}" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Modern Toolbar Section -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CompactCardStyle}">
                    <Style.Triggers>
                        <!-- Hide toolbar when window width is very small -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

                <!-- Action Buttons Group -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="newButton" Click="Create" Margin="0,0,8,0" Style="{StaticResource StyledSuccessButton}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterialDesign Kind="Add" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">New</TextBlock>
                    </StackPanel>
                </Button>
                    <Button x:Name="editButton" Click="Edit" Margin="0,0,8,0" Style="{StaticResource StyledPrimaryButton}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconRemixIcon Kind="Edit2Fill" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Edit</TextBlock>
                    </StackPanel>
                </Button>
                    <Button x:Name="saveButton" Click="Save" Margin="0,0,8,0" Style="{StaticResource StyledPrimaryButton}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconRemixIcon Kind="Save3Fill" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Save</TextBlock>
                    </StackPanel>
                </Button>
                    <Button x:Name="deleteButton" Click="Delete" Margin="0,0,8,0" Style="{StaticResource StyledDangerButton}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Delete</TextBlock>
                    </StackPanel>
                </Button>
                    <Button x:Name="exportSelectedButton" Click="ExportSelected" Margin="0,0,16,0" Style="{StaticResource StyledPrimaryButton}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Export" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Export Selected</TextBlock>
                    </StackPanel>
                </Button>
                    
                    <!-- Search Section -->
                    <Border Background="{DynamicResource BackgroundInput}" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="filterTextbox" 
                                     Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="200" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{DynamicResource ForegroundInput}"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     TextChanged="UpdateSearch"
                                     Padding="8,6"/>
                            <Button x:Name="searchButton" Click="Search" 
                                    Style="{StaticResource StyledPrimaryButton}"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterialDesign Kind="Search" Width="16" Height="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="Search" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
            </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Utility Buttons Group -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource StyledButton}" x:Name="openFolderButton" Click="OpenFolder" Margin="0,0,8,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconRemixIcon Kind="Folder2Fill" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Open Folder</TextBlock>
                    </StackPanel>
                </Button>
                    <Button Style="{StaticResource StyledButton}" x:Name="rescanButton" Click="Rescan" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconRadixIcons Kind="Update" Width="16" Height="16"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Rescan</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Modern Configs List View -->
        <Border Grid.Row="2" Style="{StaticResource StandardCardStyle}" Margin="0,0,0,16">
            <ListView x:Name="configsListView" 
                      Foreground="{DynamicResource ForegroundMain}" 
                      Background="Transparent" 
                      ItemsSource="{Binding Path=ConfigsCollection}" 
                      SelectionMode="Extended" 
                      BorderThickness="0" 
                      VirtualizingPanel.IsVirtualizing="True" 
                      SelectionChanged="ItemHovered"
                      AllowDrop="True" 
                      Drop="configsListView_Drop" 
                      PreviewMouseLeftButtonDown="configsListView_PreviewMouseLeftButtonDown" 
                      MouseMove="configsListView_MouseMove"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Padding="0">

            <!-- Show Headers by overriding the default style -->
            <ListView.Style>
                <Style TargetType="{x:Type ListView}" />
            </ListView.Style>

            <!-- Align Headers to the Left -->
            <ListView.Resources>
                <!-- Modern ScrollBar Page Button Style -->
                <Style x:Key="ModernScrollBarPageButton" TargetType="{x:Type RepeatButton}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Rectangle Fill="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Modern ScrollBar Thumb Style -->
                <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border x:Name="ThumbBorder" 
                                        Background="#CCCCCC" 
                                        CornerRadius="6" 
                                        Opacity="0.5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E6E6E6"/>
                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#F0F0F0"/>
                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                
                <!-- Modern ScrollBar Style for ListView -->
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="MinWidth" Value="12"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" SnapsToDevicePixels="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="18"/>
                                        <RowDefinition Height="0.00001*"/>
                                        <RowDefinition MaxHeight="18"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" Background="Transparent" CornerRadius="6"/>
                                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsMouseOver}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ModernScrollBarPageButton}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ModernScrollBarPageButton}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Width" Value="Auto"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="Height" Value="12"/>
                                        <Setter Property="MinHeight" Value="12"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter TargetName="Bg" Property="LayoutTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="-90"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                
                <Style x:Key="GridViewColumnHeaderGripper" TargetType="Thumb">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStopCollection>
                                        <GradientStop Color="{DynamicResource BorderLightColor}" Offset="0.0" />
                                        <GradientStop Color="{DynamicResource BorderDarkColor}" Offset="1.0" />
                                    </GradientStopCollection>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <Rectangle HorizontalAlignment="Center" Width="1" Fill="{TemplateBinding Background}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black" Offset="0" />
                                <GradientStop Color="White" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                <Grid>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="#FF1E90FF" Background="#FF333333" Padding="2">
                                        <TextBlock x:Name="ContentHeader" 
                                                   Text="{TemplateBinding Content}" 
                                                   Padding="12,8,8,8" 
                                                   Width="{TemplateBinding Width}" 
                                                   TextAlignment="Left" 
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                    <Thumb x:Name="PART_HeaderGripper"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,-9,0"
                                         Style="{StaticResource GridViewColumnHeaderGripper}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style TargetType="{x:Type ListViewItem}">
                    <EventSetter Event="MouseDoubleClick" Handler="ListItemDoubleClick" />
                    <!-- <EventSetter Event="Selected" Handler="ListViewItemSelected" /> -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="Bd" 
                                        BorderBrush="Transparent" 
                                        BorderThickness="0,0,0,1" 
                                        Background="Transparent" 
                                        Padding="4,8"
                    SnapsToDevicePixels="true">
                                    <GridViewRowPresenter 
                    HorizontalAlignment="Left" 
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF404040" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF555555" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF1E90FF" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A9EFF" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#FF2A9AFF" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5AADFF" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

            </ListView.Resources>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel>
                    </VirtualizingStackPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="30">
                        <GridViewColumn.Header>
                            <CheckBox x:Name="selectAllCheckbox" ToolTip="Select All" Checked="SelectAll" Unchecked="DeselectAll" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Path=Icon}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Name}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Name" Click="ColumnHeaderClicked">Name</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Author}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Author" Click="ColumnHeaderClicked">Author</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding Path=Category}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Category" Click="ColumnHeaderClicked">Category</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=NeedsProxies}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="NeedsProxies" Click="ColumnHeaderClicked">Proxies</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=IsRemote}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="IsRemote" Click="ColumnHeaderClicked">Remote</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=AllowedWordlistTypes}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="AllowedWordlistTypes" Click="ColumnHeaderClicked">Wordlists</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding Path=CreationDate}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="CreationDate" Click="ColumnHeaderClicked">Creation Date</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding Path=LastModified}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="LastModified" Click="ColumnHeaderClicked">Last Modified</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        </Border>

        <GridSplitter 
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext"
            Grid.Row="3" 
            Height="6"
            HorizontalAlignment="Stretch" 
            Background="Transparent"
            Margin="8,2"/>
        
        <!-- Modern Information Section -->
        <Border Grid.Row="4" Background="#C0353535" CornerRadius="8" Padding="8">
            
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CompactCardStyle}">
                    <Style.Triggers>
                        <!-- Hide when window width is very small -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=1050}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                          Text="Configuration Information" 
                          FontWeight="SemiBold" 
                          Foreground="#FF1E90FF" 
                          FontSize="9" 
                          Margin="0,0,0,2"/>
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                    <uc:MarkdownViewer 
                        MarkdownText="{Binding HoveredConfig.Readme}" 
                        FontSize="8"
                        Background="Transparent"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
