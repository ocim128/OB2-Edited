<Page x:Class="OpenBullet2.Native.Views.Pages.ConfigSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      xmlns:uc="clr-namespace:OpenBullet2.Native.Controls"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:resources="clr-namespace:RuriLib.Models.Data.Resources.Options;assembly=RuriLib"
      xmlns:rules="clr-namespace:RuriLib.Models.Data.Rules;assembly=RuriLib"
      xmlns:settings="clr-namespace:RuriLib.Models.Configs.Settings;assembly=RuriLib"
      mc:Ignorable="d" 
      d:DesignHeight="2750" d:DesignWidth="800"
      Title="Config Settings">

    <!-- Optimized Config Settings Container with Smooth Scrolling -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  Margin="16,8"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False"
                  ScrollViewer.IsDeferredScrollingEnabled="False">
        <StackPanel MaxWidth="1000" Margin="0,0,0,16">
                
            <!-- General Section -->
            <Border Background="#C0353535" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <iconPacks:PackIconBoxIcons Kind="RegularCog" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                        <TextBlock Text="General Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                    </StackPanel>
                        <!-- General Settings Form -->
    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <!-- Added row for Max Jump Iterations -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                        <!-- Bot Settings -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Suggested amount of bots:" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,8"/>
                        <mah:NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="1000" Value="{Binding GeneralSettings.SuggestedBots}" Width="200" HorizontalAlignment="Left" Margin="12,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum CPM (0 to disable):" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,8"/>
                        <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000000" Value="{Binding GeneralSettings.MaximumCPM}" Width="200" HorizontalAlignment="Left" Margin="12,8"/>

                        <!-- Checkboxes -->
                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Save empty captures" IsChecked="{Binding GeneralSettings.SaveEmptyCaptures}" FontWeight="SemiBold" Foreground="White" Margin="0,12"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Report the last captcha if the bot ends with a RETRY status" IsChecked="{Binding GeneralSettings.ReportLastCaptchaOnRetry}" FontWeight="SemiBold" Foreground="White" Margin="0,12"/>

                        <!-- Continue Statuses -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
                            <TextBlock Text="Statuses for which the bot will continue / stop:" FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding ContinueStatuses, Mode=TwoWay}" PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>
                        
                        <!-- Max Jump Iterations -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Max JUMP iterations (infinite loop guard):" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,8"/>
                        <mah:NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="100000" Value="{Binding GeneralSettings.MaxJumpIterations}" Width="200" HorizontalAlignment="Left" Margin="12,8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Modern Section: Proxies -->
                <Border Background="#C0353535" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconBoxIcons Kind="RegularServer" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Proxy Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Proxy Settings Form -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                        <!-- Use Proxies -->
                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Use proxies" IsChecked="{Binding ProxySettings.UseProxies}" FontWeight="SemiBold" Foreground="White" Margin="0,8"/>
                        
                        <!-- Proxy Settings -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum uses per proxy (0 to disable):" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,8"/>
                        <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000000" Value="{Binding ProxySettings.MaxUsesPerProxy}" Width="200" HorizontalAlignment="Left" Margin="12,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ban loop evasion (0 to disable):" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,8"/>
                        <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1000000" Value="{Binding ProxySettings.BanLoopEvasion}" Width="200" HorizontalAlignment="Left" Margin="12,8"/>

                        <!-- Proxy Selectors -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
                            <TextBlock Text="Ban proxy when bot ends with these statuses:" FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding ProxyBanStatuses, Mode=TwoWay}" PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
                            <TextBlock Text="Allowed proxy types:" FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding AllowedProxyTypes, Mode=TwoWay}" PossibleValues="{Binding ProxyTypes}"/>
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Modern Section: Data -->
                <Border Background="#C0353535" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconBoxIcons Kind="RegularData" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Data Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                    <!-- Data Settings -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Allowed wordlist types:" FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                        <uc:MultipleSelector SelectedValues="{Binding AllowedWordlistTypes, Mode=TwoWay}" PossibleValues="{Binding WordlistTypes}"/>
                    </StackPanel>

                    <CheckBox Content="URL Encode data after slicing" IsChecked="{Binding DataSettings.UrlEncodeDataAfterSlicing}" FontWeight="SemiBold" Foreground="White" Margin="0,12"/>
                        <!-- Rules Section -->
                        <TextBlock Text="Data Rules" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#FF1E90FF" Margin="0,16,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Click="AddSimpleDataRule" Margin="0,0,8,0" 
                                    Style="{StaticResource StyledSuccessButton}"
                                    MinWidth="100" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Simple"/>
                                </StackPanel>
                            </Button>
                            <Button Click="AddRegexDataRule" Margin="0,0,8,0" 
                                    Style="{StaticResource StyledSuccessButton}"
                                    MinWidth="100" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Regex"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                <ItemsControl ItemsSource="{Binding DataRulesCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type rules:SimpleDataRule}">
                            <Border Padding="0 5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" VerticalAlignment="Center" Content="Slice Name" />
                                    <TextBox Grid.Column="1" Text="{Binding SliceName}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <ComboBox Grid.Column="2" 
                                              ItemsSource="{Binding DataContext.StringRules, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedItem="{Binding Comparison}" Height="30" Margin="5 0"
                                              Style="{StaticResource CleanComboBox}" />
                                    <TextBox Grid.Column="3" Text="{Binding StringToCompare}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <CheckBox Grid.Column="4" Content="Case sensitive"
                                      IsChecked="{Binding CaseSensitive}"
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <CheckBox Grid.Column="5" Content="Invert"
                                      IsChecked="{Binding Invert}"
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <Button Tag="{Binding}" Grid.Column="6" 
                                            Click="RemoveDataRule" Margin="0 0 5 0" Style="{StaticResource StyledDangerButton}" >
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularX" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type rules:RegexDataRule}">
                            <Border Padding="0 5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" VerticalAlignment="Center" Content="Slice Name" />
                                    <TextBox Grid.Column="1" Text="{Binding SliceName}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <Label Grid.Column="2" VerticalAlignment="Center" Content="Regex to match" />
                                    <TextBox Grid.Column="3" Text="{Binding RegexToMatch}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <CheckBox Grid.Column="4" Content="Invert"
                                      IsChecked="{Binding Invert}"
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <Button Tag="{Binding}" Grid.Column="5" 
                                            Click="RemoveDataRule" Margin="0 0 5 0" Style="{StaticResource StyledDangerButton}" >
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularX" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Test your data here:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding TestDataForRules}" Margin="5 5 0 5" Style="{StaticResource MatchingTextBox}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding WordlistTypes}" SelectedValue="{Binding TestWordlistTypeForRules}" Margin="5 5 0 5" Style="{StaticResource CleanComboBox}" />
                    <Button Grid.Column="3" Click="TestDataRules" Margin="5 5 5 5" 
                        Style="{StaticResource StyledPrimaryButton}"
                        HorizontalAlignment="Left" >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularTestTube" />
                            <TextBlock VerticalAlignment="Center" Margin="5 0">Test</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
                        <TextBlock Text="Resources" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#FF1E90FF" Margin="0,16,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Click="AddLinesFromFileResource" Margin="0,0,8,0" 
                                    Style="{StaticResource StyledSuccessButton}"
                                    MinWidth="140" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Lines from file"/>
                                </StackPanel>
                            </Button>
                            <Button Click="AddRandomLinesFromFileResource" Margin="0,0,8,0" 
                                    Style="{StaticResource StyledSuccessButton}"
                                    MinWidth="180" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Random lines from file"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                <ItemsControl ItemsSource="{Binding ResourcesCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type resources:LinesFromFileResourceOptions}">
                            <Border Padding="0 5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" VerticalAlignment="Center" Content="Name" />
                                    <TextBox Grid.Column="1" Text="{Binding Name}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <Label Grid.Column="2" VerticalAlignment="Center" Content="Location" />
                                    <TextBox Grid.Column="3" Text="{Binding Location}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <CheckBox Grid.Column="4" Content="Loops around"
                                      IsChecked="{Binding LoopsAround}" 
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <CheckBox Grid.Column="5" Content="Ignore empty lines"
                                      IsChecked="{Binding IgnoreEmptyLines}" 
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <Button Tag="{Binding}" Grid.Column="6" 
                                            Click="RemoveResource" Margin="0 0 5 0" Style="{StaticResource StyledDangerButton}" >
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularX" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type resources:RandomLinesFromFileResourceOptions}">
                            <Border Padding="0 5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" VerticalAlignment="Center" Content="Name" />
                                    <TextBox Grid.Column="1" Text="{Binding Name}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <Label Grid.Column="2" VerticalAlignment="Center" Content="Location" />
                                    <TextBox Grid.Column="3" Text="{Binding Location}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <CheckBox Grid.Column="4" Content="Unique"
                                      IsChecked="{Binding Unique}" 
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <CheckBox Grid.Column="5" Content="Ignore empty lines"
                                      IsChecked="{Binding IgnoreEmptyLines}" 
                                      Margin="5 0"
                                      VerticalContentAlignment="Center"/>
                                    <Button Tag="{Binding}" Grid.Column="6" 
                                            Click="RemoveResource" Margin="0 0 5 0" Style="{StaticResource StyledDangerButton}" >
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularX" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Modern Section: Inputs -->
                <Border Background="#C0353535" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Input Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Custom Inputs -->
                        <TextBlock Text="Custom Inputs" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#FF1E90FF" Margin="0,0,0,12"/>
                        <Button x:Name="addCustomInputButton" Click="AddCustomInput" 
                        Style="{StaticResource StyledSuccessButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Custom Input" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="customInputsControl" ItemsSource="{Binding CustomInputsCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0 5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" VerticalAlignment="Center" Content="Description" />
                                    <TextBox Grid.Column="1" Text="{Binding Description}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <Label Grid.Column="2" VerticalAlignment="Center" Content="Variable name" />
                                    <TextBox Grid.Column="3" Text="{Binding VariableName}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <Label Grid.Column="4" VerticalAlignment="Center" Content="Default answer" />
                                    <TextBox Grid.Column="5" Text="{Binding DefaultAnswer}" Height="30" Margin="5 0" Style="{StaticResource MatchingTextBox}" />
                                    <Button x:Name="removeCustomInputButton" Tag="{Binding}" Grid.Column="6" 
                                            Click="RemoveCustomInput" Margin="0 0 5 0" Style="{StaticResource StyledDangerButton}" >
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularX" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Modern Section: Puppeteer -->
                <Border Background="#C0353535" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="Web" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Puppeteer Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Browser Status Settings -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Quit the browser when the bot ends with one of these statuses:" 
                                       FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding QuitBrowserStatuses, Mode=TwoWay}" 
                                                 PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>
                        
                        <!-- Browser Options -->
                        <StackPanel Margin="0,0,0,16">
                            <CheckBox Content="Headless mode" 
                                      IsChecked="{Binding BrowserSettings.Headless}" 
                                      FontWeight="SemiBold" Foreground="White" 
                                      VerticalContentAlignment="Center" Margin="0,8"/>
                            <StackPanel Margin="0,8">
                                <TextBlock Text="Stealth Mode:" 
                                           FontWeight="SemiBold" Foreground="#FF1E90FF" 
                                           Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding BrowserSettings.StealthMode}" 
                                          Style="{StaticResource CleanComboBox}" 
                                          Width="200" Height="30" HorizontalAlignment="Left"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Default" Tag="{x:Static settings:BrowserStealthMode.Default}" />
                        <ComboBoxItem Content="Stealth" Tag="{x:Static settings:BrowserStealthMode.Stealth}" />
                        <ComboBoxItem Content="Enhanced Stealth" Tag="{x:Static settings:BrowserStealthMode.EnhancedStealth}" />
                        <ComboBoxItem Content="Option4 Maximum Stealth" Tag="{x:Static settings:BrowserStealthMode.Option4}" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Content="Load only document and script" 
                                      IsChecked="{Binding BrowserSettings.LoadOnlyDocumentAndScript}" 
                                      FontWeight="SemiBold" Foreground="White" 
                                      VerticalContentAlignment="Center" Margin="0,8"/>
                            <CheckBox Content="Dismiss dialogs" 
                                      IsChecked="{Binding BrowserSettings.DismissDialogs}" 
                                      FontWeight="SemiBold" Foreground="White" 
                                      VerticalContentAlignment="Center" Margin="0,8"/>
                            <CheckBox Content="Ignore HTTPS errors" 
                                      IsChecked="{Binding BrowserSettings.IgnoreHttpsErrors}" 
                                      FontWeight="SemiBold" Foreground="White" 
                                      VerticalContentAlignment="Center" Margin="0,8"/>
                        </StackPanel>
                        
                        <!-- Command Line Arguments -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Command line arguments:" 
                                       FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding BrowserSettings.CommandLineArgs}" 
                                     Style="{StaticResource MatchingTextBox}" Height="30"/>
                        </StackPanel>
                        
                        <!-- Blocked URLs -->
                        <StackPanel>
                            <TextBlock Text="Blocked URLs (one per line):" 
                                       FontWeight="SemiBold" Foreground="#FF1E90FF" Margin="0,0,0,8"/>
                             <TextBox x:Name="blockedUrlsTextBox" 
                                      Background="{DynamicResource BackgroundSecondary}" 
                                      Foreground="{DynamicResource ForegroundMain}" 
                                      FontFamily="Consolas"
                                      Margin="0,0,0,0"
                                      Height="100"
                                      VerticalContentAlignment="Top"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalScrollBarVisibility="Auto"
                                      TextChanged="BlockedUrlsChanged"/>
                        </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
