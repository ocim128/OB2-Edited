<Page x:Class="Flux.Native.Views.Dialogs.Job.BotLogDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="950"
      Title="Bot Log Viewer"
      Background="{DynamicResource Modern.BotLogBackground}">

    <Page.Resources>
        <!-- Modern Search TextBox -->
        <Style x:Key="BotLogSearchTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Modern.SearchInputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundOnDark}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Modern.DarkBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Modern.ForegroundOnDark}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Modern.DarkFocusShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Modern.DarkFocusBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Toolbar Button -->
        <Style x:Key="BotLogToolbarButton" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Modern.DialogBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundOnDark}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Modern.DarkBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Modern.SearchHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Modern.DarkHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Toggle Button Style -->
        <Style x:Key="BotLogToggleButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{DynamicResource Modern.DialogBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Modern.TextMutedLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Modern.DarkBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Modern.Success}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Modern.Success}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header with title and stats -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar row -->
            <RowDefinition Height="Auto" />
            <!-- Main log content -->
            <RowDefinition Height="*" />
            <!-- Search controls row -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <iconPacks:PackIconRadixIcons Kind="ActivityLog"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="{DynamicResource Modern.InfoLight}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                    <TextBlock Text="Bot Log Viewer"
                               Foreground="{DynamicResource Modern.TextMutedLight}"
                               FontFamily="Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Log Stats -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Modern.DialogBackground}"
                        CornerRadius="8"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Entries: "
                                   Foreground="{DynamicResource Modern.TextMuted}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EntryCount}"
                                   Foreground="{DynamicResource Modern.Success}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- Toolbar Section -->
        <Border Grid.Row="1" 
                Background="{DynamicResource Modern.BotLogPanel}"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource Modern.BotLogBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- View Options -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <!-- Word Wrap Toggle -->
                    <ToggleButton x:Name="wordWrapToggle"
                                  Style="{StaticResource BotLogToggleButton}"
                                  IsChecked="True"
                                  ToolTip="Toggle Word Wrap"
                                  Click="ToggleWordWrap"
                                  Margin="0,0,8,0">
                        <iconPacks:PackIconMaterial Kind="Wrap"
                                                    Width="14"
                                                    Height="14"/>
                    </ToggleButton>
                    
                    <!-- Line Numbers Toggle -->
                    <ToggleButton x:Name="lineNumbersToggle"
                                  Style="{StaticResource BotLogToggleButton}"
                                  IsChecked="False"
                                  ToolTip="Toggle Line Numbers"
                                  Click="ToggleLineNumbers"
                                  Margin="0,0,8,0">
                        <iconPacks:PackIconMaterial Kind="FormatListNumbered"
                                                    Width="14"
                                                    Height="14"/>
                    </ToggleButton>
                    
                    <!-- Separator -->
                    <Border Width="1" Background="{DynamicResource Modern.DarkBorder}" Margin="8,0,16,0"/>
                    
                    <!-- Font Size Controls -->
                    <TextBlock Text="Font:"
                               Foreground="{DynamicResource Modern.TextMuted}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BotLogToolbarButton}"
                            Click="DecreaseFontSize"
                            ToolTip="Decrease Font Size"
                            Width="28" Height="28"
                            Margin="0,0,4,0">
                        <iconPacks:PackIconMaterial Kind="Minus" Width="10" Height="10"/>
                    </Button>
                    <TextBlock x:Name="fontSizeDisplay"
                               Text="13"
                               Foreground="{DynamicResource Modern.TextMutedLight}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               MinWidth="24"
                               TextAlignment="Center"/>
                    <Button Style="{StaticResource BotLogToolbarButton}"
                            Click="IncreaseFontSize"
                            ToolTip="Increase Font Size"
                            Width="28" Height="28"
                            Margin="4,0,0,0">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <!-- Copy All Button -->
                    <Button Style="{StaticResource BotLogToolbarButton}"
                            Click="CopyAll"
                            ToolTip="Copy All to Clipboard (Ctrl+C)"
                            Padding="10,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentCopy"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="Copy All" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Scroll to Top -->
                    <Button Style="{StaticResource BotLogToolbarButton}"
                            Click="ScrollToTop"
                            ToolTip="Scroll to Top"
                            Width="32" Height="32"
                            Margin="0,0,4,0">
                        <iconPacks:PackIconMaterial Kind="ArrowUp" Width="12" Height="12"/>
                    </Button>
                    
                    <!-- Scroll to Bottom -->
                    <Button Style="{StaticResource BotLogToolbarButton}"
                            Click="ScrollToBottom"
                            ToolTip="Scroll to Bottom"
                            Width="32" Height="32">
                        <iconPacks:PackIconMaterial Kind="ArrowDown" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Log Content -->
        <Border Grid.Row="2"
                Background="{DynamicResource Modern.BotLogTerminal}"
                CornerRadius="10"
                BorderBrush="{DynamicResource Modern.BotLogBorder}"
                BorderThickness="1"
                Margin="0,0,0,12">
            <avalonEdit:TextEditor x:Name="logRTB"
                                   IsReadOnly="True"
                                   ShowLineNumbers="False"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Background="Transparent"
                                   Foreground="Gainsboro"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   WordWrap="True"
                                   Padding="14"/>
        </Border>
        
        <!-- Search Controls -->
        <Border Grid.Row="3"
                Background="{DynamicResource Modern.BotLogPanel}"
                CornerRadius="10"
                Padding="14,12"
                BorderBrush="{DynamicResource Modern.BotLogBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search input -->
                    <ColumnDefinition Width="*" />
                    <!-- Search button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Navigation -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Match info -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         x:Name="searchTextBox"
                         Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BotLogSearchTextBox}"
                         KeyDown="SearchTextBox_KeyDown"
                         ToolTip="Search text (Enter to search, F3 for next, Shift+F3 for previous)"/>
                
                <!-- Search Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource BotLogToolbarButton}"
                        Click="Search"
                        Background="{DynamicResource Modern.Success}"
                        BorderBrush="{DynamicResource Modern.Success}"
                        Padding="14,8"
                        Margin="10,0,0,0"
                        ToolTip="Search (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Search"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,6,0"/>
                        <TextBlock Text="Search"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <!-- Navigation Buttons -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Modern.BotLogInputBackground}"
                        CornerRadius="8"
                        Padding="4"
                        BorderBrush="{DynamicResource Modern.BotLogBorder}"
                        BorderThickness="1"
                        Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BotLogToolbarButton}"
                                Click="PreviousMatch"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32" Height="32"
                                ToolTip="Previous Match (Shift+F3)">
                            <iconPacks:PackIconUnicons Kind="AngleLeft"
                                                       Width="16"
                                                       Height="16"/>
                        </Button>
                        <Button Style="{StaticResource BotLogToolbarButton}"
                                Click="NextMatch"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32" Height="32"
                                ToolTip="Next Match (F3)">
                            <iconPacks:PackIconUnicons Kind="AngleRight"
                                                       Width="16"
                                                       Height="16"/>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Match Info Display -->
                <Border Grid.Column="3"
                        Margin="12,0,0,0"
                        Background="{DynamicResource Modern.BotLogPanel}"
                        CornerRadius="6"
                        Padding="14,8"
                        BorderBrush="{DynamicResource Modern.BotLogInputBorder}"
                        BorderThickness="1"
                        MinWidth="90">
                    <TextBlock Text="{Binding MatchInfo}"
                               Foreground="{DynamicResource Modern.Success}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
