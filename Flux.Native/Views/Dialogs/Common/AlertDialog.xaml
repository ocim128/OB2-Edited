<Page x:Class="Flux.Native.Views.Dialogs.Common.AlertDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Common"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      KeyDown="PageKeyDown"
      MinWidth="400"
      MaxWidth="800"
      Background="{DynamicResource BackgroundSecondary}"
      Title="Alert">

    <Border Padding="20">
        <StackPanel 
            MinWidth="380"
            MaxWidth="760"
            HorizontalAlignment="Center">
            <iconPacks:PackIconOcticons 
                x:Name="icon"
                Margin="0 30 0 0"
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                Foreground="YellowGreen"
                Kind="Check" />

            <TextBlock
                x:Name="title"
                Margin="0 30 0 0"
                FontSize="20"
                Text="Success"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Foreground="Gainsboro"
                />

            <ScrollViewer
                x:Name="messageScrollViewer"
                Margin="0 20 0 30"
                MaxHeight="300"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="messageScrollable"
                    FontSize="14"
                    Text="Success"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    Foreground="Gainsboro"
                    Padding="10"
                    />
            </ScrollViewer>
            
            <TextBlock
                x:Name="message"
                Margin="0 20 0 30"
                FontSize="14"
                Text="Success"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Foreground="Gainsboro"
                />

            <Button Click="Ok" x:Name="okButton"
                Width="100"
                Margin="0 15 0 0" Style="{StaticResource StyledSuccessButton}">
                <TextBlock VerticalAlignment="Center">Ok</TextBlock>
            </Button>

        </StackPanel>
    </Border>
</Page>
