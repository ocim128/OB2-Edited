<Page x:Class="Flux.Native.Views.Pages.Configs.ConfigStacker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Flux.Native.Views.Controls.Config"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      KeyDown="PageKeyDown"
      Focusable="True"
      Title="ConfigStacker">

    <Grid Margin="20" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BlockListColumn" Width="220" MinWidth="220" MaxWidth="360" />
            <ColumnDefinition x:Name="StackerSplitterColumn" Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:ConfigStackerBlockListControl x:Name="BlockListControl"
                                                Grid.Column="0" />

        <GridSplitter x:Name="BlockListGridSplitter"
                      Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="{DynamicResource Modern.BorderSecondary}"
                            Opacity="0.5"
                            CornerRadius="2">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                            <Ellipse Width="3" Height="3" Margin="0,1" Fill="{DynamicResource Modern.TextTertiary}" />
                            <Ellipse Width="3" Height="3" Margin="0,1" Fill="{DynamicResource Modern.TextTertiary}" />
                            <Ellipse Width="3" Height="3" Margin="0,1" Fill="{DynamicResource Modern.TextTertiary}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <controls:ConfigStackerInspectorControl x:Name="InspectorControl"
                                                Grid.Column="2"
                                                DataContext="{Binding Inspector}" />
    </Grid>
</Page>
