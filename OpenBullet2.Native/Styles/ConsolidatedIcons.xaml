<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- ========================================= -->
    <!-- CONSOLIDATED ICON RESOURCES              -->
    <!-- Enhanced for Better Performance,         -->
    <!-- Maintainability, and Consistency        -->
    <!-- ========================================= -->

    <!-- ========================================= -->
    <!-- CORE SYSTEM ICONS (Material Design)     -->
    <!-- ========================================= -->
    
    <!-- Application Control -->
    <iconPacks:PackIconMaterial x:Key="Icon.Close" Kind="Close" />
    <iconPacks:PackIconMaterial x:Key="Icon.Plus" Kind="Plus" />
    <iconPacks:PackIconMaterial x:Key="Icon.Check" Kind="Check" />
    <iconPacks:PackIconMaterial x:Key="Icon.ChevronUp" Kind="ChevronUp" />
    <iconPacks:PackIconMaterial x:Key="Icon.Search" Kind="Magnify" />
    <iconPacks:PackIconMaterial x:Key="Icon.DatabaseExport" Kind="DatabaseExport" />
    
    <!-- Application Specific -->
    <iconPacks:PackIconMaterial x:Key="Icon.Cog" Kind="Cog" />
    <iconPacks:PackIconMaterial x:Key="Icon.Tune" Kind="Tune" />
    <iconPacks:PackIconMaterial x:Key="Icon.Database" Kind="Database" />
    <iconPacks:PackIconMaterial x:Key="Icon.Network" Kind="ServerNetwork" />
    <iconPacks:PackIconMaterial x:Key="Icon.Clock" Kind="ClockOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.FolderOpen" Kind="FolderOpen" />
    <iconPacks:PackIconMaterial x:Key="Icon.FolderOutline" Kind="FolderOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.FileOutline" Kind="FileDocumentOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.TagOutline" Kind="TagOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.Account" Kind="AccountOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.History" Kind="History" />

    <!-- ========================================= -->
    <!-- SPECIALIZED ICON PACKS                  -->
    <!-- ========================================= -->
    
    <!-- Remix Icons (Filled Variants) -->
    <iconPacks:PackIconRemixIcon x:Key="Icon.FolderFill" Kind="Folder2Fill" />

    <!-- ========================================= -->
    <!-- ICON STYLES & TEMPLATES                 -->
    <!-- ========================================= -->
    
    <!-- Icon Templates for Common Sizes -->
    <Style x:Key="Icon.Size16" TargetType="Control">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style x:Key="Icon.Size14" TargetType="Control">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style x:Key="Icon.Size12" TargetType="Control">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="Icon.Size10" TargetType="Control">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <Style x:Key="Icon.Size24" TargetType="Control">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ========================================= -->
    <!-- CENTRALIZED COLOR DEFINITIONS            -->
    <!-- ========================================= -->
    
    <!-- Primary Blue Color -->
    <SolidColorBrush x:Key="Icon.PrimaryBlue" Color="#3B82F6" />
    <SolidColorBrush x:Key="Icon.SecondaryBlue" Color="#1E90FF" />
    <SolidColorBrush x:Key="Icon.AccentGray" Color="#64748B" />
    <SolidColorBrush x:Key="Icon.LightGray" Color="#94A3B8" />
    
    <!-- ========================================= -->
    <!-- COMMON ICON + TEXT PATTERNS             -->
    <!-- ========================================= -->
    
    <!-- Dialog Header with Icon Pattern -->
    <Style x:Key="DialogHeader.WithIcon" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,28" />
    </Style>
    
    <!-- Dialog Header Icon Style -->
    <Style x:Key="DialogHeader.Icon" TargetType="ContentControl">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Icon.PrimaryBlue}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

</ResourceDictionary>