<UserControl x:Class="Flux.Native.Views.Controls.Config.ConfigStackerBlockListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:converters="clr-namespace:Flux.Native.Converters"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="300">
    <UserControl.Resources>
        <converters:BoolToThicknessConverter x:Key="BoolToThick" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                BorderBrush="{DynamicResource Modern.BorderSecondary}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                    <TextBlock Text="Config stacker"
                               Foreground="{StaticResource Modern.ForegroundMain}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Stack.Count, StringFormat=Blocks: {0}, TargetNullValue=Blocks: 0}"
                               Foreground="{StaticResource Modern.ForegroundMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <primitives:UniformGrid Grid.Row="1"
                                        Columns="4"
                                        HorizontalAlignment="Center">
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,8"
                            Background="{StaticResource Modern.Success}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Add a new block"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="AddBlock">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,8"
                            Background="{StaticResource Modern.Error}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Remove selected block(s)"
                            mah:ControlsHelper.CornerRadius="8"
                            Command="{Binding RemoveSelectedCommand}">
                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,8"
                            Background="{StaticResource Modern.ThemeAccent}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Clone selected block(s)"
                            mah:ControlsHelper.CornerRadius="8"
                            Command="{Binding CloneSelectedCommand}">
                        <iconPacks:PackIconMaterial Kind="ContentDuplicate" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,0,8"
                            Background="{StaticResource Modern.ThemeMain}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Move up"
                            mah:ControlsHelper.CornerRadius="8"
                            Command="{Binding MoveSelectedUpCommand}">
                        <iconPacks:PackIconUnicons Kind="AngleUp" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.ThemeMain}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Move down"
                            mah:ControlsHelper.CornerRadius="8"
                            Command="{Binding MoveSelectedDownCommand}">
                        <iconPacks:PackIconUnicons Kind="AngleDown" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.Warning}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Enable/Disable"
                            mah:ControlsHelper.CornerRadius="8"
                            Command="{Binding ToggleDisabledCommand}">
                        <iconPacks:PackIconForkAwesome Kind="Ban" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.ThemeSecondary}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Undo last action"
                            mah:ControlsHelper.CornerRadius="8"
                            Command="{Binding UndoCommand}">
                        <iconPacks:PackIconMaterial Kind="Undo" Width="16" Height="16" />
                    </Button>
                </primitives:UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Modern.BackgroundSecondary}"
                BorderBrush="{DynamicResource Modern.BorderSecondary}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Control Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Modern.ForegroundMain}"
                           Margin="0,0,0,10" />

                <Border Grid.Row="1"
                        Background="{DynamicResource Modern.BackgroundInput}"
                        BorderBrush="{DynamicResource Modern.BorderInput}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,0"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="Magnify"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource Modern.ForegroundMuted}" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Modern.ForegroundMain}"
                                 FontSize="12"
                                 mah:TextBoxHelper.Watermark="Search blocks..."
                                 mah:TextBoxHelper.UseFloatingWatermark="False"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BlocksItemsControl"
                                  ItemsSource="{Binding Stack}"
                                  Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                                        VirtualizingPanel.ScrollUnit="Pixel" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ModernButton}"
                                        Height="40"
                                        Margin="0,4"
                                        Padding="8,0"
                                        Background="{Binding BackgroundColor}"
                                        Foreground="{Binding ForegroundColor}"
                                        BorderThickness="{Binding Selected, Converter={StaticResource BoolToThick}}"
                                        BorderBrush="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#3B82F6|Transparent'}"
                                        Tag="{Binding}"
                                        Click="SelectBlock"
                                        ToolTip="{Binding Block.Descriptor.Name}">
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ForegroundColor}" Opacity="0.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding ForegroundColor}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
