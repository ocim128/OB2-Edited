<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- ========================================= -->
    <!-- CONSOLIDATED ICON RESOURCES              -->
    <!-- Enhanced for Better Performance,         -->
    <!-- Maintainability, and Consistency        -->
    <!-- ========================================= -->

    <!-- ========================================= -->
    <!-- CORE SYSTEM ICONS (Material Design)     -->
    <!-- ========================================= -->
    
    <!-- Basic Actions -->
    <iconPacks:PackIconMaterial x:Key="Icon.Play" Kind="Play" />
    <iconPacks:PackIconMaterial x:Key="Icon.Pause" Kind="Pause" />
    <iconPacks:PackIconMaterial x:Key="Icon.Stop" Kind="Stop" />
    <iconPacks:PackIconMaterial x:Key="Icon.Close" Kind="Close" />
    <iconPacks:PackIconMaterial x:Key="Icon.CloseThick" Kind="CloseThick" />
    <iconPacks:PackIconMaterial x:Key="Icon.CloseOutline" Kind="CloseOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.Plus" Kind="Plus" />
    <iconPacks:PackIconMaterial x:Key="Icon.Minus" Kind="Minus" />
    <iconPacks:PackIconMaterial x:Key="Icon.Refresh" Kind="Refresh" />
    <iconPacks:PackIconMaterial x:Key="Icon.Save" Kind="ContentSave" />
    <iconPacks:PackIconMaterial x:Key="Icon.Export" Kind="Export" />
    <iconPacks:PackIconMaterial x:Key="Icon.DatabaseExport" Kind="DatabaseExport" />
    
    <!-- Edit Actions -->
    <iconPacks:PackIconMaterial x:Key="Icon.Edit" Kind="Pencil" />
    <iconPacks:PackIconMaterial x:Key="Icon.Delete" Kind="Delete" />
    <iconPacks:PackIconMaterial x:Key="Icon.DeleteSweep" Kind="DeleteSweep" />
    <iconPacks:PackIconMaterial x:Key="Icon.TrashCan" Kind="TrashCan" />
    <iconPacks:PackIconMaterial x:Key="Icon.Copy" Kind="ContentCopy" />
    
    <!-- Navigation -->
    <iconPacks:PackIconMaterial x:Key="Icon.Home" Kind="Home" />
    <iconPacks:PackIconMaterial x:Key="Icon.ChevronDown" Kind="ChevronDown" />
    <iconPacks:PackIconMaterial x:Key="Icon.ChevronUp" Kind="ChevronUp" />
    <iconPacks:PackIconMaterial x:Key="Icon.ChevronLeft" Kind="ChevronLeft" />
    <iconPacks:PackIconMaterial x:Key="Icon.ChevronRight" Kind="ChevronRight" />
    
    <!-- Files & Folders -->
    <iconPacks:PackIconMaterial x:Key="Icon.Folder" Kind="Folder" />
    <iconPacks:PackIconMaterial x:Key="Icon.FolderOpen" Kind="FolderOpen" />
    <iconPacks:PackIconMaterial x:Key="Icon.FolderOutline" Kind="FolderOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.File" Kind="FileDocument" />
    <iconPacks:PackIconMaterial x:Key="Icon.FileEdit" Kind="FileDocumentEdit" />
    <iconPacks:PackIconMaterial x:Key="Icon.FileOutline" Kind="FileDocumentOutline" />
    
    <!-- System & Settings -->
    <iconPacks:PackIconMaterial x:Key="Icon.Cog" Kind="Cog" />
    <iconPacks:PackIconMaterial x:Key="Icon.Settings" Kind="Settings" />
    <iconPacks:PackIconMaterial x:Key="Icon.SettingsHelper" Kind="SettingsHelper" />
    <iconPacks:PackIconMaterial x:Key="Icon.Tune" Kind="Tune" />
    
    <!-- Status & Feedback -->
    <iconPacks:PackIconMaterial x:Key="Icon.Info" Kind="Information" />
    <iconPacks:PackIconMaterial x:Key="Icon.Warning" Kind="Alert" />
    <iconPacks:PackIconMaterial x:Key="Icon.AlertCircle" Kind="AlertCircle" />
    <iconPacks:PackIconMaterial x:Key="Icon.Error" Kind="CloseCircle" />
    <iconPacks:PackIconMaterial x:Key="Icon.Success" Kind="CheckCircle" />
    <iconPacks:PackIconMaterial x:Key="Icon.Check" Kind="Check" />
    
    <!-- Search & Discovery -->
    <iconPacks:PackIconMaterial x:Key="Icon.Search" Kind="Magnify" />
    <iconPacks:PackIconMaterial x:Key="Icon.Target" Kind="Target" />
    
    <!-- ========================================= -->
    <!-- APPLICATION SPECIFIC ICONS              -->
    <!-- ========================================= -->
    
    <!-- OpenBullet Core -->
    <iconPacks:PackIconMaterial x:Key="Icon.Rocket" Kind="RocketLaunchOutline" />
    
    <!-- Network & Server -->
    <iconPacks:PackIconMaterial x:Key="Icon.Server" Kind="Server" />
    <iconPacks:PackIconMaterial x:Key="Icon.Network" Kind="ServerNetwork" />
    
    <!-- Data & Analytics -->
    <iconPacks:PackIconMaterial x:Key="Icon.Database" Kind="Database" />
    
    <!-- Development -->
    <iconPacks:PackIconMaterial x:Key="Icon.Code" Kind="CodeBraces" />
    
    <!-- System Resources -->
    <iconPacks:PackIconMaterial x:Key="Icon.Clock" Kind="ClockOutline" />
    
    <!-- User & Social -->
    <iconPacks:PackIconMaterial x:Key="Icon.Account" Kind="AccountOutline" />
    
    <!-- Media & Content -->
    <iconPacks:PackIconMaterial x:Key="Icon.GoogleChrome" Kind="GoogleChrome" />
    
    <!-- Miscellaneous -->
    <iconPacks:PackIconMaterial x:Key="Icon.Tag" Kind="TagText" />
    <iconPacks:PackIconMaterial x:Key="Icon.TagOutline" Kind="TagOutline" />
    <iconPacks:PackIconMaterial x:Key="Icon.Puzzle" Kind="Puzzle" />
    <iconPacks:PackIconMaterial x:Key="Icon.Update" Kind="Update" />
    <iconPacks:PackIconMaterial x:Key="Icon.SelectAll" Kind="SelectAll" />
    <iconPacks:PackIconMaterial x:Key="Icon.FastForward" Kind="FastForward" />
    <iconPacks:PackIconMaterial x:Key="Icon.History" Kind="History" />
    
    <!-- ========================================= -->
    <!-- SPECIALIZED ICON PACKS                  -->
    <!-- ========================================= -->
    
    <!-- Material Design Icons (Alternative Styles) -->
    <iconPacks:PackIconMaterialDesign x:Key="Icon.Add" Kind="Add" />

    <!-- Remix Icons (Filled Variants - only used ones) -->
    <iconPacks:PackIconRemixIcon x:Key="Icon.FolderFill" Kind="Folder2Fill" />

    <!-- FontAwesome (Solid Variants - only used ones) -->
    <iconPacks:PackIconFontAwesome x:Key="Icon.Forward" Kind="ForwardSolid" />
    <iconPacks:PackIconFontAwesome x:Key="Icon.Clone" Kind="CloneSolid" />
    <iconPacks:PackIconFontAwesome x:Key="Icon.LayerGroup" Kind="LayerGroupSolid" />

    <!-- ========================================= -->
    <!-- ICON STYLES & TEMPLATES                 -->
    <!-- ========================================= -->
    
    <!-- Icon Templates for Common Sizes -->
    <Style x:Key="Icon.Size16" TargetType="Control">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style x:Key="Icon.Size14" TargetType="Control">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style x:Key="Icon.Size12" TargetType="Control">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="Icon.Size10" TargetType="Control">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <Style x:Key="Icon.Size24" TargetType="Control">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ========================================= -->
    <!-- CENTRALIZED COLOR DEFINITIONS            -->
    <!-- ========================================= -->
    
    <!-- Primary Blue Color -->
    <SolidColorBrush x:Key="Icon.PrimaryBlue" Color="#3B82F6" />
    <SolidColorBrush x:Key="Icon.SecondaryBlue" Color="#1E90FF" />
    <SolidColorBrush x:Key="Icon.AccentGray" Color="#64748B" />
    <SolidColorBrush x:Key="Icon.LightGray" Color="#94A3B8" />
    
    <!-- ========================================= -->
    <!-- COMMON ICON + TEXT PATTERNS             -->
    <!-- ========================================= -->
    

    
    <!-- Dialog Header with Icon Pattern -->
    <Style x:Key="DialogHeader.WithIcon" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,28" />
    </Style>
    
    <!-- Dialog Header Icon Style -->
    <Style x:Key="DialogHeader.Icon" TargetType="ContentControl">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Icon.PrimaryBlue}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    
    <!-- Section Header Templates - Simplified -->
    <DataTemplate x:Key="Template.SectionHeader.General">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <iconPacks:PackIconBoxIcons Kind="RegularCog" Width="24" Height="24" 
                                       Foreground="{StaticResource Icon.SecondaryBlue}" Margin="0,0,12,0"/>
            <TextBlock Text="General Settings" FontSize="20" FontWeight="Bold" 
                      Foreground="{StaticResource Icon.SecondaryBlue}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    
    <DataTemplate x:Key="Template.SectionHeader.Server">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <iconPacks:PackIconBoxIcons Kind="RegularServer" Width="24" Height="24" 
                                       Foreground="{StaticResource Icon.SecondaryBlue}" Margin="0,0,12,0"/>
            <TextBlock Text="Proxy Settings" FontSize="20" FontWeight="Bold" 
                      Foreground="{StaticResource Icon.SecondaryBlue}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    
    <DataTemplate x:Key="Template.SectionHeader.Data">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <iconPacks:PackIconBoxIcons Kind="RegularData" Width="24" Height="24" 
                                       Foreground="{StaticResource Icon.SecondaryBlue}" Margin="0,0,12,0"/>
            <TextBlock Text="Data Settings" FontSize="20" FontWeight="Bold" 
                      Foreground="{StaticResource Icon.SecondaryBlue}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>