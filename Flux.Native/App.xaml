<Application x:Class="Flux.Native.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Flux.Native"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Flux.Native.Converters"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Application.Resources>
        <ResourceDictionary>
            <!-- FLUENT DESIGN SYSTEM COLORS - Performance Optimized -->
            <SolidColorBrush x:Key="ThemeMain" Color="#2563EB" po:Freeze="True" />
            <SolidColorBrush x:Key="BackgroundMain" Color="#F8FAFC" po:Freeze="True" />
            <SolidColorBrush x:Key="BackgroundSecondary" Color="#EEF2F7" po:Freeze="True" />
            <SolidColorBrush x:Key="BackgroundInput" Color="#FFFFFF" po:Freeze="True" />
            <SolidColorBrush x:Key="ForegroundMain" Color="#0F172A" po:Freeze="True" />
            <SolidColorBrush x:Key="ForegroundInput" Color="#0F172A" po:Freeze="True" />
            <SolidColorBrush x:Key="ForegroundGood" Color="#10B981" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundBad" Color="#EF4444" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundCustom" Color="#F97316" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundRetry" Color="#EAB308" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundBanned" Color="#8B5CF6" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundToCheck" Color="#14B8A6" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundMenuSelected" Color="#2563EB" po:Freeze="True"/>
            <SolidColorBrush x:Key="Headers" Color="#0F172A" po:Freeze="True" />

            <!-- BoolToTextWrappingConverter -->
            <converters:BoolToTextWrappingConverter x:Key="BoolToWrap" />

            <!-- PERFORMANCE-OPTIMIZED BUTTON COLORS -->
            <SolidColorBrush x:Key="SuccessButton" Color="#10B981" po:Freeze="True"/>
            <SolidColorBrush x:Key="PrimaryButton" Color="#2563EB" po:Freeze="True"/>
            <SolidColorBrush x:Key="WarningButton" Color="#F59E0B" po:Freeze="True"/>
            <SolidColorBrush x:Key="DangerButton" Color="#EF4444" po:Freeze="True"/>
            <SolidColorBrush x:Key="ForegroundButton" Color="#0F172A" po:Freeze="True"/>
            <SolidColorBrush x:Key="BackgroundButton" Color="#E2E8F0" po:Freeze="True"/>

            <!-- Shadow effects removed for modern flat design -->

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                <ResourceDictionary Source="/Styles/ModernTheme.xaml" />
                <ResourceDictionary Source="/Views/Pages/Shared/DebuggerStyles.xaml" />

                <ResourceDictionary Source="/Styles/AppStyles.xaml" />
                <ResourceDictionary Source="/Styles/ListViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

