<UserControl x:Class="Flux.Native.Views.Dialogs.Job.Components.ConfigSelectionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Border Style="{StaticResource SectionCard}" Margin="0,0,8,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ContentControl Style="{StaticResource Icon.Size16}"
                                Content="{StaticResource Icon.Tune}"
                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                VerticalAlignment="Center"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Configuration" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Pick the config to run and tweak how the job behaves."
                               FontSize="10"
                               Foreground="#CCFFFFFF"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Config Display -->
            <Border Background="#1C2030" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                    BorderBrush="#22FFFFFF" BorderThickness="1"
                    Visibility="{Binding IsConfigSelected, Converter={StaticResource ResourceKey=BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding ConfigIcon}" Width="28" Height="28" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConfigNameAndAuthor}" 
                              FontSize="11" Foreground="White" VerticalAlignment="Center"
                              TextWrapping="Wrap"/>
                </Grid>
            </Border>
            
            <Button Click="SelectConfig" HorizontalAlignment="Left"
                    Style="{StaticResource StyledPrimaryButton}" Padding="10,5" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource Icon.FolderOpen}" Width="12" Height="12"/>
                    <TextBlock Text="Select Config" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
            <!-- Execution Settings -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Bots" Style="{StaticResource SecondaryLabelStyle}"/>
                    <mah:NumericUpDown Minimum="1" Maximum="{Binding BotLimit}" Interval="1"
                                       Value="{Binding Bots, Mode=TwoWay}" Width="90" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Skip" Style="{StaticResource SecondaryLabelStyle}"/>
                    <mah:NumericUpDown Minimum="0" Maximum="2147483647" Interval="1"
                                       Value="{Binding Skip, Mode=TwoWay}" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Proxy Mode" Style="{StaticResource SecondaryLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ProxyModes}" SelectedValue="{Binding ProxyMode}" 
                              MinWidth="160" HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="No Valid Proxy Behaviour" Style="{StaticResource SecondaryLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding NoValidProxyBehaviours}" 
                              SelectedValue="{Binding NoValidProxyBehaviour}"
                              MinWidth="160" HorizontalAlignment="Left" Style="{StaticResource CleanComboBox}"/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Reload Interval (sec, 0 = disabled)" Style="{StaticResource SecondaryLabelStyle}"/>
                        <mah:NumericUpDown Minimum="0" Maximum="2147483647" Interval="1"
                                          Value="{Binding PeriodicReloadIntervalSeconds}" Width="120" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Proxy Ban Time (sec)" Style="{StaticResource SecondaryLabelStyle}"/>
                        <mah:NumericUpDown Minimum="0" Maximum="2147483647" Interval="1"
                                          Value="{Binding ProxyBanTimeSeconds}" Width="120" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Proxy Behavior Settings -->
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Proxy Options" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,4"/>
                <WrapPanel>
                    <CheckBox Content="Shuffle proxies" IsChecked="{Binding ShuffleProxies}" 
                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                    <CheckBox Content="Never ban proxies" IsChecked="{Binding NeverBanProxies}" 
                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                    <CheckBox Content="Concurrent mode (rotating services)" 
                              IsChecked="{Binding ConcurrentProxyMode}" 
                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                    <CheckBox Content="Mark lines as ToCheck on abort" 
                              IsChecked="{Binding MarkAsToCheckOnAbort}" 
                              Foreground="White" FontSize="10" Margin="0,0,12,6"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="Automation" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,4"/>
                <CheckBox Content="CPM trigger (Ctrl+Alt+Shift+Y modem refresh)"
                          IsChecked="{Binding CpmTriggerEnabled}"
                          Foreground="White" FontSize="10" Margin="0,0,12,2"/>
                <TextBlock Text="Starts 1 minute after the job runs. If CPM drops below 5000, triggers the modem refresh. Cooldown is 1 minute, retry every 5 seconds."
                           FontSize="9" Foreground="#99FFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
