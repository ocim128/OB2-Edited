<Page x:Class="OpenBullet2.Native.Views.Pages.Tools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Tools"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent" Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource ModernScrollViewer}"
                      CanContentScroll="False">
            <DockPanel LastChildFill="True">
                <Border Style="{StaticResource ModernCardLite}"
                        Background="#C0353535"
                        Margin="0,0,0,20"
                        Padding="16"
                        DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Toolbox" 
                                                   Width="24" 
                                                   Height="24" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Foreground="{StaticResource Modern.ThemeMain}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Automation Toolkit"
                                       Style="{StaticResource H3TextStyle}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Quick automation suite for power users"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel ItemWidth="400" Margin="0" Orientation="Horizontal">
                    <Border Style="{StaticResource ModernCardLite}"
                            Background="#B0282828"
                            Padding="20"
                            Margin="0,0,16,16"
                            Width="400">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="RouterWireless" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#60A5FA"/>
                                <TextBlock Text="Modem IP Refresher"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Trigger a fresh WAN lease by logging in, toggling networks, and reviewing real-time feedback."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Router Address"
                                               Style="{StaticResource BodyTextStyle}"
                                               Grid.Row="0"/>
                                    <TextBox x:Name="ModemAddressTextBox"
                                             Grid.Row="1"
                                             Style="{StaticResource MatchingTextBox}"
                                             Text="http://192.168.0.1"
                                             AutomationProperties.Name="Router address"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Username"
                                               Style="{StaticResource BodyTextStyle}"
                                               Grid.Row="0"/>
                                    <TextBox x:Name="ModemUsernameTextBox"
                                             Grid.Row="1"
                                             Style="{StaticResource MatchingTextBox}"
                                             Text="admin"
                                             AutomationProperties.Name="Router username"/>
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Password"
                                               Style="{StaticResource BodyTextStyle}"
                                               Grid.Row="0"/>
                                    <PasswordBox x:Name="ModemPasswordBox"
                                                 Grid.Row="1"
                                                 Height="34"
                                                 Padding="8,0,8,0"
                                                 AutomationProperties.Name="Router password"/>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearModemLogButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear Log"
                                        Width="100"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Click="ClearModemLog"
                                        AutomationProperties.Name="Clear modem log"/>
                                <Button x:Name="RefreshModemIpButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Refresh IP"
                                        Width="110"
                                        Grid.Column="1"
                                        Click="RefreshModemIp"
                                        AutomationProperties.Name="Refresh modem IP"/>
                            </Grid>

                            <Border x:Name="ModemStatusBorder"
                                    Background="#1E3A8A"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ModemStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#BFDBFE"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <TextBox x:Name="ModemLogTextBox"
                                         Style="{StaticResource MatchingTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         Height="180"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Modem log output"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardLite}"
                            Background="#B0282828"
                            Padding="20"
                            Margin="0,0,16,16"
                            Width="400">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="ShieldKey" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#34D399"/>
                                <TextBlock Text="OTP Toolkit"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Drop in a Base32 secret and stay synced with rolling 30-second codes."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBox x:Name="SecretKeyTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     Margin="0,0,0,10"
                                     AutomationProperties.Name="Secret key"
                                     ToolTip="Enter a Base32 encoded secret key"
                                     TextChanged="SecretKeyTextChanged"
                                     CharacterCasing="Upper"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="False"
                                     VerticalContentAlignment="Center"
                                     Height="34"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearSecretButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear"
                                        Width="80"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Click="ClearSecret"
                                        AutomationProperties.Name="Clear secret"
                                        ToolTip="Clear the current secret"/>
                                <Button x:Name="PasteSecretButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Paste"
                                        Width="80"
                                        Grid.Column="1"
                                        Click="PasteSecret"
                                        AutomationProperties.Name="Paste secret"
                                        ToolTip="Paste a secret from the clipboard"/>
                            </Grid>

                            <Border x:Name="SecretErrorBorder"
                                    Background="#7F1D1D"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="SecretErrorTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#FCA5A5"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Current OTP"
                                               Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock x:Name="OtpTextBlock"
                                               Grid.Row="1"
                                               Text="------"
                                               FontSize="36"
                                               FontFamily="Segoe UI Semibold"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,6"
                                               AutomationProperties.Name="One-time password"/>
                                    <ProgressBar x:Name="OtpProgressBar"
                                                 Grid.Row="2"
                                                 Height="6"
                                                 Minimum="0"
                                                 Maximum="30"
                                                 Value="0"
                                                 AutomationProperties.Name="OTP progress"/>
                                    <Grid Grid.Row="3" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OtpStatusTextBlock"
                                                   Style="{StaticResource CaptionTextStyle}"/>
                                        <Button x:Name="CopyOtpButton"
                                                Grid.Column="1"
                                                Style="{StaticResource StyledSuccessButton}"
                                                Content="Copy"
                                                Width="70"
                                                Margin="12,0,0,0"
                                                Click="CopyOtp"
                                                AutomationProperties.Name="Copy OTP button"
                                                ToolTip="Copy the current OTP to the clipboard"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardLite}"
                            Background="#B0282828"
                            Padding="20"
                            Margin="0,0,16,16"
                            Width="400">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Bookmark" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#F59E0B"/>
                                <TextBlock Text="Bookmarklet Parser"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Paste bookmarklet dumps; we strip comments and surface the useful payload."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBox x:Name="BookmarkletInputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     Height="120"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Bookmarklet input"
                                     KeyDown="BookmarkletInputKeyDown"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="ClearBookmarkletButton"
                                            Style="{StaticResource StyledWarningButton}"
                                            Content="Clear"
                                            Width="80"
                                            Click="ClearBookmarklet"
                                            AutomationProperties.Name="Clear bookmarklet input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="ParseBookmarkletButton"
                                            Style="{StaticResource StyledPrimaryButton}"
                                            Content="Parse"
                                            Width="80"
                                            Margin="0,0,8,0"
                                            Click="ParseBookmarklet"
                                            AutomationProperties.Name="Parse bookmarklet"/>
                                    <Button x:Name="CopyBookmarkletButton"
                                            Style="{StaticResource StyledSuccessButton}"
                                            Content="Copy"
                                            Width="80"
                                            Click="CopyBookmarkletOutput"
                                            AutomationProperties.Name="Copy bookmarklet output"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="BookmarkletStatusBorder"
                                    Background="#065F46"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,10,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="BookmarkletStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#A7F3D0"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBox x:Name="BookmarkletOutputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Bookmarklet output"
                                     Cursor="IBeam"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardLite}"
                            Background="#B0282828"
                            Padding="20"
                            Margin="0,0,16,16"
                            Width="400">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="TextBoxRemove" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#A78BFA"/>
                                <TextBlock Text="Text Cleaner"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Normalize chaotic dumps, compress whitespace, and rank by ♦ markers instantly."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBox x:Name="TextCleanerInputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Text cleaner input"
                                     KeyDown="TextCleanerInputKeyDown"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="ClearTextCleanerButton"
                                            Style="{StaticResource StyledWarningButton}"
                                            Content="Clear"
                                            Width="80"
                                            Click="ClearTextCleaner"
                                            AutomationProperties.Name="Clear text cleaner"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CleanTextButton"
                                            Style="{StaticResource StyledPrimaryButton}"
                                            Content="Clean"
                                            Width="80"
                                            Margin="0,0,8,0"
                                            Click="CleanTextInput"
                                            AutomationProperties.Name="Clean text"/>
                                    <Button x:Name="CopyTextCleanerButton"
                                            Style="{StaticResource StyledSuccessButton}"
                                            Content="Copy"
                                            Width="80"
                                            Click="CopyTextCleanerOutput"
                                            AutomationProperties.Name="Copy text cleaner output"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="TextCleanerStatusBorder"
                                    Background="#065F46"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,10,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TextCleanerStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#A7F3D0"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBox x:Name="TextCleanerOutputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Text cleaner output"
                                     Cursor="IBeam"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModernCardLite}"
                            Background="#B0282828"
                            Padding="20"
                            Margin="0,0,16,16"
                            Width="400">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="FolderZip" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#FB923C"/>
                                <TextBlock Text="Firefox Switcher"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Quickly switch between Firefox profiles or launch new instances with different configurations."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearZipOptionsButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear"
                                        Width="80"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Click="ClearZipOptions"
                                        AutomationProperties.Name="Clear zip options"/>
                                <Button x:Name="LoadZipOptionsButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Load .zip"
                                        Width="100"
                                        Grid.Column="1"
                                        Click="SelectZipForOptions"
                                        AutomationProperties.Name="Load zip archive"/>
                            </Grid>

                            <Border Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Selected Archive"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="#94A3B8"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ZipOptionFileTextBlock"
                                               Text="No file loaded"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="#E2E8F0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ZipOptionStatusBorder"
                                    Background="#1E3A8A"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ZipOptionStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#BFDBFE"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    MinHeight="160">
                                <ListBox x:Name="ZipOptionListBox"
                                         Foreground="#F5F5F5"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="#2A2A2A"
                                                        BorderBrush="#404040"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,8"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               Foreground="#E2E8F0"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource StyledPrimaryButton}"
                                                        Width="40"
                                                        Height="34"
                                                        Padding="4"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding}"
                                                        Click="CopyZipOptionName"
                                                        ToolTip="Copy folder name">
                                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18"/>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource StyledSuccessButton}"
                                                        Width="44"
                                                        Height="34"
                                                        Padding="4"
                                                        Tag="{Binding}"
                                                        Click="LaunchZipOption"
                                                        ToolTip="Launch Firefox profile">
                                                    <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardLite}"
                            Background="#B0282828"
                            Padding="20"
                            Margin="0,0,16,16"
                            Width="400">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Speedometer" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#EC4899"/>
                                <TextBlock Text="Performance Benchmark"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Test application performance and monitor system resources in real-time."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Memory Usage:"
                                           Style="{StaticResource BodyTextStyle}"
                                           Grid.Row="0"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="MemoryUsageTextBlock"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#60A5FA"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="MemoryUsageValue"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="#E2E8F0"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                                
                                <TextBlock Text="CPU Usage:"
                                           Style="{StaticResource BodyTextStyle}"
                                           Grid.Row="1"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="CpuUsageTextBlock"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#34D399"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="CpuUsageValue"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="#E2E8F0"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                                
                                <TextBlock Text="System Status:"
                                           Style="{StaticResource BodyTextStyle}"
                                           Grid.Row="2"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="SystemStatusTextBlock"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#34D399"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="SystemStatusValue"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="#E2E8F0"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearBenchmarkButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear Stats"
                                        Width="100"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Click="ClearBenchmarkStats"
                                        AutomationProperties.Name="Clear benchmark statistics"/>
                                <Button x:Name="RunBenchmarkButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Run Test"
                                        Width="100"
                                        Grid.Column="1"
                                        Click="RunPerformanceBenchmark"
                                        AutomationProperties.Name="Run performance benchmark"/>
                            </Grid>

                            <Border x:Name="BenchmarkStatusBorder"
                                    Background="#065F46"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="BenchmarkStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#A7F3D0"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    MinHeight="120">
                                <TextBox x:Name="BenchmarkOutputTextBox"
                                         Style="{StaticResource MatchingTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         Height="120"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Benchmark output"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </ScrollViewer>
    </Grid>
</Page>
