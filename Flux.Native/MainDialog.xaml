<mah:MetroWindow x:Class="Flux.Native.MainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flux.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="MainDialog" Height="300" Width="300"
        Background="{DynamicResource BackgroundMain}"
        SizeToContent="Width"
        ResizeMode="NoResize"
        BorderThickness="0"
        GlowBrush="Black"
        WindowTitleBrush="{DynamicResource BackgroundSecondary}"
        WindowTransitionsEnabled="False"
        TitleCharacterCasing="Normal"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MinHeight="320">
    <Grid>
        
    </Grid>
</mah:MetroWindow>
