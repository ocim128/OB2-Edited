<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>logo.ico</ApplicationIcon>
        <DebugType>portable</DebugType>
        <!-- Memory-Efficient Build Settings -->
        <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <WarningLevel>0</WarningLevel>
        <NoWarn>CS8618;CS8600;CS8602;CS8604;CS8625;CS8622;CS8601;CS8603;CS0618;SYSLIB0039;CA1416</NoWarn>
        <!-- Balanced Performance Settings - Low Memory Impact -->
        <UseSharedCompilation>true</UseSharedCompilation>
        <BuildInParallel>true</BuildInParallel>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <!-- Fast Build Optimizations -->
        <UseIncrementalCompilation>true</UseIncrementalCompilation>
        <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
        <Deterministic>false</Deterministic>
        <UseRidGraph>false</UseRidGraph>
        <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
        <!-- Runtime Optimizations - Memory Conservative -->
        <TieredCompilation>true</TieredCompilation>
        <TieredPGO>true</TieredPGO>
        <ReadyToRun>false</ReadyToRun>
        <!-- Memory and Binary Size Optimizations -->
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
        <!-- Skip unnecessary analysis -->
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <AnalysisLevel>none</AnalysisLevel>
        <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
        <!-- Additional Build Optimizations -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
        <!-- XAML Build Optimizations -->
        <XamlDebuggingInformation>false</XamlDebuggingInformation>
        <SkipMarkupCompilation>false</SkipMarkupCompilation>
        <UseWPF>true</UseWPF>
        <GenerateTemporaryTargetAssembly>false</GenerateTemporaryTargetAssembly>
        <!-- Garbage Collection Settings for Lower Memory -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>
    <!-- Configuration-specific optimizations -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'testing'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <!-- Prevent creating target framework folder in output -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <!-- Essential Content Files -->
    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="ui-sound.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Sounds\hit.wav">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="user-agents.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Images\logohq.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Images\logohq_square_padded.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Images\logohq_square_padded_bg.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="logo.ico">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <!-- Core Dependencies Only -->
    <ItemGroup>
        <PackageReference Include="AvalonEdit"
                          Version="6.3.0.90" />
        <PackageReference Include="HtmlSanitizer"
                          Version="8.1.866-beta" />
        <PackageReference Include="MahApps.Metro"
                          Version="2.4.10" />
        <!-- Essential Icon Packs Only - Reduced to actually used ones -->
        <PackageReference Include="MahApps.Metro.IconPacks.Material"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.MaterialDesign"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.FontAwesome"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Entypo"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.RemixIcon"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Unicons"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Octicons"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.BoxIcons"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.RadixIcons"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.ForkAwesome"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Modern"
                          Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Microns"
                          Version="4.8.0" />
        <!-- Removed unused icon packs to reduce build size:
             - BootstrapIcons (only used in About.xaml - can be replaced)
             - SimpleIcons (only used in About.xaml - can be replaced) -->
        <PackageReference Include="MahApps.Metro.SimpleChildWindow"
                          Version="2.2.1" />
        <PackageReference Include="Markdig"
                          Version="0.37.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore"
                          Version="8.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                          Version="8.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"
                          Version="8.0.8" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"
                          Version="8.0.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                          Version="8.0.0" />
        <PackageReference Include="WpfAnimatedGif"
                          Version="2.0.2" />
        <PackageReference Include="SixLabors.ImageSharp"
                          Version="3.1.11" />
        <PackageReference Include="Microsoft.Playwright"
                          Version="1.40.0" />
    </ItemGroup>
    <!-- Project References -->
    <ItemGroup>
        <ProjectReference Include="..\OpenBullet2.Core\OpenBullet2.Core.csproj" />
    </ItemGroup>
    <!-- Syntax Highlighting Files -->
    <ItemGroup>
        <None Update="Highlighting\CSharp.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Highlighting\JavaScript.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Highlighting\LoliCode.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="Highlighting\MarkDown.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Highlighting\Python.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="version.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="dbip-country-lite.mmdb">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!-- Exclude oldfiles folder and other unnecessary files from build -->
    <ItemGroup>
        <Compile Remove="oldfiles\**" />
        <EmbeddedResource Remove="oldfiles\**" />
        <None Remove="oldfiles\**" />
        <Page Remove="oldfiles\**" />
        <Content Remove="oldfiles\**" />
        <!-- Exclude documentation files from build -->
        <None Remove="*.md" />
        <Content Remove="*.md" />
        <!-- Exclude temporary and log files -->
        <None Remove="crash.log" />
        <None Remove="*.log" />
        <None Remove="*.tmp" />
    </ItemGroup>
</Project>