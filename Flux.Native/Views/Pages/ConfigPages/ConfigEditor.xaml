<Page x:Class="Flux.Native.Views.Pages.Configs.ConfigEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Editor">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Simplified Button Style -->
        <Style x:Key="ConsistentButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Content}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="EditorColumn" Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition x:Name="DebuggerColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Frame x:Name="editorFrame" Grid.Row="0" NavigationUIVisibility="Hidden" />

            <DockPanel x:Name="StackerControlsPanel" Grid.Row="1" Height="32" HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed">
                <Button Click="OpenStacker"
                    x:Name="stackerButton"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource ConsistentButton}"
                    Background="{DynamicResource Modern.ThemeMain}" Foreground="{DynamicResource Modern.TextOnAccent}"
                    Content="Stacker" Padding="12,6">
                    <Button.Tag>
                        <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid" Width="14" Height="14" Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Button.Tag>
                </Button>
                <Button Click="OpenLoliCode"
                    x:Name="loliCodeButton"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource ConsistentButton}"
                    Background="{DynamicResource Modern.Success}" Foreground="{DynamicResource Modern.TextOnAccent}"
                    Content="LoliCode" Padding="12,6">
                    <Button.Tag>
                        <iconPacks:PackIconEntypo Kind="Code" Width="14" Height="14" Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Button.Tag>
                </Button>
                <Button Click="OpenCSharpCode"
                    x:Name="cSharpButton"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource ConsistentButton}"
                    Background="{DynamicResource Modern.ThemeAccent}" Foreground="{DynamicResource Modern.TextOnAccent}"
                    Content="C#" Padding="12,6">
                    <Button.Tag>
                        <iconPacks:PackIconEntypo Kind="Code" Width="14" Height="14" Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Button.Tag>
                </Button>
                <Button Click="Save" 
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource ConsistentButton}"
                    Background="{DynamicResource Modern.Error}" Foreground="{DynamicResource Modern.TextOnAccent}"
                    Content="Save" Padding="12,6">
                    <Button.Tag>
                        <iconPacks:PackIconRemixIcon Kind="Save3Fill" Width="14" Height="14" Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Button.Tag>
                </Button>
            </DockPanel>
        </Grid>

        <GridSplitter
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Grid.Column="1"
            Width="4"
            VerticalAlignment="Stretch"
            Background="{DynamicResource Modern.BorderMain}"
            Margin="1,8">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource Modern.BorderSecondary}"
                            CornerRadius="2">
                        <Rectangle Fill="Transparent" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Frame x:Name="debuggerFrame" 
               NavigationUIVisibility="Hidden"
               Grid.Column="2" />
    </Grid>
</Page>

