<Page x:Class="OpenBullet2.Native.Views.Dialogs.AddBlockDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Dialogs"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:trees="clr-namespace:RuriLib.Models.Trees;assembly=RuriLib"
      xmlns:blocks="clr-namespace:RuriLib.Models.Blocks;assembly=RuriLib"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="610"
      Title="AddBlockDialog">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <!-- Modern Dark Container -->
    <Border Background="#FF1E1E1E" CornerRadius="12" Padding="20">
        <Grid MinHeight="520" Width="720" MaxHeight="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Modern Header -->
            <TextBlock Grid.Row="0" 
                       Text="Add Block" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Search Controls -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!-- Enhanced Back Button -->
                <Button Click="GoUp"
                        Grid.Column="0"
                        Width="45" Height="45"
                        Margin="0,0,15,0"
                        Visibility="{Binding CanGoUp, Converter={StaticResource ResourceKey=BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                                Background="#FF3A82F7"
                                                CornerRadius="8"
                                                BorderBrush="#FF5A9DF9"
                                                BorderThickness="2">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF5A9DF9"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7DB8FA"/>
                                                <Setter TargetName="border" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF2563EB"/>
                                                <Setter TargetName="border" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ContentControl Content="{StaticResource Icon.AngleUp}" Width="24" Height="24" Foreground="White" />
                </Button>

                <!-- Modern Search Box -->
                <Border Grid.Column="1" 
                        Background="#FF2A2A2A" 
                        CornerRadius="8" 
                        BorderBrush="#FF404040" 
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{StaticResource Icon.SearchMD}" 
                                       Grid.Column="0"
                                       Width="16" Height="16" 
                                       Foreground="#FF888888" 
                                       Margin="12,0,8,0"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="filterTextBox"
                                 Grid.Column="1"
                                 KeyDown="FilterKeyDown"
                                 TextChanged="FilterTextChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFF"
                                 FontSize="14"
                                 Padding="0,12"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Enhanced Search Button -->
                <Button Click="Search"
                        Grid.Column="2"
                        Width="45" Height="45"
                        Margin="15,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                                Background="#FF10B981"
                                                CornerRadius="8"
                                                BorderBrush="#FF34D399"
                                                BorderThickness="2">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF34D399"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6EE7B7"/>
                                                <Setter TargetName="border" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF059669"/>
                                                <Setter TargetName="border" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ContentControl Content="{StaticResource Icon.SearchMD}" Width="24" Height="24" Foreground="White" />
                </Button>
            </Grid>

            <!-- Blocks Container with Modern Styling -->
            <Border Grid.Row="2" 
                    Background="#FF252525" 
                    CornerRadius="8" 
                    Padding="20"
                    Margin="0,20,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NodesCollection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                        <!-- Category Button Template -->
                        <DataTemplate DataType="{x:Type trees:CategoryTreeNode}">
                            <Button Background="{Binding Category.BackgroundColor}"
                                    Width="150"
                                    Height="70"
                                    Margin="8"
                                    Tag="{Binding}"
                                    Click="SelectCategory"
                                    BorderThickness="0"
                                    Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            BorderThickness="0">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" 
                                                                              Direction="270" 
                                                                              ShadowDepth="2" 
                                                                              BlurRadius="4" 
                                                                              Opacity="0.3"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Category.ForegroundColor}"
                                           Text="{Binding Category.Name}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Button>
                        </DataTemplate>
                        
                        <!-- Block Button Template -->
                        <DataTemplate DataType="{x:Type blocks:BlockDescriptor}">
                            <Button Background="{Binding Category.BackgroundColor}"
                                    Width="150"
                                    Height="70"
                                    Margin="8"
                                    Tag="{Binding}"
                                    Click="SelectDescriptor"
                                    BorderThickness="0"
                                    Padding="6">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            BorderThickness="0">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" 
                                                                              Direction="270" 
                                                                              ShadowDepth="2" 
                                                                              BlurRadius="4" 
                                                                              Opacity="0.3"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock MouseDown="SelectDescriptor"
                                               Grid.Row="0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{Binding Category.ForegroundColor}"
                                               Text="{Binding Name}"
                                               Tag="{Binding}"
                                               TextWrapping="Wrap" />

                                    <TextBlock MouseDown="SelectDescriptor"
                                               Grid.Row="1"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{Binding Category.ForegroundColor}"
                                               Text="{Binding Description}"
                                               Tag="{Binding}"
                                               TextWrapping="Wrap"
                                               Opacity="0.9"
                                               Margin="0,2,0,0" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Recently Used Blocks Header -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,10">
                <ContentControl Content="{StaticResource Icon.History}" 
                               Width="20" Height="20" 
                               Foreground="#FF1E90FF" 
                               VerticalAlignment="Center"/>
                <TextBlock Text="Recently Used Blocks" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="#FFFFFF"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Recently Used Blocks Container -->
            <Border Grid.Row="4" 
                    Background="#FF252525" 
                    CornerRadius="8" 
                    Padding="15"
                    MaxHeight="120">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentDescriptors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type blocks:BlockDescriptor}">
                                <Button Background="{Binding Category.BackgroundColor}"
                                        Width="120"
                                        Height="65"
                                        Margin="0,0,10,0"
                                        Tag="{Binding}"
                                        Click="SelectDescriptor"
                                        BorderThickness="0"
                                        Padding="4">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                BorderThickness="0">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="Black" 
                                                                                  Direction="270" 
                                                                                  ShadowDepth="1" 
                                                                                  BlurRadius="3" 
                                                                                  Opacity="0.2"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock MouseDown="SelectDescriptor"
                                                   Grid.Row="0"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="{Binding Category.ForegroundColor}"
                                                   Text="{Binding Name}"
                                                   Tag="{Binding}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock MouseDown="SelectDescriptor"
                                                   Grid.Row="1"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="{Binding Category.ForegroundColor}"
                                                   Text="{Binding Description}"
                                                   Tag="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.8"
                                                   Margin="0,1,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
    
</Page>
