<Page x:Class="Flux.Native.Views.Pages.Data.Hits"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="Hits">

    <Page.Resources>
        <ContextMenu x:Key="ItemContextMenu" Style="{StaticResource {x:Type ContextMenu}}">
            <MenuItem x:Name="copyMenu" Header="Copy Selected">
                <MenuItem Header="Data" Click="CopySelected"/>
                <MenuItem Header="Proxy" Click="CopySelectedProxies"/>
                <MenuItem Header="Data with Capture" Click="CopySelectedWithCapture"/>
                <MenuItem Header="Data (Full)" Click="CopySelectedFull"/>
                <MenuItem Header="Custom"></MenuItem>
            </MenuItem>
            <MenuItem x:Name="saveMenu" Header="Save Selected">
                <MenuItem Header="Data" Click="SaveSelected"/>
                <MenuItem Header="Data with Capture" Click="SaveSelectedWithCapture"/>
                <MenuItem Header="Data (Full)" Click="SaveSelectedFull"/>
                <MenuItem Header="Custom"></MenuItem>
            </MenuItem>
            <MenuItem Header="Select All" Click="SelectAll"/>
            <MenuItem Header="Send to Recheck" Click="SendToRecheck"/>
        </ContextMenu>
    </Page.Resources>
    
    <Grid Background="Transparent" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Modern.BackgroundSecondary}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Action buttons + stats -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Click="DeleteSelected" Margin="0,4,5,0" Style="{StaticResource StyledDangerButton}" >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="DeleteDuplicates" Margin="0,4,5,0" Style="{StaticResource StyledDangerButton}" >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">Delete Duplicates</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="Purge" Margin="0,4,5,0" Style="{StaticResource StyledDangerButton}" ToolTip="Deletes all hits from the database">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">Purge</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Total hits:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource ForegroundMain}" />
                    <TextBlock Text="{Binding Total}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundMain}" />
                </StackPanel>

                <!-- Row 1: Filters -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <TextBox x:Name="searchTextbox" Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" Width="150" Style="{StaticResource MatchingTextBox}" ToolTip="Search in captured data"/>
                    <ComboBox ItemsSource="{Binding ConfigNames}" SelectedItem="{Binding ConfigFilter}" Margin="0,0,5,0" Width="150" Style="{StaticResource CleanComboBox}" ToolTip="Filter by config"/>
                    <ComboBox ItemsSource="{Binding HitTypes}" SelectedItem="{Binding TypeFilter}" Margin="0,0,5,0" Width="120" Style="{StaticResource CleanComboBox}" ToolTip="Filter by hit type"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Optimized ListView with enhanced virtualization -->
        <ListView
            x:Name="hitsListView"
            Grid.Row="1"
            Foreground="{DynamicResource ForegroundMain}"
            Background="Transparent"
            ItemsSource="{Binding HitsCollection}"
            SelectionMode="Extended"
            BorderThickness="1"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Item"
            VirtualizingPanel.CacheLengthUnit="Item"
            VirtualizingPanel.CacheLength="50,50"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <!-- Show Headers by overriding the default style -->
            <ListView.Style>
                <Style TargetType="{x:Type ListView}" />
            </ListView.Style>

            <!-- Align Headers to the Left -->
            <ListView.Resources>
                <Style x:Key="GridViewColumnHeaderGripper" TargetType="Thumb">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStopCollection>
                                        <GradientStop Color="{DynamicResource BorderLightColor}" Offset="0.0" />
                                        <GradientStop Color="{DynamicResource BorderDarkColor}" Offset="1.0" />
                                    </GradientStopCollection>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <Rectangle HorizontalAlignment="Center" Width="1" Fill="{TemplateBinding Background}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="{DynamicResource BorderLightColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource BorderDarkColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                <Grid>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Modern.BorderSecondary}" Background="Transparent">
                                        <TextBlock x:Name="ContentHeader" Text="{TemplateBinding Content}" Padding="5,5,5,0" Width="{TemplateBinding Width}" TextAlignment="Left" />
                                    </Border>
                                    <Thumb x:Name="PART_HeaderGripper"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,-9,0"
                                         Style="{StaticResource GridViewColumnHeaderGripper}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <Style TargetType="{x:Type ListViewItem}">
                    <EventSetter Event="MouseRightButtonDown" Handler="LVIMouseRightButtonDown" />
                    <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="Bd" BorderBrush="{DynamicResource Modern.BorderSecondary}" 
                                    BorderThickness="0,0,0,1" 
                                    Background="{TemplateBinding Background}" 
                                    Padding="6,8"
                                    SnapsToDevicePixels="true">
                                    <GridViewRowPresenter 
                                        HorizontalAlignment="Left" 
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Modern.BackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Modern.ThemeMain}" />
                            <Setter Property="Foreground" Value="{DynamicResource Modern.TextOnAccent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Modern.ThemeSecondary}" />
                        </MultiTrigger>
                        <EventTrigger RoutedEvent="MouseRightButtonDown">
                            <EventTrigger.Actions>

                            </EventTrigger.Actions>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>

            </ListView.Resources>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel>
                    </VirtualizingStackPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding Data}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Data" Click="ColumnHeaderClicked">Data</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding Type}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Type" Click="ColumnHeaderClicked">Type</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding ConfigName}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="ConfigName" Click="ColumnHeaderClicked">Config</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="90" DisplayMemberBinding="{Binding Date}" >
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Date" Click="ColumnHeaderClicked">Date</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding WordlistName}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="WordlistName" Click="ColumnHeaderClicked">Wordlist</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding Proxy}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Proxy" Click="ColumnHeaderClicked">Proxy</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding CapturedDataString}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="CapturedDataString" Click="ColumnHeaderClicked">Captured Data</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{DynamicResource BackgroundSecondary}" />
    </Grid>
</Page>

