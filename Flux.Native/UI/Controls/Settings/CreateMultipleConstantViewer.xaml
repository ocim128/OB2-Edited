<UserControl x:Class="Flux.Native.Controls.CreateMultipleConstantViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">



    <Grid>
        <!-- Variables List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,4,0,0">
            <StackPanel x:Name="VariablesPanel"
                        Orientation="Vertical"
                        Margin="0,0,0,8"/>
        </ScrollViewer>

        <!-- Modern Notification Popup Overlay (Ctrl+Alt+Q Plugin Style) -->
        <Border x:Name="NotificationOverlay"
                Background="Transparent"
                Visibility="Collapsed"
                MouseDown="CloseNotification_Click">
            <Border x:Name="NotificationWindow"
                    Style="{StaticResource ModernNotificationWindow}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <Path x:Name="NotificationIcon"
                          Grid.Column="0"
                          Style="{StaticResource NotificationIconStyle}"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                          Fill="#81C784"/>
                    
                    <!-- Text Panel -->
                    <StackPanel Grid.Column="1"
                                Margin="5,10,15,10"
                                VerticalAlignment="Center">
                        <!-- Title -->
                        <TextBlock x:Name="NotificationTitle"
                                   Style="{StaticResource NotificationTitleStyle}"
                                   Text="Notification"/>
                        
                        <!-- Message -->
                        <TextBlock x:Name="NotificationMessage"
                                   Style="{StaticResource NotificationMessageStyle}"
                                   Text="Message content"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
