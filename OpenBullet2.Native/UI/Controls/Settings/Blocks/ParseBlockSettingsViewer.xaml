<UserControl x:Class="OpenBullet2.Native.Controls.ParseBlockSettingsViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBullet2.Native.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Padding="10" Background="#AA000000" CornerRadius="8" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0 0 0 8">
                <TextBlock
                    Text="{Binding NameAndId}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#fec34d"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="{Binding Block.Descriptor.Description}"
                    FontSize="11"
                    FontStyle="Italic"
                    Margin="0 2 0 0"
                    Foreground="#888"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="{Binding Block.Descriptor.ExtraInfo}"
                    FontSize="9"
                    FontStyle="Italic"
                    Margin="0 1 0 0"
                    Foreground="#666"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Basic Settings -->
            <Grid Grid.Row="1" Margin="0 0 0 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Label:" 
                          Foreground="#ccc" FontSize="11" 
                          VerticalAlignment="Center" Margin="0 0 4 0"/>
                <TextBox Grid.Column="1" Text="{Binding Label}" 
                        FontSize="11" Padding="4 2" 
                        BorderThickness="0 0 0 1" 
                        BorderBrush="#333" Background="Transparent"
                        Foreground="#fff"/>
            </Grid>

            <!-- Safe Mode -->
            <CheckBox Grid.Row="2" Margin="0 0 0 4"
                     Content="Safe mode"
                     IsChecked="{Binding SafeMode}"
                     FontSize="11"/>

            <!-- Return Value -->
            <Grid Grid.Row="3" Margin="0 0 0 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ReturnValueType}" 
                          Foreground="#ccc" FontSize="11" 
                          VerticalAlignment="Center" Margin="0 0 4 0"/>
                <TextBox Grid.Column="1" Text="{Binding OutputVariable}" 
                        FontSize="11" Padding="4 2"
                        BorderThickness="0 0 0 1" 
                        BorderBrush="#333" Background="Transparent"
                        Foreground="#fff"/>
            </Grid>

            <!-- Checkboxes -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 0 0 6">
                <CheckBox Content="Capture" IsChecked="{Binding IsCapture}" FontSize="11" Margin="0 0 8 0"/>
                <CheckBox Content="Recursive" IsChecked="{Binding Recursive}" FontSize="11"/>
            </StackPanel>

            <!-- Parse Mode Selection -->
            <Border Grid.Row="5" BorderThickness="1" BorderBrush="#40FFFFFF" Margin="0 0 0 6" Padding="6" CornerRadius="4" Background="#20FFFFFF">
                <StackPanel>
                    <TextBlock Text="Parse Mode" Foreground="#fec34d" FontSize="11" FontWeight="SemiBold" Margin="0 0 0 4"/>
                    <UniformGrid Rows="1" Columns="5">
                        <RadioButton Content="LR" x:Name="lrButton" IsChecked="{Binding LRMode}" 
                                    FontSize="11" Foreground="#fff" Margin="2" 
                                    Style="{DynamicResource {x:Type RadioButton}}"/>
                        <RadioButton Content="CSS" x:Name="cssButton" IsChecked="{Binding CSSMode}" 
                                    FontSize="11" Foreground="#fff" Margin="2" 
                                    Style="{DynamicResource {x:Type RadioButton}}"/>
                        <RadioButton Content="XPath" x:Name="xpathButton" IsChecked="{Binding XPathMode}" 
                                    FontSize="11" Foreground="#fff" Margin="2" 
                                    Style="{DynamicResource {x:Type RadioButton}}"/>
                        <RadioButton Content="Json" x:Name="jsonButton" IsChecked="{Binding JsonMode}" 
                                    FontSize="11" Foreground="#fff" Margin="2" 
                                    Style="{DynamicResource {x:Type RadioButton}}"/>
                        <RadioButton Content="Regex" x:Name="regexButton" IsChecked="{Binding RegexMode}" 
                                    FontSize="11" Foreground="#fff" Margin="2" 
                                    Style="{DynamicResource {x:Type RadioButton}}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Settings -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Common Settings -->
                <StackPanel Grid.Row="0" Margin="0 0 0 4">
                    <local:StringSettingViewer x:Name="inputSetting" />
                    <local:StringSettingViewer x:Name="prefixSetting" />
                    <local:StringSettingViewer x:Name="suffixSetting" />
                    <local:BoolSettingViewer x:Name="urlEncodeOutputSetting" />
                </StackPanel>

                <!-- Mode-specific Settings -->
                <Border Grid.Row="1" BorderThickness="0 1 0 0" BorderBrush="#333" Margin="0 4 0 0" Padding="0 4">
                    <TabControl x:Name="tabControl" Background="Transparent" BorderThickness="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="{x:Type TabItem}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>
                        
                        <!-- LR Mode -->
                        <TabItem>
                            <StackPanel>
                                <local:StringSettingViewer x:Name="leftDelimSetting" />
                                <local:StringSettingViewer x:Name="rightDelimSetting" />
                                <local:BoolSettingViewer x:Name="caseSensitiveSetting" />
                            </StackPanel>
                        </TabItem>
                        
                        <!-- CSS Mode -->
                        <TabItem>
                            <StackPanel>
                                <local:StringSettingViewer x:Name="cssSelectorSetting" />
                                <local:StringSettingViewer x:Name="attributeNameSetting" />
                            </StackPanel>
                        </TabItem>
                        
                        <!-- XPath Mode -->
                        <TabItem>
                            <StackPanel>
                                <local:StringSettingViewer x:Name="xPathSetting" />
                            </StackPanel>
                        </TabItem>
                        
                        <!-- Json Mode -->
                        <TabItem>
                            <StackPanel>
                                <local:StringSettingViewer x:Name="jTokenSetting" />
                            </StackPanel>
                        </TabItem>
                        
                        <!-- Regex Mode -->
                        <TabItem>
                            <StackPanel>
                                <local:StringSettingViewer x:Name="patternSetting" />
                                <local:StringSettingViewer x:Name="outputFormatSetting" />
                                <local:BoolSettingViewer x:Name="multiLineSetting" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- Conditional Overrides -->
            <Border Grid.Row="7"
                    Margin="0 10 0 0"
                    Padding="8"
                    BorderThickness="1"
                    BorderBrush="#40FFFFFF"
                    CornerRadius="6"
                    Background="#19000000">
                <StackPanel>
                    <DockPanel Margin="0 0 0 6">
                        <TextBlock Text="Conditional Overrides"
                                   DockPanel.Dock="Left"
                                   Foreground="#fec34d"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Button Content="Add Condition"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ModernButton}"
                                Padding="10 4"
                                Click="AddCondition"/>
                    </DockPanel>
                    <StackPanel x:Name="conditionalCasesPanel"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
