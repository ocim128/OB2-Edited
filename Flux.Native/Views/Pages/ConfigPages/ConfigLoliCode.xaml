<Page x:Class="Flux.Native.Views.Pages.Configs.ConfigLoliCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Pages"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="LoliCode"
      KeyDown="PageKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource Modern.BackgroundTertiary}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
            <Button x:Name="ToggleUsingsButton" Click="ToggleUsings"
                        Style="{StaticResource StyledPrimaryButton}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Toggle usings"
                        AutomationProperties.AutomationId="ConfigToggleUsings">
                <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconRadixIcons Kind="ActivityLog" Width="16" Height="16"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Toggle Usings</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="ToggleStartupButton" Click="ToggleStartup"
                        Style="{StaticResource StyledPrimaryButton}"
                        AutomationProperties.Name="Toggle startup script"
                        AutomationProperties.AutomationId="ConfigToggleStartup">
                <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconRadixIcons Kind="Code" Width="16" Height="16"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Toggle Startup LoliCode</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
        </Border>

        <!-- Modern Using Statements Section -->
        <Border Grid.Row="1"
            x:Name="usingsContainer"
                Height="120"
                Background="{DynamicResource Modern.BackgroundSecondary}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
            Visibility="Collapsed">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Using Statements" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Modern.ThemeMain}" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
            <TextBox x:Name="usingsTextBox"
                         Background="{DynamicResource Modern.BackgroundTertiary}" 
                         Foreground="{DynamicResource Modern.ForegroundMain}" 
                FontFamily="Consolas"
                         FontSize="12"
                Grid.Row="1"
                AcceptsReturn="True"
                VerticalContentAlignment="Top"
                         BorderThickness="0"
                         Padding="8"
                Text="{Binding UsingsString}"
                AutomationProperties.Name="Custom using statements"
                AutomationProperties.AutomationId="ConfigUsings" />
        </Grid>
        </Border>

        <!-- Modern Startup LoliCode Section -->
        <Border Grid.Row="2"
            x:Name="startupEditorContainer"
                Height="220"
                Background="{DynamicResource Modern.BackgroundSecondary}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
            Visibility="Collapsed">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Startup LoliCode" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Modern.ThemeMain}" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{DynamicResource Modern.BackgroundInput}" CornerRadius="6">
                    <avalonEdit:TextEditor x:Name="startupEditor"
                FontFamily="Consolas"
                                           FontSize="11pt"
                Foreground="{DynamicResource Modern.ForegroundMain}"
                                           Background="{DynamicResource Modern.BackgroundInput}"
                LostFocus="EditorLostFocus"
                HorizontalAlignment="Stretch"
                ShowLineNumbers="True"
                WordWrap="{Binding WordWrap}"
                AutomationProperties.Name="Startup LoliCode editor"
                AutomationProperties.AutomationId="ConfigStartupEditor"/>
                </Border>
        </Grid>
        </Border>

        <!-- Modern Main Editor -->
        <Border Grid.Row="3" Background="{DynamicResource Modern.BackgroundSecondary}" CornerRadius="8" Padding="1">
            <avalonEdit:TextEditor x:Name="editor"
            FontFamily="Consolas"
                                   FontSize="11pt"
            Foreground="{DynamicResource Modern.ForegroundMain}"
                                   Background="{DynamicResource Modern.BackgroundInput}"
            LostFocus="EditorLostFocus"
            HorizontalAlignment="Stretch"
            ShowLineNumbers="True"
            WordWrap="{Binding WordWrap}"
            AutomationProperties.Name="Main LoliCode editor"
            AutomationProperties.AutomationId="ConfigMainEditor"/>
        </Border>
    </Grid>
</Page>


