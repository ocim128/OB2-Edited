<UserControl x:Class="OpenBullet2.Native.Controls.ConditionalCaseViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenBullet2.Native.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CaseActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="KeyAddButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0 0 8 8"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource ForegroundMain}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
        <StackPanel>
            <Grid Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="nameTextBox"
                         Grid.Column="0"
                         Margin="0 0 8 0"
                         TextChanged="NameChanged"
                         VerticalAlignment="Center"
                         Style="{StaticResource MatchingTextBox}"
                         ToolTip="Condition name"/>

                <ComboBox x:Name="modeCombo"
                          Grid.Column="1"
                          Width="140"
                          Margin="0 0 8 0"
                          SelectionChanged="ModeChanged"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaseActionButton}"
                            Background="#2563EB"
                            ToolTip="Move condition up"
                            Click="MoveUp">
                        <iconPacks:PackIconMaterial Kind="ChevronUp" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource CaseActionButton}"
                            Background="#2563EB"
                            ToolTip="Move condition down"
                            Click="MoveDown">
                        <iconPacks:PackIconMaterial Kind="ChevronDown" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource CaseActionButton}"
                            Background="#DC2626"
                            ToolTip="Remove this condition"
                            Margin="0"
                            Click="Delete">
                        <iconPacks:PackIconMaterial Kind="Close" Width="15" Height="15" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>

            <controls:StringSettingViewer x:Name="valueViewer"/>

            <WrapPanel Margin="0 8 0 4">
                <Button Content="Add String key"
                        Style="{StaticResource KeyAddButton}"
                        Click="AddStringKey"/>
                <Button Content="Add Int key"
                        Style="{StaticResource KeyAddButton}"
                        Click="AddIntKey"/>
                <Button Content="Add Float key"
                        Style="{StaticResource KeyAddButton}"
                        Click="AddFloatKey"/>
                <Button Content="Add Bool key"
                        Style="{StaticResource KeyAddButton}"
                        Click="AddBoolKey"/>
                <Button Content="Add List key"
                        Style="{StaticResource KeyAddButton}"
                        Click="AddListKey"/>
                <Button Content="Add Dictionary key"
                        Style="{StaticResource KeyAddButton}"
                        Click="AddDictionaryKey"/>
            </WrapPanel>

            <StackPanel x:Name="keysPanel"
                        Orientation="Vertical"/>
        </StackPanel>
    </Border>
</UserControl>
