<Page x:Class="OpenBullet2.Native.Views.Pages.ConfigStacker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      KeyDown="PageKeyDown"
      Focusable="True"
      Title="ConfigStacker">

    <Page.Resources>
        <converters:BoolToThicknessConverter x:Key="BoolToThick" />

        <SolidColorBrush x:Key="StackerPanelBackground" Color="#182335" />
        <SolidColorBrush x:Key="StackerPanelBorder" Color="#253348" />
        <SolidColorBrush x:Key="StackerToolbarBackground" Color="#1E2B40" />
    </Page.Resources>

    <Grid Margin="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BlockListColumn" Width="220" MinWidth="220" MaxWidth="360" />
            <ColumnDefinition x:Name="StackerSplitterColumn" Width="10" />
            <ColumnDefinition x:Name="InspectorColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border x:Name="BlockListToolbar"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{StaticResource StackerToolbarBackground}"
                BorderBrush="{StaticResource StackerPanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.Success}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Add a new block"
                            mah:ControlsHelper.CornerRadius="10"
                            Click="AddBlock">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.Error}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Remove selected block(s)"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="RemoveBlock">
                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.ThemeAccent}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Clone selected block(s)"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="CloneBlock">
                        <iconPacks:PackIconMaterial Kind="ContentDuplicate" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.ThemeMain}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Move up"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="MoveBlockUp">
                        <iconPacks:PackIconUnicons Kind="AngleUp" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.ThemeMain}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Move down"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="MoveBlockDown">
                        <iconPacks:PackIconUnicons Kind="AngleDown" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Modern.Warning}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Enable/Disable"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="EnableDisableBlock">
                        <iconPacks:PackIconForkAwesome Kind="Ban" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource DebuggerToolbarButton}"
                            Background="{StaticResource Modern.ThemeSecondary}"
                            Foreground="{StaticResource Modern.TextOnAccent}"
                            ToolTip="Undo last action"
                            mah:ControlsHelper.CornerRadius="8"
                            Click="Undo">
                        <iconPacks:PackIconMaterial Kind="Undo" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="Config stacker"
                               Foreground="{StaticResource Modern.ForegroundMain}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Stack.Count, StringFormat=Blocks: {0}, TargetNullValue=Blocks: 0}"
                               Foreground="{StaticResource Modern.ForegroundMuted}"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Block list -->
        <Border x:Name="BlockListContainer"
                Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource StackerPanelBackground}"
                BorderBrush="{StaticResource StackerPanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Control Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Modern.ForegroundMain}"
                           Margin="0,0,0,10" />

                <Border Grid.Row="1"
                        Background="#202F45"
                        BorderBrush="{StaticResource StackerPanelBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,0"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="Magnify"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource Modern.ForegroundMuted}" />
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Modern.ForegroundMain}"
                                 FontSize="12"
                                 mah:TextBoxHelper.Watermark="Search blocks..."
                                 mah:TextBoxHelper.UseFloatingWatermark="False"
                                 TextChanged="SearchTextBox_TextChanged" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BlocksItemsControl"
                                  ItemsSource="{Binding Stack}"
                                  Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                                        VirtualizingPanel.ScrollUnit="Pixel" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ModernButton}"
                                        Height="40"
                                        Margin="0,4"
                                        Padding="8,0"
                                        Background="{Binding BackgroundColor}"
                                        Foreground="{Binding ForegroundColor}"
                                        BorderThickness="{Binding Selected, Converter={StaticResource BoolToThick}}"
                                        BorderBrush="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#3B82F6|Transparent'}"
                                        Tag="{Binding}"
                                        Click="SelectBlock"
                                        ToolTip="{Binding Block.Descriptor.Name}">
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ForegroundColor}" Opacity="0.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding ForegroundColor}" 
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter x:Name="BlockListGridSplitter"
                      Grid.Row="1"
                      Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Block details -->
        <Border x:Name="BlockInspectorBorder"
                Grid.Row="1"
                Grid.Column="2"
                Background="{StaticResource StackerPanelBackground}"
                BorderBrush="{StaticResource StackerPanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <TextBlock x:Name="BlockInfoPlaceholder"
                           Text="Select a block to inspect its settings."
                           Foreground="{StaticResource Modern.ForegroundMuted}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="32" />
                <ScrollViewer x:Name="BlockInfoScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="BlockInfoContent" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

