<Page x:Class="OpenBullet2.Native.Views.Pages.Configs.ConfigSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      xmlns:uc="clr-namespace:OpenBullet2.Native.Controls"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:resources="clr-namespace:RuriLib.Models.Data.Resources.Options;assembly=RuriLib"
      xmlns:rules="clr-namespace:RuriLib.Models.Data.Rules;assembly=RuriLib"
      xmlns:settings="clr-namespace:RuriLib.Models.Configs.Settings;assembly=RuriLib"
      mc:Ignorable="d" 
      d:DesignHeight="2750" d:DesignWidth="800"
      Title="Config Settings">

    <Page.Resources>
        <!-- Premium Settings Card Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernHeading3}">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource Modern.ThemeMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Setting Label Style -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernBodyText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,16,8"/>
        </Style>
        
         <!-- Setting Subtitle Style -->
        <Style x:Key="SettingSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernCaptionText}">
             <Setter Property="Foreground" Value="{StaticResource Modern.ThemeMain}"/>
             <Setter Property="FontWeight" Value="SemiBold"/>
             <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
    </Page.Resources>

    <!-- Modern Config Settings Layout -->
    <Grid Margin="24,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled" 
                      PanningMode="VerticalOnly"
                      CanContentScroll="False"
                      ScrollViewer.IsDeferredScrollingEnabled="False">
            <StackPanel Margin="0,0,0,20">
                
                <!-- General Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1E3A5F" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="{StaticResource Modern.ThemeMain}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="General Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bot Settings -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Suggested amount of bots:" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="1000" Value="{Binding GeneralSettings.SuggestedBots}" Width="200" HorizontalAlignment="Left" Margin="0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum CPM (0 to disable):" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000000" Value="{Binding GeneralSettings.MaximumCPM}" Width="200" HorizontalAlignment="Left" Margin="0,8"/>

                            <!-- check boxes -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Save empty captures" IsChecked="{Binding GeneralSettings.SaveEmptyCaptures}" Margin="0,4"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Report the last captcha if the bot ends with a RETRY status" IsChecked="{Binding GeneralSettings.ReportLastCaptchaOnRetry}" Margin="0,4"/>
                            </StackPanel>

                            <!-- Continue Statuses -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,8">
                                <TextBlock Text="Statuses for which the bot will continue / stop:" Style="{StaticResource SettingSubtitleStyle}"/>
                                <uc:MultipleSelector SelectedValues="{Binding ContinueStatuses, Mode=TwoWay}" PossibleValues="{Binding AllStatuses}"/>
                            </StackPanel>
                            
                            <!-- Max Jump Iterations -->
                             <TextBlock Grid.Row="5" Grid.Column="0" Text="Max JUMP iterations (infinite loop guard):" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="100000" Value="{Binding GeneralSettings.MaxJumpIterations}" Width="200" HorizontalAlignment="Left" Margin="0,8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Proxies Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#064E3B" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="16" Height="16" Foreground="{StaticResource Modern.Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Proxy Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Use Proxies -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Use proxies" IsChecked="{Binding ProxySettings.UseProxies}" Margin="0,4"/>
                            </StackPanel>
                            
                            <!-- Proxy Settings -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum uses per proxy (0 to disable):" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000000" Value="{Binding ProxySettings.MaxUsesPerProxy}" Width="200" HorizontalAlignment="Left" Margin="0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ban loop evasion (0 to disable):" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1000000" Value="{Binding ProxySettings.BanLoopEvasion}" Width="200" HorizontalAlignment="Left" Margin="0,8"/>

                            <!-- Proxy Selectors -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,8">
                                <TextBlock Text="Ban proxy when bot ends with these statuses:" Style="{StaticResource SettingSubtitleStyle}"/>
                                <uc:MultipleSelector SelectedValues="{Binding ProxyBanStatuses, Mode=TwoWay}" PossibleValues="{Binding AllStatuses}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,8">
                                <TextBlock Text="Allowed proxy types:" Style="{StaticResource SettingSubtitleStyle}"/>
                                <uc:MultipleSelector SelectedValues="{Binding AllowedProxyTypes, Mode=TwoWay}" PossibleValues="{Binding ProxyTypes}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                         <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#78350F" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Database" Width="16" Height="16" Foreground="{StaticResource Modern.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Data Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>

                        <!-- Allowed Wordlist Types -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Allowed wordlist types:" Style="{StaticResource SettingSubtitleStyle}"/>
                            <uc:MultipleSelector SelectedValues="{Binding AllowedWordlistTypes, Mode=TwoWay}" PossibleValues="{Binding WordlistTypes}"/>
                        </StackPanel>

                        <CheckBox Content="URL Encode data after slicing" IsChecked="{Binding DataSettings.UrlEncodeDataAfterSlicing}" Margin="0,8,0,16"/>
                        
                        <!-- Rules Section -->
                        <TextBlock Text="Data Rules" Style="{StaticResource SettingSubtitleStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Click="AddSimpleDataRule" Style="{StaticResource ModernSuccessButton}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Simple Rule"/>
                                </StackPanel>
                            </Button>
                            <Button Click="AddRegexDataRule" Style="{StaticResource ModernSuccessButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Regex Rule"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding DataRulesCollection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <!-- Simple Data Rule Template -->
                                <DataTemplate DataType="{x:Type rules:SimpleDataRule}">
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" VerticalAlignment="Center" Content="Slice Name" />
                                            <TextBox Grid.Column="1" Text="{Binding SliceName}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <ComboBox Grid.Column="2" 
                                                      ItemsSource="{Binding DataContext.StringRules, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Comparison}" Style="{StaticResource CleanComboBox}" Margin="8,0" Width="120" />
                                                      
                                            <TextBox Grid.Column="3" Text="{Binding StringToCompare}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <CheckBox Grid.Column="4" Content="Case sensitive" IsChecked="{Binding CaseSensitive}" Margin="8,0" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="5" Content="Invert" IsChecked="{Binding Invert}" Margin="8,0" VerticalAlignment="Center"/>
                                            
                                            <Button Tag="{Binding}" Grid.Column="6" Click="RemoveDataRule" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                
                                <!-- Regex Data Rule Template -->
                                <DataTemplate DataType="{x:Type rules:RegexDataRule}">
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" VerticalAlignment="Center" Content="Slice Name" />
                                            <TextBox Grid.Column="1" Text="{Binding SliceName}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <Label Grid.Column="2" VerticalAlignment="Center" Content="Regex to match" />
                                            <TextBox Grid.Column="3" Text="{Binding RegexToMatch}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <CheckBox Grid.Column="4" Content="Invert" IsChecked="{Binding Invert}" Margin="8,0" VerticalAlignment="Center"/>
                                            
                                            <Button Tag="{Binding}" Grid.Column="5" Click="RemoveDataRule" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>

                        <!-- Test Rules Section -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Test your data here:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding TestDataForRules}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding WordlistTypes}" SelectedValue="{Binding TestWordlistTypeForRules}" Style="{StaticResource CleanComboBox}" Margin="8,0" Width="120" />
                            
                            <Button Grid.Column="3" Click="TestDataRules" Style="{StaticResource ModernPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularTestTube" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Test"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Resources Section -->
                        <TextBlock Text="Resources" Style="{StaticResource SettingSubtitleStyle}" Margin="0,24,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Click="AddLinesFromFileResource" Style="{StaticResource ModernSuccessButton}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Lines from file"/>
                                </StackPanel>
                            </Button>
                            <Button Click="AddRandomLinesFromFileResource" Style="{StaticResource ModernSuccessButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" Text="Random lines from file"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding ResourcesCollection}">
                             <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <!-- Lines From File Template -->
                                <DataTemplate DataType="{x:Type resources:LinesFromFileResourceOptions}">
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" VerticalAlignment="Center" Content="Name" />
                                            <TextBox Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <Label Grid.Column="2" VerticalAlignment="Center" Content="Location" />
                                            <TextBox Grid.Column="3" Text="{Binding Location}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <CheckBox Grid.Column="4" Content="Loops around" IsChecked="{Binding LoopsAround}" Margin="8,0" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="5" Content="Ignore empty lines" IsChecked="{Binding IgnoreEmptyLines}" Margin="8,0" VerticalAlignment="Center"/>
                                            
                                            <Button Tag="{Binding}" Grid.Column="6" Click="RemoveResource" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                 <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                
                                <!-- Random Lines From File Template -->
                                <DataTemplate DataType="{x:Type resources:RandomLinesFromFileResourceOptions}">
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" VerticalAlignment="Center" Content="Name" />
                                            <TextBox Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <Label Grid.Column="2" VerticalAlignment="Center" Content="Location" />
                                            <TextBox Grid.Column="3" Text="{Binding Location}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <CheckBox Grid.Column="4" Content="Unique" IsChecked="{Binding Unique}" Margin="8,0" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="5" Content="Ignore empty lines" IsChecked="{Binding IgnoreEmptyLines}" Margin="8,0" VerticalAlignment="Center"/>
                                            
                                            <Button Tag="{Binding}" Grid.Column="6" Click="RemoveResource" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Input Settings Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#7F1D1D" Margin="0,0,12,0">
                                <iconPacks:PackIconBoxIcons Kind="RegularEdit" Width="16" Height="16" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Input Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Custom Inputs" Style="{StaticResource SettingSubtitleStyle}"/>
                        
                        <Button x:Name="addCustomInputButton" Click="AddCustomInput" 
                                Style="{StaticResource ModernSuccessButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Add Custom Input" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <ItemsControl x:Name="customInputsControl" ItemsSource="{Binding CustomInputsCollection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" VerticalAlignment="Center" Content="Description" />
                                            <TextBox Grid.Column="1" Text="{Binding Description}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <Label Grid.Column="2" VerticalAlignment="Center" Content="Variable name" />
                                            <TextBox Grid.Column="3" Text="{Binding VariableName}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <Label Grid.Column="4" VerticalAlignment="Center" Content="Default answer" />
                                            <TextBox Grid.Column="5" Text="{Binding DefaultAnswer}" Style="{StaticResource MatchingTextBox}" Margin="8,0" />
                                            
                                            <Button x:Name="removeCustomInputButton" Tag="{Binding}" Grid.Column="6" 
                                                    Click="RemoveCustomInput" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                <iconPacks:PackIconBoxIcons Kind="RegularX" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Puppeteer Settings Section -->
               <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                         <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#7F1D1D" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Web" Width="16" Height="16" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Puppeteer Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>

                        <!-- Browser Status Settings -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Quit the browser when the bot ends with one of these statuses:" Style="{StaticResource SettingSubtitleStyle}"/>
                            <uc:MultipleSelector SelectedValues="{Binding QuitBrowserStatuses, Mode=TwoWay}" PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>
                        
                        <!-- Browser Options -->
                        <StackPanel Margin="0,0,0,16">
                            <CheckBox Content="Headless mode" IsChecked="{Binding BrowserSettings.Headless}" Margin="0,8"/>
                            
                            <StackPanel Margin="0,8">
                                <TextBlock Text="Stealth Mode:" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding BrowserSettings.StealthMode}" 
                                          Style="{StaticResource CleanComboBox}" 
                                          Width="250" HorizontalAlignment="Left"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Default" Tag="{x:Static settings:BrowserStealthMode.Default}" />
                                    <ComboBoxItem Content="Stealth" Tag="{x:Static settings:BrowserStealthMode.Stealth}" />
                                    <ComboBoxItem Content="Enhanced Stealth" Tag="{x:Static settings:BrowserStealthMode.EnhancedStealth}" />
                                    <ComboBoxItem Content="Option4 Maximum Stealth" Tag="{x:Static settings:BrowserStealthMode.Option4}" />
                                </ComboBox>
                            </StackPanel>
                            
                            <CheckBox Content="Load only document and script" IsChecked="{Binding BrowserSettings.LoadOnlyDocumentAndScript}" Margin="0,8"/>
                            <CheckBox Content="Dismiss dialogs" IsChecked="{Binding BrowserSettings.DismissDialogs}" Margin="0,8"/>
                            <CheckBox Content="Ignore HTTPS errors" IsChecked="{Binding BrowserSettings.IgnoreHttpsErrors}" Margin="0,8"/>
                        </StackPanel>
                        
                        <!-- Command Line Arguments -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Command line arguments:" Style="{StaticResource SettingSubtitleStyle}"/>
                            <TextBox Text="{Binding BrowserSettings.CommandLineArgs}" Style="{StaticResource MatchingTextBox}"/>
                        </StackPanel>
                        
                        <!-- Blocked URLs -->
                        <StackPanel>
                            <TextBlock Text="Blocked URLs (one per line):" Style="{StaticResource SettingSubtitleStyle}"/>
                             <TextBox x:Name="blockedUrlsTextBox" 
                                      Style="{StaticResource MatchingTextBox}"
                                      FontFamily="Consolas"
                                      Height="100"
                                      VerticalContentAlignment="Top"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalScrollBarVisibility="Auto"
                                      TextChanged="BlockedUrlsChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

