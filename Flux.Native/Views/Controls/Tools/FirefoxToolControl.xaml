<UserControl x:Class="Flux.Native.Views.Controls.Tools.FirefoxToolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d">
    <Border Style="{StaticResource ModernCardLite}"
            Background="{DynamicResource Modern.BackgroundSecondary}"
            Padding="20"
            Visibility="{Binding CardVisibility}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconMaterial Kind="FolderZip"
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource Modern.Warning}"/>
                <TextBlock Text="Firefox Switcher"
                           Style="{StaticResource H3TextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Quickly switch between Firefox profiles or launch new instances with different configurations."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource StyledWarningButton}"
                        Content="Clear"
                        Width="80"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearCommand}"
                        AutomationProperties.Name="Clear zip options"/>
                <Button Style="{StaticResource StyledPrimaryButton}"
                        Content="Load .zip"
                        Width="100"
                        Grid.Column="1"
                        Click="SelectZipForOptions"
                        AutomationProperties.Name="Load zip archive"/>
            </Grid>

            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Selected Archive"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource Modern.ForegroundMuted}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ArchiveFileName}"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{DynamicResource Modern.ForegroundMain}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource Modern.ThemeMain}"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="{Binding StatusVisibility}">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Foreground="{Binding StatusBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    MinHeight="160">
                <ListBox Foreground="{DynamicResource Modern.ForegroundMain}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Options}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource Modern.BackgroundElevated}"
                                        BorderBrush="{DynamicResource Modern.BorderMain}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{DynamicResource Modern.ForegroundMain}"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Width="40"
                                        Height="34"
                                        Padding="4"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.CopyOptionNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Copy folder name">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18"/>
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource StyledSuccessButton}"
                                        Width="44"
                                        Height="34"
                                        Padding="4"
                                        Command="{Binding DataContext.LaunchOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Launch Firefox profile">
                                    <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
