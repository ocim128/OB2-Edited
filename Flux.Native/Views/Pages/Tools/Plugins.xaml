<Page x:Class="Flux.Native.Views.Pages.Tools.Plugins"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="Plugins">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Plugin Management Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,15">
            <Button x:Name="addPluginButton" Click="AddPlugin" Margin="0,0,5,0" Style="{StaticResource StyledButton}" Background="{DynamicResource Modern.Success}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterialDesign Kind="Add" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Add Plugin</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- Compact Plugin Features Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Plugin Features" FontSize="18" FontWeight="SemiBold" 
                      Foreground="{DynamicResource Modern.ForegroundMain}" Margin="0,0,0,12"/>
            
            <!-- OTP File Writer - Compact Card -->
            <Border Background="{DynamicResource Modern.BackgroundSecondary}" 
                   BorderBrush="{DynamicResource Modern.Success}" BorderThickness="2"
                   CornerRadius="8" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <Border Grid.Column="0" Background="{DynamicResource Modern.Success}" 
                           CornerRadius="6" Padding="8" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="20" Height="20" 
                                                   Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Border>
                    
                    <!-- Main Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="OTP File Writer" FontSize="15" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource Modern.ForegroundMain}" Margin="0,0,0,2"/>
                        <TextBlock Text="Hotkey: Ctrl+Alt+Q - Saves clipboard to otp.txt (if contains 'disavow' or 6-digit number)" 
                                  FontSize="12" Foreground="{DynamicResource Modern.ForegroundSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Status Indicator -->
                    <Border Grid.Column="2" Background="{DynamicResource Modern.Success}" CornerRadius="12" 
                           Padding="8,4" Margin="8,0"
                           Visibility="{Binding HotkeysEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" 
                                  Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Border>
                    
                    <!-- Toggle Switch -->
                    <CheckBox Grid.Column="3" x:Name="hotkeyToggle" 
                             IsChecked="{Binding HotkeysEnabled}" 
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Modem IP Quick Refresh - Compact Card -->
            <Border Background="{DynamicResource Modern.BackgroundSecondary}" 
                   BorderBrush="{DynamicResource Modern.Success}" BorderThickness="2"
                   CornerRadius="8" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <Border Grid.Column="0" Background="{DynamicResource Modern.Success}" 
                           CornerRadius="6" Padding="8" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="RouterWireless" Width="20" Height="20" 
                                                   Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Border>
                    
                    <!-- Main Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Modem IP Quick Refresh" FontSize="15" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource Modern.ForegroundMain}" Margin="0,0,0,2"/>
                        <TextBlock Text="Hotkey: Ctrl+Shift+Alt+Y - Runs the modem automation flow with your saved router address, username, and an admin password."
                                  FontSize="12" Foreground="{DynamicResource Modern.ForegroundSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Shares the same toggle above and surfaces the hidden notification shown by the Ctrl+Alt+Q plugin."
                                  FontSize="11" Foreground="{DynamicResource Modern.ForegroundMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Status Indicator -->
                    <Border Grid.Column="2" Background="{DynamicResource Modern.Success}" CornerRadius="12" 
                           Padding="8,4" Margin="8,0"
                           Visibility="{Binding HotkeysEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" 
                                  Foreground="{DynamicResource Modern.TextOnAccent}"/>
                    </Border>
                    
                    <!-- Toggle Switch -->
                    <CheckBox Grid.Column="3" IsChecked="{Binding HotkeysEnabled}" 
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Placeholder for Future Features -->
            <Border Background="{DynamicResource Modern.BackgroundInput}" 
                   BorderBrush="{DynamicResource Modern.BorderMain}" BorderThickness="1"
                   CornerRadius="8" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{DynamicResource Modern.BorderMain}" 
                           CornerRadius="6" Padding="8" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="20" Height="20" 
                                                   Foreground="{DynamicResource Modern.ForegroundSecondary}"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Add New Feature" FontSize="15" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource Modern.ForegroundMuted}" Margin="0,0,0,2"/>
                        <TextBlock Text="Future plugin features will appear here as compact toggle cards" 
                                  FontSize="12" Foreground="{DynamicResource Modern.ForegroundSecondary}"/>
                    </StackPanel>
                    
                    <CheckBox Grid.Column="2" IsEnabled="False" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
        
        <!-- Plugin Management List with single-scroll pattern (no outer ScrollViewer) -->
        <Grid Grid.Row="2"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Installed Plugins"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Modern.ForegroundMain}"
                       Margin="0,0,0,8"
                       Visibility="{Binding PluginsCollection.Count, Converter={StaticResource BoolToVis}}"/>

            <!-- Make the content itself the only scrollable area if it exceeds the available space -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                <ItemsControl x:Name="pluginsControl"
                              ItemsSource="{Binding PluginsCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"
                                                    VirtualizingPanel.IsVirtualizing="True"
                                                    VirtualizingPanel.VirtualizationMode="Recycling"
                                                    VirtualizingPanel.ScrollUnit="Pixel"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Modern.BackgroundSecondary}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Modern.BorderMain}"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Text="{Binding Name}" FontSize="14"
                                               Foreground="{DynamicResource Modern.ForegroundMain}"/>

                                    <Button x:Name="removePluginButton" Tag="{Binding}"
                                            Grid.Column="1" Click="RemovePlugin"
                                            Style="{StaticResource StyledButton}"
                                            Background="{DynamicResource Modern.Error}"
                                            Padding="8,4" MinHeight="28">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                            <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12">Remove</TextBlock>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>


