<Page x:Class="Flux.Native.Views.Dialogs.Common.CustomInputDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Common"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      MinWidth="300"
      Background="Transparent"
      Title="Input">

    <Border Background="{DynamicResource Modern.BackgroundSecondary}" 
            CornerRadius="8" 
            BorderBrush="{DynamicResource Modern.BorderMain}" 
            BorderThickness="1"
            MinWidth="500"
            MaxWidth="700"
            MinHeight="200">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" 
                       Text="Input Required"
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource Modern.ForegroundMain}" 
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"/>

            <!-- Icon -->
            <iconPacks:PackIconMaterial Grid.Row="1"
                                        Kind="TextBox"
                                        Width="48"
                                        Height="48"
                                        Foreground="{DynamicResource Modern.ThemeMain}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,20"/>

            <!-- Question -->
            <TextBlock Grid.Row="2"
                x:Name="question"
                FontSize="13"
                Text="Question?"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource Modern.ForegroundSecondary}"
                Margin="0,0,0,15"
                LineHeight="18"/>

            <!-- Input -->
            <ComboBox Grid.Row="3"
                IsEditable="True"
                Width="250"
                x:Name="answerComboBox"
                Style="{StaticResource CleanComboBox}"
                HorizontalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                
                <Button Click="Cancel_Click"
                    Width="100"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Style="{StaticResource StyledButton}"/>

                <Button Click="Ok"
                    Width="100"
                    Content="Ok"
                    Style="{StaticResource StyledPrimaryButton}"/>
            </StackPanel>

        </Grid>
    </Border>

</Page>
