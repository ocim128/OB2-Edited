<mah:MetroWindow x:Class="OpenBullet2.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBullet2.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
        mc:Ignorable="d"
        Title="OpenBullet 2 - 0.3.3.8 [Akunlama MOD]" 
        MinWidth="900" MinHeight="650"
        Background="{StaticResource Modern.BackgroundMain}"
        BorderThickness="0"
        GlowBrush="{StaticResource Modern.ThemeMain}"
        ResizeMode="CanResizeWithGrip"
        WindowTitleBrush="{StaticResource Modern.BackgroundSecondary}"
        NonActiveWindowTitleBrush="{StaticResource Modern.BackgroundMain}"
        WindowTransitionsEnabled="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        TitleCharacterCasing="Normal"
        TitleForeground="{StaticResource Modern.ForegroundMain}"
        TitleAlignment="Left"
        ShowMinButton="True"
        ShowMaxRestoreButton="True"
        ShowCloseButton="True"
        Icon="/Images/logohq_square_padded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        SizeChanged="OnWindowSizeChanged"
        Loaded="OnWindowLoaded">



    <!-- Enhanced Title Bar with Fluent Design -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" 
                          FontFamily="Segoe UI" 
                          FontSize="13" 
                          FontWeight="Medium" 
                          Foreground="{StaticResource Modern.ForegroundMain}" 
                          VerticalAlignment="Center"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!-- Custom Window Button Styles -->
    <!-- Removed duplicate button styles - using ModernTheme.xaml styles for better performance -->

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:CustomCommands.NewConfig}" Gesture="CTRL+N" />
        <KeyBinding Command="{x:Static local:CustomCommands.OpenConfig}" Gesture="CTRL+O" />
        <KeyBinding Command="{x:Static local:CustomCommands.SaveConfig}" Gesture="CTRL+S" />
        <KeyBinding Command="{x:Static local:CustomCommands.Refresh}" Gesture="CTRL+R" />
        <KeyBinding Command="{x:Static local:CustomCommands.Quit}" Gesture="CTRL+Q" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHome}" Gesture="CTRL+D1" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToJobs}" Gesture="CTRL+D2" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToMonitor}" Gesture="CTRL+D3" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToProxies}" Gesture="CTRL+D4" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToWordlists}" Gesture="CTRL+D5" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToConfigs}" Gesture="CTRL+D6" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHits}" Gesture="CTRL+D7" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToPlugins}" Gesture="CTRL+D8" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToOBSettings}" Gesture="CTRL+D9" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToRLSettings}" Gesture="CTRL+D0" />
    </Window.InputBindings>

    <!-- Responsive Layout Grid -->
    <Grid x:Name="Root">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopNavRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Navigation Header - Minimal and Fluent -->
        <Border x:Name="NavigationHeader"
                Grid.Row="0" 
                Background="{StaticResource Modern.BackgroundSecondary}" 
                BorderBrush="{StaticResource Modern.BorderMain}" 
                BorderThickness="0,0,0,1">
            <StackPanel x:Name="topMenu" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="24,12">
                    <!-- Using styles from ModernTheme.xaml for better performance -->
                
                    <!-- Navigation Menu Items -->
                    <Button x:Name="menuOptionHome" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Home" ToolTip="Home Dashboard (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Home" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Home"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionJobs" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Jobs" ToolTip="Job Management (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlayBox" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Jobs"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionMonitor" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Monitor" ToolTip="Live Monitoring (Ctrl+3)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Monitor" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Monitor"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionProxies" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Proxies" ToolTip="Proxy Management (Ctrl+4)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Proxies"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionWordlists" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Wordlists" ToolTip="Wordlist Library (Ctrl+5)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocument" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Wordlists"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionConfigs" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Configs" MouseEnter="ConfigsMenuOptionMouseEnter" MouseLeave="ConfigsMenuOptionMouseLeave" ToolTip="Configuration Editor (Ctrl+6)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CodeJson" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Configs"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionHits" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Hits" ToolTip="Successful Results (Ctrl+7)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Target" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hits"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionPlugins" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="Plugins" ToolTip="Plugin Manager (Ctrl+8)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Puzzle" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Plugins"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionSettings" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="OBSettings" ToolTip="Application Settings (Ctrl+9)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionRLSettings" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="RLSettings" ToolTip="RuriLib Settings">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Wrench" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RL Settings"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionCheckUpdate" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="CheckUpdate" ToolTip="Check for Updates">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Update" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Check Update"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="menuOptionAbout" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="About" ToolTip="About OpenBullet">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Information" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
            </StackPanel>
        </Border>

        <!-- Modern Config Submenu -->
        <Border x:Name="configSubmenu"
                Background="{StaticResource Modern.BackgroundCard}"
                BorderBrush="{StaticResource Modern.BorderMain}"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="1000"
                Height="auto"
                Width="160"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                MouseEnter="ConfigSubmenuMouseEnter"
                MouseLeave="ConfigSubmenuMouseLeave"
                Padding="8">
            <StackPanel>
                <!-- Using ModernButton style from ModernTheme.xaml -->
                
                <!-- Config Editor Menu Items -->
                <Button x:Name="menuOptionMetadata" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="ConfigMetadata" ToolTip="Metadata" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <TextBlock Text="Metadata"/>
                </Button>
                <Button x:Name="menuOptionReadme" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="ConfigReadme" ToolTip="Readme" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <TextBlock Text="Readme"/>
                </Button>
                <Button x:Name="menuOptionStacker" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="ConfigStacker" ToolTip="Stacker" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <TextBlock Text="Stacker"/>
                </Button>
                <Button x:Name="menuOptionLoliCode" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="ConfigLoliCode" ToolTip="LoliCode" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <TextBlock Text="LoliCode"/>
                </Button>
                <Button x:Name="menuOptionConfigSettings" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="ConfigSettings" ToolTip="Settings" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <TextBlock Text="Settings"/>
                </Button>
                <Button x:Name="menuOptionCSharpCode" Style="{StaticResource ModernButton}" Click="HandleNavigationClick" Tag="ConfigCSharpCode" ToolTip="C# Code" FontSize="12" Padding="12,8" Margin="0,1" HorizontalContentAlignment="Left">
                    <TextBlock Text="C# Code"/>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area with Enhanced Transitions -->
        <Border x:Name="MainContentBorder"
                Grid.Row="1" 
                Background="Transparent" 
                CornerRadius="8" 
                BorderBrush="#FF333333"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <!-- Main content frame with smooth transitions -->
                <Frame x:Name="MainFrame" 
                       NavigationUIVisibility="Hidden" 
                       Background="Transparent" />
                
                <!-- Simplified loading indicator -->
            </Grid>
        </Border>

        <mah:ProgressRing 
            x:Name="loadingIndicator"
            Grid.Row="1"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
    </Grid>

</mah:MetroWindow>
