<Page x:Class="OpenBullet2.Native.Views.Pages.Shared.Debugger"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages.Shared"
      xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
      xmlns:uc="clr-namespace:OpenBullet2.Native.Controls"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Debugger">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LessThanConverter x:Key="LessThanConverter" />
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:BoolToIconConverter x:Key="BoolToIconConverter" />
        
        <!-- Optimized responsive style with caching -->
        <Style x:Key="ResponsiveHideStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Performance optimized button style -->
        <Style x:Key="OptimizedTabButton" TargetType="Button" BasedOn="{StaticResource ReadableTabButton}">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Page.Resources>
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- Give more space to results area by increasing its min height -->
            <RowDefinition Height="*"
                           MinHeight="320" />
        </Grid.RowDefinitions>
        <!-- Toggle Button for UI Elements -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
            <Button x:Name="TabToggleButton"
                    Click="ToggleTabButtons"
                    Style="{StaticResource ReadableTabButton}"
                    Width="120"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="#059669"
                    Foreground="#F8FAFC"
                    ToolTip="Toggle UI Elements Visibility">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconUnicons x:Name="TabToggleIcon"
                                               Kind="Eye"
                                               Width="14"
                                               Height="14"
                                               Margin="0,0,6,0" />
                    <TextBlock Text="Show UI"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               FontSize="11" />
                </StackPanel>
            </Button>
            <!-- Toggle Button for Options -->
            <Button x:Name="OptionsToggleButton"
                    Click="ToggleOptions"
                    Style="{StaticResource ReadableTabButton}"
                    Width="130"
                    Height="28"
                    Background="#7C3AED"
                    Foreground="#F8FAFC"
                    ToolTip="Toggle Options Visibility">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconUnicons x:Name="OptionsToggleIcon"
                                               Kind="Eye"
                                               Width="14"
                                               Height="14"
                                               Margin="0,0,6,0" />
                    <TextBlock Text="Show Options"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               FontSize="11" />
                </StackPanel>
            </Button>
            <!-- Toggle Button for Stacker -->
            <Button x:Name="StackerToggleButton"
                    Click="ToggleStacker"
                    Style="{StaticResource ReadableTabButton}"
                    Width="130"
                    Height="28"
                    Margin="8,0,0,0"
                    Background="#059669"
                    Foreground="#F8FAFC"
                    ToolTip="Toggle Stacker Visibility">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconUnicons x:Name="StackerToggleIcon"
                                               Kind="Eye"
                                               Width="14"
                                               Height="14"
                                               Margin="0,0,6,0" />
                    <TextBlock Text="Show Stacker"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               FontSize="11" />
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- Configuration Panel -->
        <Border Grid.Row="1"
                x:Name="ConfigurationPanel"
                Background="#C0303030"
                CornerRadius="8"
                Padding="16,12">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <!-- Reduce spacing when window is small -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                                         Value="True">
                                <Setter Property="Margin"
                                        Value="0,-4,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10"
                                   x:Name="SpacingRow" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Main Configuration -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Input Data - Primary Focus - Enhanced to prevent text truncation -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="INPUT DATA"
                                   Foreground="#A0AEC0"
                                   FontFamily="Segoe UI"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding TestData}"
                                 Style="{StaticResource MatchingTextBox}"
                                 MinHeight="38" />
                    </StackPanel>
                    <!-- Perfect Start Button -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Click="Start"
                                Style="{StaticResource PerfectStartButton}"
                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                Width="80"
                                Height="32"
                                Margin="0,0,6,0"
                                Padding="10,6" />
                        <Button Click="Stop"
                                Style="{StaticResource PerfectStopButton}"
                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}"
                                Width="80"
                                Height="32"
                                Margin="0,0,6,0"
                                Padding="10,6" />
                        <Button Click="TakeStep"
                                Style="{StaticResource StyledPrimaryButton}"
                                Visibility="{Binding CanTakeStep, Converter={StaticResource BoolToVis}}"
                                Width="75"
                                Height="32"
                                Margin="0,0,6,0"
                                FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconEntypo Kind="ControllerPlay"
                                                          Width="12"
                                                          Height="12"
                                                          Margin="0,0,4,0" />
                                <TextBlock Text="Step"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Secondary Options - Well Positioned -->
                <Grid Grid.Row="2"
                      x:Name="SecondaryOptionsGrid"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Collapsible Secondary Options Panel -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Grid.ColumnSpan="11"
                                  MaxHeight="40"
                                  CanContentScroll="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,0">
                            <!-- Square Step-by-Step Checkbox -->
                            <CheckBox IsChecked="{Binding StepByStep}"
                                      Style="{StaticResource SquareCheckBox}"
                                      Content="Step-by-Step"
                                      Margin="0,0,24,0" />
                            <!-- Wordlist Type with Clean ComboBox -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,24,0">
                                <TextBlock Text="Type"
                                           Foreground="#6B7280"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Style="{StaticResource ResponsiveHideStyle}" />
                                <ComboBox ItemsSource="{Binding WordlistTypes}"
                                          SelectedItem="{Binding WordlistType}"
                                          Style="{StaticResource CleanComboBox}"
                                          Width="95"
                                          MinHeight="34" />
                            </StackPanel>
                            <!-- Square Proxy Checkbox -->
                            <CheckBox IsChecked="{Binding UseProxy}"
                                      Style="{StaticResource SquareCheckBox}"
                                      Content="Proxy"
                                      Margin="0,0,12,0" />
                            <!-- Proxy Configuration with Clean ComboBox -->
                            <StackPanel Orientation="Horizontal"
                                        IsEnabled="{Binding UseProxy}"
                                        Margin="0,0,24,0">
                                <TextBox Text="{Binding TestProxy}"
                                         Style="{StaticResource MatchingTextBox}"
                                         Width="130"
                                         MinHeight="38"
                                         Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding ProxyTypes}"
                                          SelectedItem="{Binding ProxyType}"
                                          Style="{StaticResource CleanComboBox}"
                                          Width="75"
                                          MinHeight="38" />
                            </StackPanel>
                            <!-- Square Persist Log Checkbox -->
                            <CheckBox IsChecked="{Binding PersistLog}"
                                      Style="{StaticResource SquareCheckBox}"
                                      Content="Persist Log" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Triggers for responsive behavior -->
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ResponsiveHideStyle}" />
                    </Grid.Style>
                </Grid>
            </Grid>
        </Border>
        <!-- Results Panel -->
        <Border Grid.Row="3"
                Background="#C0303030"
                CornerRadius="8"
                Padding="0"
                MinHeight="320">
            <TabControl x:Name="tabControl" Background="Transparent" BorderThickness="0"
                        RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        SnapsToDevicePixels="True">
                <!-- Log Tab -->
                <TabItem>
                    <TabItem.Header>
                        <Button Click="ShowLog"
                                Width="95"
                                Height="36"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                x:Name="LogTabButton"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource OptimizedTabButton}">
                                    <Setter Property="Background"
                                            Value="#2563EB" />
                                    <Setter Property="Foreground"
                                            Value="#F8FAFC" />
                                    <Style.Triggers>
                                        <!-- Hide tab buttons when window is small -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconRadixIcons Kind="ActivityLog"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,6,0" />
                                <TextBlock Text="Log"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </TabItem.Header>
                    <Grid Margin="16">

                        <Grid.RowDefinitions>
                            <!-- Allocate more space to the log content row -->
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Optimized Log Content with virtualization -->
                        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="8"
                                RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <!-- Remove outer ScrollViewer to avoid double scrollbars; rely on inner WinForms RichTextBox scrollbar -->
                            <WindowsFormsHost>
                                <wf:RichTextBox x:Name="logRTB" Dock="Fill" ForeColor="Gainsboro" ReadOnly="True"
                                                ScrollBars="Vertical" BorderStyle="None" DetectUrls="False"
                                                MaxLength="1000000" />
                            </WindowsFormsHost>
                        </Border>
                        <!-- Search Controls - Enhanced UI with Better Styling -->
                        <Border Grid.Row="2"
                                Background="#70303030"
                                CornerRadius="8"
                                Padding="14,12"
                                BorderBrush="#4A5568"
                                BorderThickness="1"
                                x:Name="SearchControlsArea"
                                Visibility="Collapsed">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ResponsiveHideStyle}" />
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Optimized Search Input with performance enhancements -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Height="34"
                                 Background="#2D3748"
                                 Foreground="#E2E8F0"
                                 BorderBrush="#4A5568"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="12"
                                 ToolTip="Search logs (Ctrl+F)"
                                 x:Name="searchTextBox"
                                 RenderOptions.ClearTypeHint="Enabled"
                                 UseLayoutRounding="True"
                                 SpellCheck.IsEnabled="False"/>
                                <!-- Simplified Search Button -->
                <Button Grid.Column="2"
                        Click="Search"
                        Height="34"
                        Width="60"
                        Background="#059669"
                        Foreground="White"
                        BorderThickness="0"
                        Content="Search"
                        FontSize="9"
                        mah:ControlsHelper.ContentCharacterCasing="Normal" />
                                <!-- Previous Button -->
                                <Button Grid.Column="4"
                                        Click="PreviousMatch"
                                        Style="{StaticResource ReadableTabButton}"
                                        Width="34"
                                        Height="34"
                                        Background="#6B7280"
                                        Foreground="#F8FAFC"
                                        ToolTip="Previous Match (Shift+F3)">
                                    <iconPacks:PackIconUnicons Kind="AngleLeft"
                                                               Width="16"
                                                               Height="16" />
                                </Button>
                                <!-- Match Counter with Enhanced Styling -->
                                <Border Grid.Column="6"
                                        Background="#374151"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        BorderBrush="#4B5563"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding MatchInfo}"
                                               Foreground="#F3F4F6"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               MinWidth="80"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <!-- Next Button -->
                                <Button Grid.Column="8"
                                        Click="NextMatch"
                                        Style="{StaticResource ReadableTabButton}"
                                        Width="34"
                                        Height="34"
                                        Background="#6B7280"
                                        Foreground="#F8FAFC"
                                        ToolTip="Next Match (F3)">
                                    <iconPacks:PackIconUnicons Kind="AngleRight"
                                                               Width="16"
                                                               Height="16" />
                                </Button>
                                <!-- Action Buttons Group -->
                                <StackPanel Grid.Column="10"
                                            Orientation="Horizontal">
                                    <!-- Clear Search Button -->
                                    <Button Click="ClearSearch"
                                            Style="{StaticResource ReadableTabButton}"
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,8,0"
                                            Background="#DC2626"
                                            Foreground="#F8FAFC"
                                            ToolTip="Clear Search (Esc)">
                                        <iconPacks:PackIconMaterialDesign Kind="Close"
                                                                          Width="14"
                                                                          Height="14" />
                                    </Button>
                                    <!-- Stop Scroll Button -->
                                    <Button Click="ToggleAutoScroll"
                                            Style="{StaticResource ReadableTabButton}"
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,8,0"
                                            Background="{Binding IsAutoScrollEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#059669|#DC2626'}"
                                            Foreground="#F8FAFC"
                                            ToolTip="{Binding AutoScrollButtonText}">
                                        <iconPacks:PackIconMaterial Kind="{Binding IsAutoScrollEnabled, Converter={StaticResource BoolToIconConverter}, ConverterParameter='Pause|Play'}"
                                                                    Width="14"
                                                                    Height="14" />
                                    </Button>
                                    <!-- Clear Log Button -->
                                    <Button Click="ClearLog"
                                            Style="{StaticResource ReadableTabButton}"
                                            Width="34"
                                            Height="34"
                                            Background="#6B7280"
                                            Foreground="#F8FAFC"
                                            ToolTip="Clear All Logs (Ctrl+L)">
                                        <iconPacks:PackIconMaterialDesign Kind="DeleteSweep"
                                                                          Width="14"
                                                                          Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- Variables Tab -->
                <TabItem>
                    <TabItem.Header>
                        <Button Click="ShowVariables"
                                Width="105"
                                Height="36"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                x:Name="VariablesTabButton"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource OptimizedTabButton}">
                                    <Setter Property="Background"
                                            Value="#7C3AED" />
                                    <Setter Property="Foreground"
                                            Value="#F8FAFC" />
                                    <Style.Triggers>
                                        <!-- Hide tab buttons when window is small -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Variable"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,6,0" />
                                <TextBlock Text="Variables"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </TabItem.Header>
                    <Grid Margin="16">
                        <!-- Optimized Variables Content with performance enhancements -->
                        <Border Background="#1A1A1A"
                                BorderBrush="#404040"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="1"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                UseLayoutRounding="True">
                            <Border Background="#161616"
                                    CornerRadius="7"
                                    Padding="8">
                                <Grid>
                                    <!-- Optimized Variable Count Indicator -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#30000000"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            Margin="0,8,8,0"
                                            Panel.ZIndex="10"
                                            RenderOptions.ClearTypeHint="Enabled">
                                        <TextBlock Text="{Binding Variables.Count, StringFormat='Variables: {0}', Mode=OneWay}"
                                                   Foreground="#A78BFA"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   RenderOptions.ClearTypeHint="Enabled" />
                                    </Border>
                                    <!-- Remove outer ScrollViewer to avoid double scrollbars; rely on inner WinForms RichTextBox scrollbar -->
                                    <WindowsFormsHost>
                                        <wf:RichTextBox x:Name="variablesRTB"
                                                        Dock="Fill"
                                                        ForeColor="Gainsboro"
                                                        ReadOnly="True"
                                                        ScrollBars="Vertical"
                                                        BorderStyle="None"
                                                        DetectUrls="False"
                                                        MaxLength="500000" />
                                    </WindowsFormsHost>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- HTML Tab -->
                <TabItem>
                    <TabItem.Header>
                        <Button Click="ShowHTML"
                                Width="95"
                                Height="36"
                                Padding="12,8"
                                x:Name="HtmlTabButton"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource OptimizedTabButton}">
                                    <Setter Property="Background"
                                            Value="#DC2626" />
                                    <Setter Property="Foreground"
                                            Value="#F8FAFC" />
                                    <Style.Triggers>
                                        <!-- Hide tab buttons when window is small -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconEntypo Kind="Browser"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="HTML"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </TabItem.Header>
                    <Grid Margin="16">
                        <!-- Optimized HTML Content with performance enhancements -->
                        <Border Background="#1A1A1A"
                                BorderBrush="#404040"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="1"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                UseLayoutRounding="True">
                            <Border Background="#161616"
                                    CornerRadius="7"
                                    Padding="2">
                                <Grid>
                                    <!-- Optimized HTML Status Indicator -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#30000000"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            Margin="0,8,8,0"
                                            Panel.ZIndex="10"
                                            RenderOptions.ClearTypeHint="Enabled">
                                        <TextBlock Text="HTML Preview"
                                                   Foreground="#F87171"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   RenderOptions.ClearTypeHint="Enabled" />
                                    </Border>
                                    <uc:HTMLViewer x:Name="htmlViewer"
                                                   VerticalAlignment="Stretch"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   UseLayoutRounding="True" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>