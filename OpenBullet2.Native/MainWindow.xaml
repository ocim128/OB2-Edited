<mah:MetroWindow x:Class="OpenBullet2.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBullet2.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
        mc:Ignorable="d"
        Title="OpenBullet 2 - 0.3.3.8 [Akunlama MOD]" 
        MinWidth="800" MinHeight="600"
        Background="{StaticResource Modern.BackgroundMain}"
        BorderThickness="0"
        GlowBrush="{StaticResource Modern.ThemeMain}"
        ResizeMode="CanResizeWithGrip"
        WindowTitleBrush="{StaticResource Modern.BackgroundSecondary}"
        NonActiveWindowTitleBrush="{StaticResource Modern.BackgroundMain}"
        WindowTransitionsEnabled="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        TitleCharacterCasing="Normal"
        TitleForeground="{StaticResource Modern.ForegroundMain}"
        TitleAlignment="Left"
        ShowMinButton="True"
        ShowMaxRestoreButton="True"
        ShowCloseButton="True"
        Icon="/Images/logohq_square_padded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        SizeChanged="OnWindowSizeChanged"
        Loaded="OnWindowLoaded">



    <!-- Enhanced Title Bar with Fluent Design -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" 
                          FontFamily="Segoe UI" 
                          FontSize="13" 
                          FontWeight="Medium" 
                          Foreground="{StaticResource Modern.ForegroundMain}" 
                          VerticalAlignment="Center"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!-- Custom Window Button Styles -->
    <!-- Removed duplicate button styles - using ModernTheme.xaml styles for better performance -->

    <Window.Resources>
        <!-- Responsive Design Resources -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Converters -->
        <converters:LessThanConverter x:Key="LessThanConverter" />

        <!-- Global focus outline for accessibility -->
        <Style x:Key="HighVisibilityFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Rectangle StrokeThickness="2"
                                   Stroke="{StaticResource Modern.ThemeAccent}"
                                   StrokeDashArray="2 1"
                                   RadiusX="4"
                                   RadiusY="4"
                                   Fill="Transparent"
                                   Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:CustomCommands.NewConfig}" Gesture="CTRL+N" />
        <KeyBinding Command="{x:Static local:CustomCommands.OpenConfig}" Gesture="CTRL+O" />
        <KeyBinding Command="{x:Static local:CustomCommands.SaveConfig}" Gesture="CTRL+S" />
        <KeyBinding Command="{x:Static local:CustomCommands.Refresh}" Gesture="CTRL+R" />
        <KeyBinding Command="{x:Static local:CustomCommands.Quit}" Gesture="CTRL+Q" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHome}" Gesture="CTRL+D1" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToJobs}" Gesture="CTRL+D2" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToTools}" Gesture="CTRL+D3" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToProxies}" Gesture="CTRL+D4" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToWordlists}" Gesture="CTRL+D5" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToConfigs}" Gesture="CTRL+D6" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHits}" Gesture="CTRL+D7" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToProxies}" Gesture="CTRL+D4" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToWordlists}" Gesture="CTRL+D5" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToConfigs}" Gesture="CTRL+D6" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHits}" Gesture="CTRL+D7" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToPlugins}" Gesture="CTRL+D8" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToOBSettings}" Gesture="CTRL+D9" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToRLSettings}" Gesture="CTRL+D0" />
    </Window.InputBindings>

    <!-- Main Layout Grid -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Style="{StaticResource ModernSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Logo/Title Area (Optional) -->
                    <RowDefinition Height="*" />    <!-- Navigation Items -->
                    <RowDefinition Height="Auto" /> <!-- Bottom Actions -->
                </Grid.RowDefinitions>

                <!-- Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="topMenu" Margin="0,12,0,12">
                        
                        <TextBlock Text="MAIN" Style="{StaticResource SidebarText}" 
                                  FontSize="11" FontWeight="Bold" Foreground="{StaticResource Modern.ForegroundMuted}" 
                                  Margin="24,12,0,8" Opacity="0.7"/>

                        <!-- Home -->
                        <Button x:Name="menuOptionHome" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Home">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Home" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Home" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <!-- Jobs -->
                        <Button x:Name="menuOptionJobs" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Jobs">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PlayBox" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Jobs" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <!-- Hits -->
                        <Button x:Name="menuOptionHits" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Hits">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Target" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Hits" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="RESOURCES" Style="{StaticResource SidebarText}" 
                                  FontSize="11" FontWeight="Bold" Foreground="{StaticResource Modern.ForegroundMuted}" 
                                  Margin="24,16,0,8" Opacity="0.7"/>

                        <!-- Configs (Accordion Parent) -->
                        <Button x:Name="menuOptionConfigs" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Configs" 
                                MouseEnter="ConfigsMenuOptionMouseEnter" MouseLeave="ConfigsMenuOptionMouseLeave">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CodeJson" Style="{StaticResource SidebarIcon}"/>
                                    <TextBlock Text="Configs" Style="{StaticResource SidebarText}"/>
                                </StackPanel>
                                <iconPacks:PackIconMaterial Kind="ChevronDown" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                          Foreground="{StaticResource Modern.ForegroundMuted}"/>
                            </Grid>
                        </Button>

                        <!-- Configs Submenu (Inline) -->
                        <StackPanel x:Name="configSubmenu" Visibility="Collapsed" 
                                    MouseEnter="ConfigSubmenuMouseEnter" MouseLeave="ConfigSubmenuMouseLeave">
                            
                            <Button x:Name="menuOptionMetadata" Style="{StaticResource SidebarSubmenuButton}" Click="HandleNavigationClick" Tag="ConfigMetadata">
                                <TextBlock Text="Metadata" Style="{StaticResource SidebarText}"/>
                            </Button>
                            
                            <Button x:Name="menuOptionReadme" Style="{StaticResource SidebarSubmenuButton}" Click="HandleNavigationClick" Tag="ConfigReadme">
                                <TextBlock Text="Readme" Style="{StaticResource SidebarText}"/>
                            </Button>
                            
                            <Button x:Name="menuOptionStacker" Style="{StaticResource SidebarSubmenuButton}" Click="HandleNavigationClick" Tag="ConfigStacker">
                                <TextBlock Text="Stacker" Style="{StaticResource SidebarText}"/>
                            </Button>
                            
                            <Button x:Name="menuOptionLoliCode" Style="{StaticResource SidebarSubmenuButton}" Click="HandleNavigationClick" Tag="ConfigLoliCode">
                                <TextBlock Text="LoliCode" Style="{StaticResource SidebarText}"/>
                            </Button>

                            <Button x:Name="menuOptionCSharpCode" Style="{StaticResource SidebarSubmenuButton}" Click="HandleNavigationClick" Tag="ConfigCSharpCode">
                                <TextBlock Text="C# Code" Style="{StaticResource SidebarText}"/>
                            </Button>
                            
                            <Button x:Name="menuOptionConfigSettings" Style="{StaticResource SidebarSubmenuButton}" Click="HandleNavigationClick" Tag="ConfigSettings">
                                <TextBlock Text="Settings" Style="{StaticResource SidebarText}"/>
                            </Button>
                        </StackPanel>

                        <!-- Wordlists -->
                        <Button x:Name="menuOptionWordlists" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Wordlists">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FileDocument" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Wordlists" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <!-- Proxies -->
                        <Button x:Name="menuOptionProxies" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Proxies">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ServerNetwork" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Proxies" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SYSTEM" Style="{StaticResource SidebarText}" 
                                  FontSize="11" FontWeight="Bold" Foreground="{StaticResource Modern.ForegroundMuted}" 
                                  Margin="24,16,0,8" Opacity="0.7"/>

                        <!-- Tools -->
                        <Button x:Name="menuOptionTools" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Tools">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Toolbox" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Tools" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <!-- Plugins -->
                        <Button x:Name="menuOptionPlugins" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="Plugins">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Puzzle" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Plugins" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button x:Name="menuOptionSettings" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="OBSettings">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Cog" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="Settings" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                        <!-- RL Settings -->
                        <Button x:Name="menuOptionRLSettings" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="RLSettings">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Wrench" Style="{StaticResource SidebarIcon}"/>
                                <TextBlock Text="RL Settings" Style="{StaticResource SidebarText}"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2" Margin="12,12">
                    <Button x:Name="menuOptionCheckUpdate" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="CheckUpdate" 
                            ToolTip="Check for Updates" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Update" Style="{StaticResource SidebarIcon}" Width="16" Height="16"/>
                            <TextBlock Text="Update" Style="{StaticResource SidebarText}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="menuOptionAbout" Style="{StaticResource SidebarNavButton}" Click="HandleNavigationClick" Tag="About"
                            ToolTip="About" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Information" Style="{StaticResource SidebarIcon}" Width="16" Height="16"/>
                            <TextBlock Text="About" Style="{StaticResource SidebarText}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    
                    <TextBlock Text="v0.3.3.9" Foreground="{StaticResource Modern.ForegroundMuted}" 
                              FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{StaticResource Modern.BackgroundMain}" Padding="20">
            <Grid>
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent" />
                
                <mah:ProgressRing 
                    x:Name="loadingIndicator"
                    IsActive="{Binding IsLoading}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="60" Height="60"
                    Foreground="{StaticResource Modern.ThemeMain}"/>
            </Grid>
        </Border>
    </Grid>

</mah:MetroWindow>
