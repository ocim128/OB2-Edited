<Project>
  <PropertyGroup>
    <AssemblyName>OpenBullet2.Native</AssemblyName>
    <IntermediateOutputPath>obj\Testing\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\user\Documents\Repo\OB2-Edited\OpenBullet2.Native\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>OpenBullet2.Native</_TargetAssemblyProjectName>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>portable</DebugType>
    <!-- Memory-Efficient Build Settings -->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Re-enabled warnings for better code quality -->
    <WarningLevel>4</WarningLevel>
    <!-- Suppress noise warnings (nullable types, WPF analyzer) but keep real bug warnings -->
    <NoWarn>CS0618;CA1416;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8622;CS8625;WFAC010</NoWarn>
    <!-- Enable nullable reference types for better null safety -->
    <Nullable>enable</Nullable>
    <!-- Balanced Performance Settings - Low Memory Impact -->
    <UseSharedCompilation>true</UseSharedCompilation>
    <BuildInParallel>true</BuildInParallel>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Fast Build Optimizations -->
    <UseIncrementalCompilation>true</UseIncrementalCompilation>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <Deterministic>true</Deterministic>
    <UseRidGraph>false</UseRidGraph>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- Runtime Optimizations - Memory Conservative -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <ReadyToRun>false</ReadyToRun>
    <!-- Memory and Binary Size Optimizations -->
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- Re-enable analyzers for code quality -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <!-- Additional Build Optimizations -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <!-- Limit to Windows runtimes only -->
    <RuntimeIdentifier Condition="'$(Configuration)' != 'Release'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Release'">win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <!-- XAML Build Optimizations -->
    <XamlDebuggingInformation>false</XamlDebuggingInformation>
    <SkipMarkupCompilation>false</SkipMarkupCompilation>
    <UseWPF>true</UseWPF>
    <GenerateTemporaryTargetAssembly>false</GenerateTemporaryTargetAssembly>
    <!-- Garbage Collection Settings for Lower Memory -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <!-- Configuration-specific optimizations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <!-- Disable trimming for WinForms/WPF compatibility -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- Size optimizations compatible with WinForms -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <!-- Assembly-level optimizations for performance -->
    <EnableEventLog>false</EnableEventLog>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <!-- Reduce JIT overhead -->
    <ReadyToRun>true</ReadyToRun>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'testing'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <PublishTrimmed>false</PublishTrimmed>
