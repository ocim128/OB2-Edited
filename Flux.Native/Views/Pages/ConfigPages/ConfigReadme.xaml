<Page x:Class="Flux.Native.Views.Pages.Configs.ConfigReadme"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Pages"
      xmlns:uc="clr-namespace:Flux.Native.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="Readme">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0" Grid.Column="0"
            Text="Readme"
            FontWeight="SemiBold"
            FontSize="14"
            Foreground="{DynamicResource ForegroundCustom}"
            Margin="0,0,0,8"/>

        <RichTextBox x:Name="readmeRTB" 
                             Background="{DynamicResource BackgroundSecondary}" 
                             Foreground="{DynamicResource ForegroundMain}" 
                             FontFamily="Consolas"
                             VerticalAlignment="Stretch"
                             Grid.Row="1" Grid.Column="0"
                             TextChanged="ReadmeChanged"
                             BorderBrush="{DynamicResource Modern.BorderMain}" BorderThickness="1" Padding="8">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <GridSplitter 
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Grid.Column="1"
            Grid.RowSpan="2" 
            Width="8"
            VerticalAlignment="Stretch">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource Modern.BorderSecondary}"
                            Opacity="0.5"
                            CornerRadius="2">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                            <Ellipse Width="3" Height="3" Margin="0,1" Fill="{DynamicResource Modern.TextTertiary}" />
                            <Ellipse Width="3" Height="3" Margin="0,1" Fill="{DynamicResource Modern.TextTertiary}" />
                            <Ellipse Width="3" Height="3" Margin="0,1" Fill="{DynamicResource Modern.TextTertiary}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <TextBlock
            Grid.Row="0" Grid.Column="2"
            Text="Preview (type something to update)"
            FontWeight="SemiBold"
            FontSize="14"
            Foreground="{DynamicResource ForegroundCustom}"
            Margin="0,0,0,8"/>

        <uc:MarkdownViewer 
            Grid.Row="1" Grid.Column="2"
            VerticalAlignment="Stretch"
            MarkdownText="{Binding Readme}" />
    </Grid>
</Page>

