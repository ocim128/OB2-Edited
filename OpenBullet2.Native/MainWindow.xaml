<mah:MetroWindow x:Class="OpenBullet2.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBullet2.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
        mc:Ignorable="d"
        Title="OpenBullet 2 - 0.3.3 [Enhanced Edition]" 
        MinWidth="1024" MinHeight="600"
        Background="{DynamicResource BackgroundMain}"
        BorderThickness="1"
        BorderBrush="#FF1E1E1E"
        GlowBrush="#FF3A82F7"
        ResizeMode="CanResizeWithGrip"
        WindowTitleBrush="#FF0F0F0F"
        NonActiveWindowTitleBrush="#FF0A0A0A"
        WindowTransitionsEnabled="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TitleCharacterCasing="Normal"
        TitleForeground="#FFCCCCCC"
        TitleAlignment="Left"
        ShowMinButton="True"
        ShowMaxRestoreButton="True"
        ShowCloseButton="True"
        Icon="/Images/logohq_square_padded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="OnWindowSizeChanged"
        Loaded="OnWindowLoaded">



    <!-- Simplified Title Bar -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding}" 
                      FontFamily="Segoe UI" 
                      FontSize="12" 
                      FontWeight="Medium" 
                      Foreground="#FFCCCCCC" 
                      VerticalAlignment="Center" 
                      Margin="8,0,0,0"/>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!-- Custom Window Button Styles -->
    <!-- Removed duplicate button styles - using ModernTheme.xaml styles for better performance -->

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:CustomCommands.NewConfig}" Gesture="CTRL+N" />
        <KeyBinding Command="{x:Static local:CustomCommands.OpenConfig}" Gesture="CTRL+O" />
        <KeyBinding Command="{x:Static local:CustomCommands.SaveConfig}" Gesture="CTRL+S" />
        <KeyBinding Command="{x:Static local:CustomCommands.Refresh}" Gesture="CTRL+R" />
        <KeyBinding Command="{x:Static local:CustomCommands.Quit}" Gesture="CTRL+Q" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHome}" Gesture="CTRL+D1" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToJobs}" Gesture="CTRL+D2" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToMonitor}" Gesture="CTRL+D3" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToProxies}" Gesture="CTRL+D4" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToWordlists}" Gesture="CTRL+D5" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToConfigs}" Gesture="CTRL+D6" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToHits}" Gesture="CTRL+D7" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToPlugins}" Gesture="CTRL+D8" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToOBSettings}" Gesture="CTRL+D9" />
        <KeyBinding Command="{x:Static local:CustomCommands.NavigateToRLSettings}" Gesture="CTRL+D0" />
    </Window.InputBindings>

    <!-- Responsive Layout Grid -->
    <Grid x:Name="Root">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopNavRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optimized Navigation Header -->
        <Border x:Name="NavigationHeader"
                Grid.Row="0" 
                Background="#FF1E1E1E" 
                CornerRadius="8" 
                BorderBrush="#FF2E2E2E" 
                BorderThickness="1">
            <StackPanel x:Name="topMenu" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <!-- Optimized consolidated TextBlock style -->
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="Foreground" Value="#FFCCCCCC" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="15,8" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF3A82F7" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                
                    <!-- Navigation Menu Items -->
                    <TextBlock x:Name="menuOptionHome" Text="HOME" MouseDown="HandleNavigation" ToolTipService.ToolTip="Main dashboard (Ctrl+1)"/>
                    <TextBlock x:Name="menuOptionJobs" Text="JOBS" MouseDown="HandleNavigation" ToolTipService.ToolTip="Manage checking jobs (Ctrl+2)"/>
                    <TextBlock x:Name="menuOptionMonitor" Text="MONITOR" MouseDown="HandleNavigation" ToolTipService.ToolTip="Monitor running jobs (Ctrl+3)"/>
                    <TextBlock x:Name="menuOptionProxies" Text="PROXIES" MouseDown="HandleNavigation" ToolTipService.ToolTip="Manage proxy lists (Ctrl+4)"/>
                    <TextBlock x:Name="menuOptionWordlists" Text="WORDLISTS" MouseDown="HandleNavigation" ToolTipService.ToolTip="Manage wordlists (Ctrl+5)"/>
                    <TextBlock x:Name="menuOptionConfigs" Text="CONFIGS" MouseDown="HandleNavigation" MouseEnter="ConfigsMenuOptionMouseEnter" MouseLeave="ConfigsMenuOptionMouseLeave" ToolTipService.ToolTip="Browse and edit configs (Ctrl+6)"/>
                    <TextBlock x:Name="menuOptionHits" Text="HITS" MouseDown="HandleNavigation" ToolTipService.ToolTip="View successful hits (Ctrl+7)"/>
                    <TextBlock x:Name="menuOptionPlugins" Text="PLUGINS" MouseDown="HandleNavigation" ToolTipService.ToolTip="Manage plugins (Ctrl+8)"/>
                    <TextBlock x:Name="menuOptionSettings" Text="SETTINGS" MouseDown="HandleNavigation" ToolTipService.ToolTip="OpenBullet settings (Ctrl+9)"/>
                    <TextBlock x:Name="menuOptionRLSettings" Text="RL SETTINGS" MouseDown="HandleNavigation" ToolTipService.ToolTip="RuriLib settings (Ctrl+0)"/>
                    <TextBlock x:Name="menuOptionAbout" Text="ABOUT" MouseDown="HandleNavigation" ToolTipService.ToolTip="About this application"/>
                    <TextBlock x:Name="menuOptionUpdate" Text="CHECK UPDATES" MouseDown="HandleNavigation" ToolTipService.ToolTip="Check for application updates"/>
            </StackPanel>
        </Border>

        <!-- Modern Config Submenu -->
        <Border x:Name="configSubmenu"
                Background="#FF1E1E1E"
                BorderBrush="#FF2E2E2E"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="1000"
                Height="auto"
                Width="160"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                MouseEnter="ConfigSubmenuMouseEnter"
                MouseLeave="ConfigSubmenuMouseLeave"
                Padding="12">
            <StackPanel>
                <StackPanel.Resources>
                    <!-- Submenu Item Style -->
                    <Style TargetType="TextBlock" x:Key="SubmenuItemStyle">
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="#FFCCCCCC" />
                        <Setter Property="FontFamily" Value="Segoe UI" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A82F7" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                
                <!-- Config Editor Menu Items -->
                <TextBlock x:Name="menuOptionMetadata" Text="📝 Metadata" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config metadata"/>
                <TextBlock x:Name="menuOptionReadme" Text="📄 Readme" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config readme"/>
                <TextBlock x:Name="menuOptionStacker" Text="🔧 Stacker" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config stacker"/>
                <TextBlock x:Name="menuOptionLoliCode" Text="💻 LoliCode" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config LoliCode"/>
                <TextBlock x:Name="menuOptionConfigSettings" Text="⚙️ Settings" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config settings"/>
                <TextBlock x:Name="menuOptionCSharpCode" Text="🔷 C# Code" Style="{StaticResource SubmenuItemStyle}" MouseDown="HandleNavigation" ToolTipService.ToolTip="Edit config C# code"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Border x:Name="MainContentBorder"
                Grid.Row="1" 
                Background="Transparent" 
                CornerRadius="8" 
                BorderBrush="#FF333333"
                BorderThickness="1">
            <Frame x:Name="mainFrame" 
                   NavigationUIVisibility="Hidden" 
                   Background="Transparent"
                   BorderThickness="0" />
        </Border>

        <mah:ProgressRing 
            x:Name="loadingIndicator"
            Grid.Row="1"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
    </Grid>

</mah:MetroWindow>
