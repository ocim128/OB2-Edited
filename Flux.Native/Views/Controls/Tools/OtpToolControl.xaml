<UserControl x:Class="Flux.Native.Views.Controls.Tools.OtpToolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d">
    <Border Style="{StaticResource ModernCardLite}"
            Background="{DynamicResource Modern.BackgroundSecondary}"
            Padding="20"
            Visibility="{Binding CardVisibility}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconMaterial Kind="ShieldKey"
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource Modern.Success}"/>
                <TextBlock Text="OTP Toolkit"
                           Style="{StaticResource H3TextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Drop in a Base32 secret and stay synced with rolling 30-second codes."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBox Style="{StaticResource MatchingTextBox}"
                     Margin="0,0,0,10"
                     AutomationProperties.Name="Secret key"
                     ToolTip="Enter a Base32 encoded secret key"
                     CharacterCasing="Upper"
                     Text="{Binding Secret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     AcceptsReturn="False"
                     VerticalContentAlignment="Center"
                     Height="34"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource StyledWarningButton}"
                        Content="Clear"
                        Width="80"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearSecretCommand}"
                        AutomationProperties.Name="Clear secret"
                        ToolTip="Clear the current secret"/>
                <Button Style="{StaticResource StyledPrimaryButton}"
                        Content="Paste"
                        Width="80"
                        Grid.Column="1"
                        Command="{Binding PasteSecretCommand}"
                        AutomationProperties.Name="Paste secret"
                        ToolTip="Paste a secret from the clipboard"/>
            </Grid>

            <Border Background="{DynamicResource Modern.Error}"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource Modern.TextOnAccent}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Current OTP"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding CurrentOtp}"
                               FontSize="36"
                               FontFamily="Segoe UI Semibold"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,6"
                               AutomationProperties.Name="One-time password"/>
                    <ProgressBar Grid.Row="2"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="30"
                                 Value="{Binding ProgressValue}"
                                 AutomationProperties.Name="OTP progress"/>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding StatusMessage}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource StyledSuccessButton}"
                                Content="Copy"
                                Width="70"
                                Margin="12,0,0,0"
                                Command="{Binding CopyOtpCommand}"
                                IsEnabled="{Binding CanCopy}"
                                AutomationProperties.Name="Copy OTP button"
                                ToolTip="Copy the current OTP to the clipboard"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
