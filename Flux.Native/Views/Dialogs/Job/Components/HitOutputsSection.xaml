<UserControl x:Class="Flux.Native.Views.Dialogs.Job.Components.HitOutputsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
             xmlns:ho="clr-namespace:Flux.Core.Models.Hits;assembly=Flux.Core"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <!-- DataTemplates for Hit Outputs -->
        <DataTemplate DataType="{x:Type ho:DatabaseHitOutputOptions}">
            <Border Padding="0,4,0,4" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Database:" 
                               VerticalAlignment="Center" 
                               FontSize="10" 
                               Foreground="{DynamicResource Modern.TextMuted}"/>
                    <TextBlock Grid.Column="1" 
                               Text="No settings required" 
                               VerticalAlignment="Center" 
                               FontSize="10" 
                               Foreground="{DynamicResource Modern.TextMutedLight}"/>
                    <Button Tag="{Binding}" Grid.Column="2" 
                            Click="RemoveHitOutput" 
                            Style="{StaticResource StyledDangerButton}"
                            Width="24" Height="20"
                            Padding="2">
                        <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ho:FileSystemHitOutputOptions}">
            <Border Padding="0,4,0,4" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="File System:" 
                               VerticalAlignment="Center" 
                               FontSize="10" 
                               Foreground="{DynamicResource Modern.TextMuted}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding BaseDir}" 
                             FontSize="10"
                             Margin="2,0"
                             ToolTip="{Binding BaseDir}"/>
                    <Button Tag="{Binding}" Grid.Column="2" 
                            Click="RemoveHitOutput" 
                            Style="{StaticResource StyledDangerButton}"
                            Width="24" Height="20"
                            Padding="2">
                        <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ho:DiscordWebhookHitOutputOptions}">
            <Border Padding="0,4,0,4" Margin="0,0,0,2">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Discord:" 
                                   VerticalAlignment="Center"
                                   FontSize="10" 
                                   Foreground="{DynamicResource Modern.TextMuted}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Webhook}" 
                                 FontSize="10"
                                 Margin="2,0"
                                 ToolTip="Webhook URL"/>
                        <Button Tag="{Binding}" Grid.Column="2" 
                                Click="RemoveHitOutput" 
                                Style="{StaticResource StyledDangerButton}"
                                Width="24" Height="20"
                                Padding="2">
                            <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Username}" 
                                 FontSize="10"
                                 Margin="2,0"
                                 ToolTip="Username"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding AvatarUrl}" 
                                 FontSize="10"
                                 Margin="2,0"
                                 ToolTip="Avatar URL"/>
                        <CheckBox Grid.Column="2"
                                  Content="Hits only"
                                  IsChecked="{Binding OnlyHits}" 
                                  FontSize="9"
                                  Foreground="White"
                                  Margin="2,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ho:TelegramBotHitOutputOptions}">
            <Border Padding="0,4,0,4" Margin="0,0,0,2">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Telegram:" 
                                   VerticalAlignment="Center" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource Modern.TextMuted}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ApiServer}" 
                                 FontSize="10"
                                 Margin="2,0"
                                 ToolTip="API Server"/>
                        <Button Tag="{Binding}" Grid.Column="2" 
                                Click="RemoveHitOutput" 
                                Style="{StaticResource StyledDangerButton}"
                                Width="24" Height="20"
                                Padding="2">
                            <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Token}" 
                                 FontSize="10"
                                 Margin="2,0"
                                 ToolTip="Bot Token"/>
                        <mah:NumericUpDown Grid.Column="1"
                                           Minimum="-2147483648"
                                           Maximum="2147483647"
                                           Interval="1"
                                           Value="{Binding ChatId}"
                                           FontSize="10"
                                           Margin="2,0"
                                           ToolTip="Chat ID"/>
                        <CheckBox Grid.Column="2"
                                  Content="Hits only"
                                  IsChecked="{Binding OnlyHits}" 
                                  FontSize="9"
                                  Foreground="White"
                                  Margin="2,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ho:CustomWebhookHitOutputOptions}">
            <Border Padding="0,4,0,4" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Webhook:" 
                               VerticalAlignment="Center"
                               FontSize="10" 
                               Foreground="{DynamicResource Modern.TextMuted}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Url}" 
                             FontSize="10"
                             Margin="2,0"
                             ToolTip="Webhook URL"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding User}" 
                             FontSize="10"
                             Margin="2,0"
                             ToolTip="User"/>
                    <CheckBox Grid.Column="3"
                              Content="Hits only"
                              IsChecked="{Binding OnlyHits}" 
                              FontSize="9"
                              Foreground="White"
                              Margin="2,0"/>
                    <Button Tag="{Binding}" Grid.Column="4" 
                            Click="RemoveHitOutput" 
                            Style="{StaticResource StyledDangerButton}"
                            Width="24" Height="20"
                            Padding="2">
                        <ContentControl Content="{StaticResource Icon.Close}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ContentControl Style="{StaticResource Icon.Size16}"
                                Content="{StaticResource Icon.DatabaseExport}"
                                Foreground="{StaticResource Icon.SecondaryBlue}"
                                VerticalAlignment="Center"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Hit Outputs" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Route results wherever you need them. Combine multiple outputs if required."
                               FontSize="10"
                               Foreground="{DynamicResource Modern.TextMutedOnDark}"/>
                </StackPanel>
            </StackPanel>
            <!-- Hit Output Buttons -->
            <WrapPanel Margin="0,0,0,8">
                <Button Click="AddDatabaseHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Padding="6,3" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                        <TextBlock Text="DB" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                    </StackPanel>
                </Button>
                <Button Click="AddFileSystemHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Padding="6,3" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                        <TextBlock Text="File" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                    </StackPanel>
                </Button>
                <Button Click="AddDiscordWebhookHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Padding="6,3" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                        <TextBlock Text="Discord" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                    </StackPanel>
                </Button>
                <Button Click="AddTelegramBotHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Padding="6,3" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                        <TextBlock Text="Telegram" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                    </StackPanel>
                </Button>
                <Button Click="AddCustomWebhookHitOutput" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Padding="6,3" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                        <TextBlock Text="Webhook" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="9"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            
            <!-- Hit Outputs List -->
            <Border Background="{DynamicResource Modern.PanelDarkSecondary}"
                    CornerRadius="10"
                    Padding="0"
                    BorderBrush="{DynamicResource Modern.OverlayLight}"
                    BorderThickness="1">
                <ScrollViewer Height="110" 
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10"
                              Background="Transparent"
                              CanContentScroll="True"
                              Focusable="False"
                              PreviewMouseWheel="ChildScrollViewer_PreviewMouseWheel"
                              Style="{StaticResource ModernScrollViewer}">
                    <ItemsControl ItemsSource="{Binding HitOutputsCollection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
