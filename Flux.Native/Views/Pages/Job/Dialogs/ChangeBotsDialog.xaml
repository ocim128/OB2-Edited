<Page x:Class="Flux.Native.Views.Dialogs.Job.ChangeBotsDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="400"
      Title="ChangeBotsDialog"
      Background="Transparent">

    <Border Background="{DynamicResource Modern.BackgroundSecondary}" 
            CornerRadius="12"
            BorderBrush="{DynamicResource Modern.BorderMain}"
            BorderThickness="1"
            Padding="24"
            MinWidth="360"
            MaxWidth="480">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        Margin="0,0,0,16">
                <iconPacks:PackIconMaterial Kind="RobotOutline"
                                            Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource Modern.ThemeMain}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"/>
                <TextBlock Text="Change Bots"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Modern.ForegroundMain}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="1" 
                       Text="Set the number of bots for this job."
                       FontSize="13"
                       Foreground="{DynamicResource Modern.ForegroundSecondary}"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <!-- Numeric Input -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource Modern.BackgroundInput}" 
                    CornerRadius="6" 
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20">
                <mah:NumericUpDown
                    x:Name="bots"
                    Minimum="1"
                    Maximum="200"
                    Interval="1"
                    Width="150"
                    Background="Transparent"
                    BorderThickness="0"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="Cancel"
                        Style="{StaticResource StyledButton}"
                        Width="90"
                        Margin="0,0,10,0"/>
                <Button Content="Ok"
                        Click="Accept"
                        Style="{StaticResource StyledPrimaryButton}"
                        Width="90"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
