<Page x:Class="Flux.Native.Views.Dialogs.Job.ProxyCheckJobOptionsDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Dialogs.Job"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:uc="clr-namespace:Flux.Native.Controls"
      xmlns:ho="clr-namespace:Flux.Core.Models.Hits;assembly=Flux.Core"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="980"
      Title="ProxyCheckJobOptionsDialog"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.BitmapScalingMode="HighQuality"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Compact Section Card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#C0353535"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Section Header Text -->
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1E90FF"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Compact Label -->
        <Style x:Key="CompactLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Compact Input Controls -->
        <Style x:Key="CompactComboBox" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style x:Key="CompactNumeric" TargetType="mah:NumericUpDown">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Page.Resources>

    <!-- Layout -->
    <Grid Background="Transparent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#FF1E90FF" CornerRadius="10" Padding="10" VerticalAlignment="Center">
                    <ContentControl Content="{StaticResource Icon.Cog}" Width="18" Height="18" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Job Configuration" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Proxy Check" FontSize="12" Foreground="#FF9CA3AF"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Start Condition -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Start Condition" Style="{StaticResource SectionHeaderText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="startInButton" Content="Start in" IsChecked="{Binding StartInMode}" Foreground="White" FontSize="11" Margin="0,0,12,0"/>
                            <RadioButton x:Name="startAtButton" Content="Start at" IsChecked="{Binding StartAtMode}" Foreground="White" FontSize="11"/>
                        </StackPanel>
                        <TabControl x:Name="startConditionTabControl" Background="Transparent" BorderThickness="0">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="{x:Type TabItem}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem>
                                <uc:TimeSpanPicker TimeSpan="{Binding StartIn, Mode=TwoWay}" />
                            </TabItem>
                            <TabItem>
                                <StackPanel Orientation="Horizontal">
                                    <mah:DateTimePicker Width="200" SelectedTimeFormat="Long" SelectedDateTime="{Binding StartAtTime, Mode=TwoWay}" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource SectionHeaderText}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bots -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bots" Style="{StaticResource CompactLabel}"/>
                            <mah:NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="{Binding BotLimit}" Interval="1" Value="{Binding Bots}" Style="{StaticResource CompactNumeric}"/>

                            <!-- Timeout -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Timeout (ms)" Style="{StaticResource CompactLabel}"/>
                            <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000000" Interval="1000" Value="{Binding TimeoutMilliseconds}" Style="{StaticResource CompactNumeric}"/>

                            <!-- Proxy group -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Proxy group" Style="{StaticResource CompactLabel}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ProxyGroupNames}" SelectedValue="{Binding ProxyGroup}" Style="{StaticResource CleanComboBox}"/>

                            <!-- Check only untested -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Filter" Style="{StaticResource CompactLabel}"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" Content="Check only untested" IsChecked="{Binding CheckOnlyUntested}" Style="{StaticResource CompactCheckBox}"/>

                            <!-- Target -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Check on website" Style="{StaticResource CompactLabel}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Targets}" SelectedValue="{Binding Target}" Style="{StaticResource CleanComboBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Click="Accept" Margin="12,8,0,0" Style="{StaticResource StyledSuccessButton}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconOcticons Kind="Check" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Accept</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
