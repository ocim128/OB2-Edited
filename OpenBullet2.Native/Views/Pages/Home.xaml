<Page x:Class="OpenBullet2.Native.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="Home"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Gradient Brushes for Visual Polish -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="CpuGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#60A5FA" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="MemoryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#34D399" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="UptimeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#FBBF24" Offset="1"/>
        </LinearGradientBrush>

        <!-- Section Header with Gradient Accent -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernHeading3}">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        
        <!-- Premium Metric Card with Hover Animation -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="100"/>
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.02" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.02" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Collection Stats Card - Interactive -->
        <Style x:Key="CollectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="85"/>
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.03" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.03" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium Quick Action Button -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Height" Value="110"/>
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Modern.ThemeMain}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.02" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.02" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Metric Value Style -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        
        <!-- Metric Label Style -->
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernCaptionText}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        
        <!-- Icon Container Style -->
        <Style x:Key="IconContainerStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <!-- Premium Progress Bar Style -->
        <Style x:Key="PremiumProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Track" CornerRadius="3">
                                <Border x:Name="PART_Indicator" 
                                        HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{TemplateBinding Foreground}"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  VirtualizingPanel.IsVirtualizing="True" 
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
        <Grid Margin="20,16,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- System Performance Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="System Performance" 
                               Style="{StaticResource SectionHeaderStyle}" 
                               Margin="0"/>
                    <Border Grid.Column="1" 
                            HorizontalAlignment="Right" 
                            Padding="8,4" 
                            CornerRadius="4" 
                            Background="{StaticResource Modern.BackgroundTertiary}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Modern.Success}" Margin="0,0,6,0"/>
                            <TextBlock Text="Live" FontSize="11" Foreground="{StaticResource Modern.Success}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- CPU Usage Card -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Icon Container Removed -->
                            
                            <TextBlock Grid.Row="1" Text="CPU Usage" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Grid.Row="2" Text="{Binding CpuUsage, StringFormat='{}{0}'}" 
                                       Style="{StaticResource MetricValueStyle}"/>
                            
                            <ProgressBar Grid.Row="3" 
                                         Value="{Binding CpuUsagePercent}" 
                                         Style="{StaticResource PremiumProgressBar}"
                                         Foreground="{StaticResource CpuGradient}"
                                         Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Memory Usage Card -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            

                            
                            <TextBlock Grid.Row="1" Text="Memory" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Grid.Row="2" Text="{Binding MemoryUsage}" 
                                       Style="{StaticResource MetricValueStyle}"/>
                            
                            <ProgressBar Grid.Row="3" 
                                         Value="{Binding MemoryUsagePercent}" 
                                         Style="{StaticResource PremiumProgressBar}"
                                         Foreground="{StaticResource MemoryGradient}"
                                         Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Uptime Card -->
                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            

                            
                            <TextBlock Grid.Row="1" Text="Uptime" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Grid.Row="2" Text="{Binding ApplicationUptime}" 
                                       Style="{StaticResource MetricValueStyle}"/>
                            
                            <TextBlock Grid.Row="3" 
                                       Text="Session running time" 
                                       Style="{StaticResource ModernCaptionText}"
                                       Opacity="0.6"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Quick Actions Section -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Text="Quick Actions" 
                           Style="{StaticResource SectionHeaderStyle}" 
                           Margin="0,0,0,14"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Configs Shortcut -->
                    <Button Grid.Column="0" 
                            Name="ConfigsShortcut"
                            Click="ConfigsShortcut_Click"
                            Style="{StaticResource QuickActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#1E3A5F" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Cog" 
                                                            Width="22" Height="22" 
                                                            Foreground="{StaticResource Modern.ThemeMain}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Configs" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                            <TextBlock Text="Manage scripts" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Jobs Shortcut -->
                    <Button Grid.Column="2" 
                            Name="JobsShortcut"
                            Click="JobsShortcut_Click"
                            Style="{StaticResource QuickActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#312E81" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Briefcase" 
                                                            Width="22" Height="22" 
                                                            Foreground="{StaticResource Modern.ThemeAccent}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Jobs" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                            <TextBlock Text="Run tasks" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Wordlists Shortcut -->
                    <Button Grid.Column="4" 
                            Name="WordlistsShortcut"
                            Click="WordlistsShortcut_Click"
                            Style="{StaticResource QuickActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#064E3B" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" 
                                                            Width="22" Height="22" 
                                                            Foreground="{StaticResource Modern.Success}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Wordlists" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                            <TextBlock Text="Data sources" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Hits Shortcut -->
                    <Button Grid.Column="6" 
                            Name="HitsShortcut"
                            Click="HitsShortcut_Click"
                            Style="{StaticResource QuickActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#7F1D1D" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Target" 
                                                            Width="22" Height="22" 
                                                            Foreground="{StaticResource Modern.Error}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Hits" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                            <TextBlock Text="View results" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Your Collection Section -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Your Collection" 
                           Style="{StaticResource SectionHeaderStyle}" 
                           Margin="0,0,0,14"/>
                
                <!-- Primary Collection Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Jobs Count -->
                    <Border Grid.Column="0" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Jobs" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding JobsCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Proxies Count -->
                    <Border Grid.Column="2" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Proxies" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ProxiesCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Wordlists Count -->
                    <Border Grid.Column="4" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Wordlists" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WordlistsCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Lines Count -->
                    <Border Grid.Column="6" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Lines" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WordlistLines}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Secondary Collection Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Hits Count -->
                    <Border Grid.Column="0" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Hits" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HitsCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Configs Count -->
                    <Border Grid.Column="2" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Configs" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ConfigsCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Guests Count -->
                    <Border Grid.Column="4" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Guests" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GuestsCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Plugins Count -->
                    <Border Grid.Column="6" Style="{StaticResource CollectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Plugins" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PluginsCount}" 
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Modern.ForegroundMain}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
