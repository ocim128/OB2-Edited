<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>logo.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <DebugType>portable</DebugType>
        <!-- Memory-Efficient Build Settings -->
        <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <!-- Re-enabled warnings for better code quality -->
        <WarningLevel>4</WarningLevel>
        <!-- Suppress noise warnings (nullable types, WPF analyzer) but keep real bug warnings -->
        <NoWarn>CS0618;CA1416;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8622;CS8625;WFAC010</NoWarn>
        <!-- Enable nullable reference types for better null safety -->
        <Nullable>enable</Nullable>
        <!-- Balanced Performance Settings - Low Memory Impact -->
        <UseSharedCompilation>true</UseSharedCompilation>
        <BuildInParallel>true</BuildInParallel>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <!-- Fast Build Optimizations -->
        <UseIncrementalCompilation>true</UseIncrementalCompilation>
        <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
        <Deterministic>true</Deterministic>
        <UseRidGraph>false</UseRidGraph>
        <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
        <!-- Runtime Optimizations - Memory Conservative -->
        <TieredCompilation>true</TieredCompilation>
        <TieredPGO>true</TieredPGO>
        <ReadyToRun>false</ReadyToRun>
        <!-- Memory and Binary Size Optimizations -->
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
        <!-- Re-enable analyzers for code quality -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <!-- Additional Build Optimizations -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
        <!-- Limit to Windows runtimes only -->
        <RuntimeIdentifier Condition="'$(Configuration)' != 'Release'">win-x64</RuntimeIdentifier>
        <RuntimeIdentifiers Condition="'$(Configuration)' == 'Release'">win-x64;win-x86;win-arm64</RuntimeIdentifiers>
        <!-- XAML Build Optimizations -->
        <XamlDebuggingInformation>false</XamlDebuggingInformation>
        <SkipMarkupCompilation>false</SkipMarkupCompilation>
        <UseWPF>true</UseWPF>
        <GenerateTemporaryTargetAssembly>false</GenerateTemporaryTargetAssembly>
        <!-- Garbage Collection Settings for Lower Memory -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>
    <!-- Configuration-specific optimizations -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
        <!-- Disable trimming for WinForms/WPF compatibility -->
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
        <!-- Size optimizations compatible with WinForms -->
        <IlcOptimizationPreference>Size</IlcOptimizationPreference>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <!-- Assembly-level optimizations for performance -->
        <EnableEventLog>false</EnableEventLog>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <InvariantGlobalization>false</InvariantGlobalization>
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <UseNativeHttpHandler>true</UseNativeHttpHandler>
        <!-- Reduce JIT overhead -->
        <ReadyToRun>true</ReadyToRun>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'testing'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <!-- Prevent creating target framework folder in output -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <!-- Essential Content Files -->
    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Sounds\*.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Sounds\hit.wav">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="user-agents.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Images\logohq.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Images\logohq_square_padded.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Images\logohq_square_padded_bg.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="logo.ico">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <!-- Core Dependencies Only -->
    <ItemGroup>
        <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
        <PackageReference Include="HtmlSanitizer" Version="8.1.866-beta" />
        <PackageReference Include="MahApps.Metro" Version="2.4.10" />
        <!-- Essential Icon Packs Only - Removed unused packs for performance -->
        <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.MaterialDesign" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.FontAwesome" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Entypo" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.RemixIcon" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Unicons" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.Octicons" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.BoxIcons" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.RadixIcons" Version="4.8.0" />
        <PackageReference Include="MahApps.Metro.IconPacks.ForkAwesome" Version="4.8.0" />
        <!-- Removed unused icon packs to reduce build size -->
        <PackageReference Include="MahApps.Metro.SimpleChildWindow" Version="2.2.1" />
        <PackageReference Include="Markdig" Version="0.37.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
        <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
        <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
        <PackageReference Include="Microsoft.Playwright" Version="1.41.0" />
        <PackageReference Include="TlsClient.Native" Version="0.4.3" />
        <PackageReference Include="TlsClient.Native.win-x64" Version="1.9.1" />
    </ItemGroup>
    
    <!-- Exclude non-Windows runtimes to save disk space -->
    
    <!-- Remove non-Windows runtime assets -->
     <Target Name="RemoveNonWindowsRuntimes" AfterTargets="Publish">
         <ItemGroup>
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\android-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\ios-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\iossimulator-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\linux-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\osx-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\maccatalyst-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\tvos-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\tvossimulator-*" />
             <NonWindowsRuntimeDirs Include="$(PublishDir)runtimes\browser-*" />
         </ItemGroup>
         <RemoveDir Directories="@(NonWindowsRuntimeDirs)" ContinueOnError="true" />
         <Message Text="Removed non-Windows runtime directories to save disk space" Importance="high" />
      </Target>
    
    <!-- Remove unnecessary IronPython lib folder to reduce build size -->
    <Target Name="RemoveIronPythonLibFolder" AfterTargets="Publish">
        <ItemGroup>
            <IronPythonLibFiles Include="$(PublishDir)lib\**" />
            <IronPythonLibDir Include="$(PublishDir)lib\" />
        </ItemGroup>
        <Delete Files="@(IronPythonLibFiles)" ContinueOnError="true" />
        <RemoveDir Directories="@(IronPythonLibDir)" ContinueOnError="true" />
        <Message Text="Removed IronPython lib folder to reduce build size" Importance="high" />
    </Target>
    <!-- Project References -->
    <ItemGroup>
        <ProjectReference Include="..\OpenBullet2.Core\OpenBullet2.Core.csproj" />
        <ProjectReference Include="..\OpenBullet2.Shared\OpenBullet2.Shared.csproj" />
    </ItemGroup>
    <!-- Syntax Highlighting Files -->
    <ItemGroup>
        <None Update="Highlighting\CSharp.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Highlighting\JavaScript.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Highlighting\LoliCode.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="Highlighting\MarkDown.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Highlighting\Python.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="version.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="dbip-country-lite.mmdb">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!-- Exclude oldfiles folder and other unnecessary files from build -->
    <ItemGroup>
        <Compile Remove="oldfiles\**" />
        <EmbeddedResource Remove="oldfiles\**" />
        <None Remove="oldfiles\**" />
        <Page Remove="oldfiles\**" />
        <Content Remove="oldfiles\**" />
        <!-- Exclude documentation files from build -->
        <None Remove="*.md" />
        <Content Remove="*.md" />
        <!-- Exclude temporary and log files -->
        <None Remove="crash.log" />
        <None Remove="*.log" />
        <None Remove="*.tmp" />
        <!-- Exclude additional unnecessary files -->
        <None Remove="*.pdb" />
        <None Remove="*.xml" />
        <Content Remove="*.pdb" />
        <Content Remove="*.xml" />
        <!-- Exclude test and development files -->
        <None Remove="test\**" />
        <None Remove="tests\**" />
        <None Remove="*.test.*" />
        <Content Remove="test\**" />
        <Content Remove="tests\**" />
        <Content Remove="*.test.*" />
    </ItemGroup>
    
    <ItemGroup>
        <!-- Exclude Playwright browser folder to reduce build size -->
        <None Remove=".playwright\**" />
        <Content Remove=".playwright\**" />
        <EmbeddedResource Remove=".playwright\**" />
    </ItemGroup>
    
    <!-- Trim unused assemblies and dependencies -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <TrimmerRootAssembly Include="OpenBullet2.Native" />
        <TrimmerRootAssembly Include="OpenBullet2.Core" />
        <TrimmerRootAssembly Include="RuriLib" />
    </ItemGroup>
    
    <Target Name="CopyTlsClientNative" AfterTargets="Publish">
        <ItemGroup>
            <TlsClientSource Include="$(OutputPath)\runtimes\tls-client\win\x64\tls-client.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(TlsClientSource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
        <Message Text="Copied tls-client.dll to publish directory" Importance="high" />
    </Target>
</Project>

