<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Consolidated Icon Resources -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Flux.Native;component/Styles/ConsolidatedIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Modern Color Palette -->
    <SolidColorBrush x:Key="Modern.ThemeMain" Color="#2563EB" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ThemeAccent" Color="#8B5CF6" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ThemeSecondary" Color="#1D4ED8" po:Freeze="False" />
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="Modern.BackgroundMain" Color="#F8FAFC" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundSecondary" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundTertiary" Color="#E2E8F0" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundInput" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundCard" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundElevated" Color="#E2E8F0" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundHover" Color="#E2E8F0" po:Freeze="False" />
    
    <!-- Foreground Colors -->
    <SolidColorBrush x:Key="Modern.ForegroundMain" Color="#0F172A" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ForegroundSecondary" Color="#334155" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ForegroundMuted" Color="#64748B" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ForegroundInput" Color="#0F172A" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.TextSecondary" Color="#64748B" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.TextOnAccent" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.TextTertiary" Color="#94A3B8" po:Freeze="False" />
    
    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="Modern.Success" Color="#10B981" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.Warning" Color="#F59E0B" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.Error" Color="#EF4444" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.Info" Color="#3B82F6" po:Freeze="False" />
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="Modern.BorderMain" Color="#CBD5E1" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BorderSecondary" Color="#E2E8F0" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BorderInput" Color="#CBD5E1" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BorderFocus" Color="#2563EB" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BorderHover" Color="#94A3B8" po:Freeze="False" />

    <!-- Page-Specific Background Colors (for dark panel backgrounds) -->
    <SolidColorBrush x:Key="Modern.BackgroundDark" Color="#F1F5F9" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundDarkSecondary" Color="#E2E8F0" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BackgroundDarkTertiary" Color="#CBD5E1" po:Freeze="False" />
    
    <!-- Job Status Colors -->
    <SolidColorBrush x:Key="Modern.StatusRunning" Color="#3B82F6" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.StatusPaused" Color="#F59E0B" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.StatusStopped" Color="#6B7280" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.StatusCompleted" Color="#10B981" po:Freeze="False" />


    <!-- ================================================================ -->
    <!-- GRADIENT COLORS (for progress bars, charts, decorative elements) -->
    <!-- ================================================================ -->
    
    <!-- Blue Gradient (CPU, Primary actions) -->
    <Color x:Key="Modern.Color.GradientBlueStart">#3B82F6</Color>
    <Color x:Key="Modern.Color.GradientBlueEnd">#60A5FA</Color>
    <LinearGradientBrush x:Key="Modern.Gradient.Blue" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#60A5FA" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Green Gradient (Memory, Success states) -->
    <Color x:Key="Modern.Color.GradientGreenStart">#10B981</Color>
    <Color x:Key="Modern.Color.GradientGreenEnd">#34D399</Color>
    <LinearGradientBrush x:Key="Modern.Gradient.Green" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#34D399" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Orange Gradient (Uptime, Warning states) -->
    <Color x:Key="Modern.Color.GradientOrangeStart">#F59E0B</Color>
    <Color x:Key="Modern.Color.GradientOrangeEnd">#FBBF24</Color>
    <LinearGradientBrush x:Key="Modern.Gradient.Orange" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F59E0B" Offset="0"/>
        <GradientStop Color="#FBBF24" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Purple Gradient (Accent, Headers) -->
    <Color x:Key="Modern.Color.GradientPurpleStart">#3B82F6</Color>
    <Color x:Key="Modern.Color.GradientPurpleEnd">#8B5CF6</Color>
    <LinearGradientBrush x:Key="Modern.Gradient.Header" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Red Gradient (Error, Danger states) -->
    <LinearGradientBrush x:Key="Modern.Gradient.Red" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EF4444" Offset="0"/>
        <GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- ================================================================ -->
    <!-- CHART SERIES COLORS -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="Modern.ChartSeries1" Color="#3B82F6" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ChartSeries2" Color="#10B981" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ChartSeries3" Color="#8B5CF6" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ChartSeries4" Color="#F59E0B" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ChartSeries5" Color="#EF4444" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ChartSeries6" Color="#06B6D4" po:Freeze="False" />
    
    <!-- Chart line/fill with alpha -->
    <Color x:Key="Modern.Color.ChartLine">#FF3B82F6</Color>
    <Color x:Key="Modern.Color.ChartFill">#303B82F6</Color>
    
    <!-- ================================================================ -->
    <!-- DIALOG & PANEL BACKGROUNDS (for dark-themed panels/dialogs) -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="Modern.DialogBackground" Color="#1F2937" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DialogBackgroundAlt" Color="#111827" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.PanelDark" Color="#1C2030" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.PanelDarkSecondary" Color="#1B1E2B" po:Freeze="False" />
    
    <!-- ================================================================ -->
    <!-- DARK PANEL (BotLog / terminal-style dark surfaces) -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="Modern.BotLogBackground" Color="#0F1419" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BotLogPanel" Color="#1C2433" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BotLogTerminal" Color="#161616" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BotLogInputBackground" Color="#121B29" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BotLogBorder" Color="#27324A" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.BotLogInputBorder" Color="#303D55" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DarkBorder" Color="#374151" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DarkFocusBorder" Color="#4C72FF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DarkFocusShadow" Color="#81A1FF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DarkHoverBackground" Color="#4B5563" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.InfoLight" Color="#60A5FA" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ForegroundOnDark" Color="#F8FAFC" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DarkSeparator" Color="#374151" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.DarkTextMuted" Color="#9CA3AF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.SearchInputBackground" Color="#0E1726" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.SearchHoverBackground" Color="#374151" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.MatchInfoBackground" Color="#1F2A3D" po:Freeze="False" />
    
    <!-- Dialog gradient backgrounds -->
    <LinearGradientBrush x:Key="Modern.Gradient.DialogBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#121520" Offset="0"/>
        <GradientStop Color="#1B1F2C" Offset="0.6"/>
        <GradientStop Color="#11141E" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="Modern.Gradient.CardDark" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2F44" Offset="0"/>
        <GradientStop Color="#232839" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- ================================================================ -->
    <!-- OVERLAY & TRANSPARENCY COLORS -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="Modern.OverlayLight" Color="#22FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.OverlayMedium" Color="#30FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.OverlayShadow" Color="#AA000000" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.TextMuted" Color="#B0B0B0" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.TextMutedLight" Color="#CCCCCC" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.TextMutedOnDark" Color="#99FFFFFF" po:Freeze="False" />
    
    <!-- ================================================================ -->
    <!-- BUTTON HOVER/PRESSED STATE COLORS -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="Modern.ThemeMainHover" Color="#2563EB" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ThemeMainPressed" Color="#1D4ED8" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.SuccessHover" Color="#059669" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.SuccessPressed" Color="#047857" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.WarningHover" Color="#D97706" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.WarningPressed" Color="#B45309" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ErrorHover" Color="#DC2626" po:Freeze="False" />
    <SolidColorBrush x:Key="Modern.ErrorPressed" Color="#B91C1C" po:Freeze="False" />
    
    <!-- ================================================================ -->
    <!-- LEGACY COMPATIBILITY (for gradual migration) -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="ForegroundMain" Color="#0F172A" po:Freeze="False" />
    <SolidColorBrush x:Key="ForegroundMenuSelected" Color="#2563EB" po:Freeze="False" />
    <!-- Shadow Effects -->
    <DropShadowEffect x:Key="ModernShadow" BlurRadius="8" Direction="270" Opacity="0.12" ShadowDepth="2" />

    <!-- ================================================================ -->
    <!-- MODERN FLAT DESIGN - NO SHADOWS -->
    <!-- ================================================================ -->

    <!-- ================================================================ -->
    <!-- MODERN BUTTON STYLES -->
    <!-- ================================================================ -->

    <!-- Optimized Modern Button Styles with Enhanced Depth -->
    <Style x:Key="ModernButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderMain}" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Flat design - no transforms or effects -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Modern.BackgroundHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Modern.BackgroundTertiary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderFocus}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderFocus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern Button Style Alias (for backward compatibility) -->
    <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}" />

    <!-- Modern Primary Button -->
    <Style x:Key="ModernPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="{StaticResource Modern.ThemeMain}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.ThemeMain}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="BorderBrush" Value="#2563EB" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#1D4ED8" />
                <Setter Property="BorderBrush" Value="#1D4ED8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern Success Button -->
    <Style x:Key="ModernSuccessButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="{StaticResource Modern.Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Success}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#059669" />
                <Setter Property="BorderBrush" Value="#059669" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#047857" />
                <Setter Property="BorderBrush" Value="#047857" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern Warning Button -->
    <Style x:Key="ModernWarningButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="{StaticResource Modern.Warning}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Warning}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D97706" />
                <Setter Property="BorderBrush" Value="#D97706" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#B45309" />
                <Setter Property="BorderBrush" Value="#B45309" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- FLUENT DANGER BUTTON -->
    <Style x:Key="ModernDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="{StaticResource Modern.Error}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Error}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DC2626" />
                <Setter Property="BorderBrush" Value="#DC2626" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#B91C1C" />
                <Setter Property="BorderBrush" Value="#B91C1C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ -->
    <!-- PERFORMANCE-OPTIMIZED INPUT CONTROLS -->
    <!-- ================================================================ -->

    <!-- Modern TextBox Style -->
    <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderInput}" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundInput}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderFocus}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern ComboBox Style -->
    <Style x:Key="ModernComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderInput}" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundInput}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
    </Style>

    <!-- Animated Status Indicator Styles -->
    <Style x:Key="StatusIndicatorBase" TargetType="Border">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success Status Indicator -->
    <Style x:Key="SuccessStatusIndicator" TargetType="Border" BasedOn="{StaticResource StatusIndicatorBase}">
        <Setter Property="Background" Value="{StaticResource Modern.Success}" />
    </Style>

    <!-- Error Status Indicator -->
    <Style x:Key="ErrorStatusIndicator" TargetType="Border" BasedOn="{StaticResource StatusIndicatorBase}">
        <Setter Property="Background" Value="{StaticResource Modern.Error}" />
    </Style>

    <!-- Warning Status Indicator -->
    <Style x:Key="WarningStatusIndicator" TargetType="Border" BasedOn="{StaticResource StatusIndicatorBase}">
        <Setter Property="Background" Value="{StaticResource Modern.Warning}" />
    </Style>

    <!-- Processing Status Indicator -->
    <Style x:Key="ProcessingStatusIndicator" TargetType="Border" BasedOn="{StaticResource StatusIndicatorBase}">
        <Setter Property="Background" Value="{StaticResource Modern.Info}" />
    </Style>

    <!-- Performance-Optimized Modern Card Style with Enhanced Depth -->
    <Style x:Key="ModernCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderMain}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Flat design - no shadows or transforms -->
        <!-- Flat design - no hover animations -->
    </Style>
    
    <!-- Lightweight Card Style for Low-Spec Systems -->
    <Style x:Key="ModernCardLite" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderMain}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- No shadow for maximum performance -->
    </Style>

    <!-- Modern Typography -->
    <Style x:Key="ModernHeading1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Modern.TextOnAccent}" />
        <Setter Property="LineHeight" Value="40" />
    </Style>

    <Style x:Key="ModernHeading2" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style x:Key="ModernHeading3" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="ModernBodyText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="ModernBodyTextSecondary" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundSecondary}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="ModernCaptionText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMuted}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <!-- Modern CheckBox Style -->
    <Style x:Key="ModernCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Modern Menu Item Style -->
    <Style x:Key="ModernMenuItem" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundSecondary}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
                <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern Progress Ring -->
    <Style x:Key="ModernProgressRing" TargetType="{x:Type mah:ProgressRing}" BasedOn="{StaticResource MahApps.Styles.ProgressRing}">
        <Setter Property="Foreground" Value="{StaticResource Modern.ThemeMain}" />
    </Style>

    <!-- Sidebar Container Style -->
    <Style x:Key="ModernSidebar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderMain}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Sidebar Navigation Button Style -->
    <Style x:Key="SidebarNavButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                           Background="{TemplateBinding Background}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           CornerRadius="6"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Active Indicator (Left Bar) - Hidden by default -->
                            <Border x:Name="ActiveIndicator" 
                                    Width="3" 
                                    Height="20" 
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource Modern.ThemeMain}"
                                    CornerRadius="1.5"
                                    Visibility="Collapsed"
                                    Margin="-4,0,0,0"/>

                            <ContentPresenter x:Name="ContentPresenter"
                                            Grid.ColumnSpan="2"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            UseLayoutRounding="True"
                                            SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Modern.BackgroundTertiary}" />
                            <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundMain}" />
                        </Trigger>
                        
                        <!-- Pressed State -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Modern.ThemeMain}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Active Button Style (For when a page is selected) -->
    <Style x:Key="SidebarNavButtonActive" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarNavButton}">
        <Setter Property="Background" Value="{StaticResource Modern.BackgroundTertiary}" />
        <Setter Property="Foreground" Value="{StaticResource Modern.ThemeMain}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                           Background="{TemplateBinding Background}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           CornerRadius="6"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Active Indicator (Left Bar) - VISIBLE -->
                            <Border x:Name="ActiveIndicator" 
                                    Width="3" 
                                    Height="20" 
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource Modern.ThemeMain}"
                                    CornerRadius="1.5"
                                    Visibility="Visible" 
                                    Margin="-4,0,0,0"/>

                            <ContentPresenter x:Name="ContentPresenter"
                                            Grid.ColumnSpan="2"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            UseLayoutRounding="True"
                                            SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Icon Style -->
    <Style x:Key="SidebarIcon" TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sidebar Text Style -->
    <Style x:Key="SidebarText" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Submenu Item Style -->
    <Style x:Key="SidebarSubmenuButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarNavButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="42,8,16,8" /> <!-- Indented -->
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="8,1" />
    </Style>

    <!-- Sidebar Toggle Button Style (Hamburger Menu) -->
    <Style x:Key="SidebarToggleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarNavButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- REMOVED: Duplicate ModernScrollViewer style - using consolidated version from AppStyles.xaml -->
    
    <!-- REMOVED: Unused MetricCard and ModernIcon styles for better load performance -->

    <!-- Enhanced Modern Tooltip Style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#1F2937" Opacity="0.95" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderMain}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Modern.TextOnAccent}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Modern.TextOnAccent}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Flat design - no shadow effects -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Name="Border"
                           Background="{TemplateBinding Background}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           CornerRadius="8"
                           Effect="{TemplateBinding Effect}"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="0.95" ScaleY="0.95" />
                                <TranslateTransform x:Name="TranslateTransform" Y="5" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         TextElement.Foreground="{TemplateBinding Foreground}"
                                         UseLayoutRounding="True"
                                         SnapsToDevicePixels="True" />
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Smooth entrance animation -->
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                       From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       From="0.95" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       From="0.95" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TranslateTransform"
                                                       Storyboard.TargetProperty="Y"
                                                       From="5" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Tooltip Style with Key for explicit references -->
    <Style x:Key="ModernToolTip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}" />
    
    <!-- Ensure MahApps controls that reference this explicit key reuse our readable tooltip style -->
    <Style x:Key="MahApps.Styles.ToolTip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}" />

    <!-- Status Tooltip Style for Dynamic Status Information -->
    <Style x:Key="StatusTooltip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#0F172A" Opacity="0.98" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Error Tooltip Style -->
    <Style x:Key="ErrorTooltip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#7F1D1D" Opacity="0.95" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Error}" />
        <!-- Flat design - no shadow effects -->
    </Style>

    <!-- ================================================================ -->
    <!-- DIALOG SHARED STYLES (Phase 3: Consistency)                     -->
    <!-- ================================================================ -->
    
    <!-- Dialog Root Container - use on main Grid of dialog pages -->
    <Style x:Key="Dialog.Container" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource Modern.Gradient.DialogBackground}"/>
    </Style>
    
    <!-- Dialog Section Card - bordered card for grouping content -->
    <Style x:Key="Dialog.SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Modern.Gradient.CardDark}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.OverlayMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    <!-- Dialog Header Text - primary title -->
    <Style x:Key="Dialog.HeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundMain}"/>
    </Style>
    
    <!-- Dialog Subtitle Text - secondary description -->
    <Style x:Key="Dialog.SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundSecondary}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    
    <!-- Dialog Section Header - title for sections -->
    <Style x:Key="Dialog.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.ThemeMain}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    
    <!-- Dialog Label - field labels -->
    <Style x:Key="Dialog.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    
    <!-- Dialog Muted Text - less prominent text -->
    <Style x:Key="Dialog.MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.TextMuted}"/>
    </Style>
    
    <!-- Dialog List Item Label - labels inside lists -->
    <Style x:Key="Dialog.ListItemLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- Dialog Footer Container -->
    <Style x:Key="Dialog.Footer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Modern.Gradient.CardDark}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.OverlayMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
    <!-- Dialog Footer Instructions - help text in footer -->
    <Style x:Key="Dialog.FooterInstruction" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.TextMuted}"/>
    </Style>
    
    <!-- Dialog Footer Note - secondary note text -->
    <Style x:Key="Dialog.FooterNote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.TextMutedOnDark}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    
    <!-- Dialog List Container - for scrollable lists -->
    <Style x:Key="Dialog.ListContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Modern.PanelDarkSecondary}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.OverlayLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
    <!-- Dialog Input Container - for form inputs within dialogs -->
    <Style x:Key="Dialog.InputContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Modern.PanelDark}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.OverlayLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- ================================================================ -->
    <!-- ACCESSIBILITY STYLES (Phase 5: Focus States & Visual Polish)   -->
    <!-- ================================================================ -->
    
    <!-- Focus Ring Effect - High contrast focus indicator for accessibility -->
    <Style x:Key="Accessibility.FocusRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.ThemeMain}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Focus Ring Color Resources -->
    <SolidColorBrush x:Key="Modern.FocusRing" Color="#60A5FA" po:Freeze="False"/>
    <SolidColorBrush x:Key="Modern.FocusRingAlt" Color="#93C5FD" po:Freeze="False"/>
    
    <!-- High Contrast Skip Link (for screen readers) -->
    <SolidColorBrush x:Key="Modern.SkipLinkBackground" Color="#3B82F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="Modern.SkipLinkForeground" Color="#FFFFFF" po:Freeze="False"/>
    
    <!-- Reduced Motion - Alternative styles (comment: users can set animation timings to 0) -->
    <!-- These provide a foundation for reduced motion preferences -->
    <Duration x:Key="Modern.Animation.Fast">0:0:0.15</Duration>
    <Duration x:Key="Modern.Animation.Standard">0:0:0.25</Duration>
    <Duration x:Key="Modern.Animation.Slow">0:0:0.4</Duration>
    
    <!-- Loading/Processing Indicator Colors -->
    <SolidColorBrush x:Key="Modern.LoadingPrimary" Color="#3B82F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="Modern.LoadingSecondary" Color="#1E3A5F" po:Freeze="False"/>
    
    <!-- Tooltip Styling for better readability -->
    <Style x:Key="Modern.Tooltip" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Modern.BackgroundSecondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundMain}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.BorderMain}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="HasDropShadow" Value="True"/>
    </Style>
    
    <!-- Disabled State Overlay - for clearly indicating disabled controls -->
    <SolidColorBrush x:Key="Modern.DisabledOverlay" Color="#40000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Modern.DisabledText" Color="#6B7280" po:Freeze="False"/>
</ResourceDictionary>
