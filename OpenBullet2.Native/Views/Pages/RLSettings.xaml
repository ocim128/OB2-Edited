<Page x:Class="OpenBullet2.Native.Views.Pages.RLSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d" 
      d:DesignHeight="1450" d:DesignWidth="800"
      Title="RLSettings">

    <!-- Modern RuriLib Settings Layout -->
    <Grid Background="Transparent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      ScrollViewer.IsDeferredScrollingEnabled="False">
            <StackPanel Margin="0,0,0,20">
                
                <!-- General Settings Section -->
                <Border Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="General Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Form Grid Layout -->
                        <Grid>
        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <!-- Parallelizer Type -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Parallelizer Type:" Foreground="White" FontSize="14" Margin="0,8,16,8" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ParallelizerTypes}" SelectedValue="{Binding Path=ParallelizerType}" Width="200" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource CleanComboBox}"/>

                            <!-- Checkboxes -->
                            <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Log job activity to a file" IsChecked="{Binding LogJobActivityToFile}" Name="LogJobActivityToFile" Foreground="White" Margin="0,8"/>
                            
                            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="Log all results to the job log file (WARN: High disk usage)" IsChecked="{Binding LogAllResults}" Visibility="{Binding ElementName=LogJobActivityToFile, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White" Margin="16,8,0,8"/>
                            
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Enable logging for bots in MultiRunJob (Debugging only - High RAM usage)" IsChecked="{Binding EnableBotLogging}" Foreground="White" Margin="0,8"/>
                            
                            <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Enable verbose mode (More output and error insights)" IsChecked="{Binding VerboseMode}" Foreground="White" Margin="0,8"/>
                            
                            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Restrict blocks to current working directory" IsChecked="{Binding RestrictBlocksToCWD}" Foreground="White" Margin="0,8"/>
                            
                            <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Use custom user agents list (instead of default provider)" IsChecked="{Binding UseCustomUserAgentsList}" Foreground="White" Margin="0,8"/>
                            
                            <!-- Custom User Agents TextBox -->
                            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Custom User Agents (one per line):" Foreground="#FF1E90FF" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        </Grid>
                        
                <TextBox x:Name="customUserAgentsListTextBox" 
                                 Background="#FF333333" 
                                 Foreground="White" 
                             FontFamily="Consolas" 
                             Height="100"
                             AcceptsReturn="True"
                                 TextChanged="CustomUserAgentsChanged"
                                 BorderBrush="#FF1E90FF"
                                 BorderThickness="1"
                                 Padding="8"/>
                    </StackPanel>
                </Border>

                <!-- Proxy Settings Section -->
                <Border Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Proxy Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                </StackPanel>
                        <!-- Proxy Timeout Settings -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Timeout for proxy connections:" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <mah:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100000000" Interval="1000" Value="{Binding ProxyConnectTimeoutMilliseconds}" Width="120" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="and read/write:" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <mah:NumericUpDown Grid.Column="3" Minimum="0" Maximum="100000000" Interval="1000" Value="{Binding ProxyReadWriteTimeoutMilliseconds}" Width="120" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="4" Text="(in milliseconds)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Global Keys Section -->
                        <TextBlock Text="Global BAN keys (one per line):" Foreground="#FF1E90FF" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <TextBox x:Name="globalBanKeysTextBox" 
                                 Background="#80404040" 
                                 Foreground="White" 
                             FontFamily="Consolas"
                             Height="100"
                             AcceptsReturn="True"
                                 TextChanged="GlobalBanKeysChanged"
                                 BorderBrush="#FF1E90FF"
                                 BorderThickness="1"
                                 Padding="8"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Global RETRY keys (one per line):" Foreground="#FF1E90FF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="globalRetryKeysTextBox" 
                                 Background="#80404040" 
                                 Foreground="White" 
                             FontFamily="Consolas" 
                             Height="100"
                             AcceptsReturn="True"
                                 TextChanged="GlobalRetryKeysChanged"
                                 BorderBrush="#FF1E90FF"
                                 BorderThickness="1"
                                 Padding="8"/>
                    </StackPanel>
                </Border>
                
                <!-- Captcha Settings Section -->
                <Border Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="Robot" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Captcha Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Timeout Settings Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Timeout for captcha solutions:" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <mah:NumericUpDown Grid.Column="1" Minimum="1" Maximum="1000000" Interval="10" Value="{Binding CaptchaTimeoutSeconds}" Width="120" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="(seconds) with polling interval:" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <mah:NumericUpDown Grid.Column="3" Minimum="20" Maximum="100000000" Interval="1000" Value="{Binding CaptchaPollingIntervalMilliseconds}" Width="120" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="4" Text="(milliseconds)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <CheckBox Content="Check the captcha balance before solving" 
                                  IsChecked="{Binding UseCustomUserAgentsList}" 
                                  Foreground="White"
                                  Margin="0,8"/>
                        
                        <!-- Service Selection Grid -->
                        <Grid Margin="0,8,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Captcha Service:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CaptchaServiceTypes}"
                                      SelectedValue="{Binding Path=CurrentCaptchaService}"
                                      Width="250"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource CleanComboBox}"/>
                        </Grid>
                <TabControl x:Name="captchaServiceTabControl" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- TwoCaptcha -->
                    <TabItem>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Api Key:" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding TwoCaptchaApiKey}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="400" HorizontalAlignment="Left"/>
                        </Grid>
                    </TabItem>
                    
                    <!-- AntiCaptcha -->
                    <TabItem>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Api Key:" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding AntiCaptchaApiKey}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="400" HorizontalAlignment="Left"/>
                        </Grid>
                    </TabItem>

                    <!-- CustomTwoCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding CustomTwoCaptchaApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Domain</Label>
                                <TextBox Text="{Binding CustomTwoCaptchaDomain}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Port</Label>
                                <mah:NumericUpDown 
                                    Minimum="1"
                                    Maximum="65535"
                                    Interval="1"
                                    Value="{Binding CustomTwoCaptchaPort}"
                                    Width="150"/>
                            </StackPanel>
                            <CheckBox Content="Override the Host header with 2captcha.com" 
                                  IsChecked="{Binding CustomTwoCaptchaOverrideHostHeader}" 
                                  VerticalContentAlignment="Center"
                                  Margin="5 10 0 0"/>
                        </StackPanel>
                    </TabItem>

                    <!-- DeathByCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Username</Label>
                                <TextBox Text="{Binding DeathByCaptchaUsername}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Password</Label>
                                <TextBox Text="{Binding DeathByCaptchaPassword}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- CaptchaCoder -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding CaptchaCoderApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- ImageTyperz -->
                    <TabItem>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <Label>Api Key</Label>
                            <TextBox Text="{Binding ImageTyperzApiKey}"
                                Width="400"></TextBox>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- CapMonster -->
                    <TabItem>
                        <StackPanel>
                            <Label>This is only for the old CapMonster application</Label>
                            <Label>For CapMonster cloud, use the CustomTwoCaptcha service and disable the override for the Host header option</Label>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Host</Label>
                                <TextBox Text="{Binding CapMonsterHost}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Port</Label>
                                <mah:NumericUpDown 
                                    Minimum="1"
                                    Maximum="65535"
                                    Interval="1"
                                    Value="{Binding CapMonsterPort}"
                                    Width="150"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- AzCaptcha -->
                    <TabItem>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <Label>Api Key</Label>
                            <TextBox Text="{Binding AzCaptchaApiKey}"
                                Width="400"></TextBox>
                        </StackPanel>
                    </TabItem>

                    <!-- Captchas.io -->
                    <TabItem>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <Label>Api Key</Label>
                            <TextBox Text="{Binding CaptchasDotIoApiKey}"
                                Width="400"></TextBox>
                        </StackPanel>
                    </TabItem>

                    <!-- RuCaptcha -->
                    <TabItem>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <Label>Api Key</Label>
                            <TextBox Text="{Binding RuCaptchaApiKey}"
                                Width="400"></TextBox>
                        </StackPanel>
                    </TabItem>

                    <!-- SolveCaptcha -->
                    <TabItem>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <Label>Api Key</Label>
                            <TextBox Text="{Binding SolveCaptchaApiKey}"
                                Width="400"></TextBox>
                        </StackPanel>
                    </TabItem>

                    <!-- TrueCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding TrueCaptchaApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Username</Label>
                                <TextBox Text="{Binding TrueCaptchaUsername}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- 9kw -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding NineKwApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- CustomAntiCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding CustomAntiCaptchaApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Domain</Label>
                                <TextBox Text="{Binding CustomAntiCaptchaDomain}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Port</Label>
                                <mah:NumericUpDown 
                                    Minimum="1"
                                    Maximum="65535"
                                    Interval="1"
                                    Value="{Binding CustomAntiCaptchaPort}"
                                    Width="150"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- CapSolver -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <TextBlock Foreground="{DynamicResource ForegroundBad}">CapSolver itself explicitly asked to be removed from the software. Please choose another service.</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- CapMonster Cloud -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding CapMonsterCloudApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- HumanCoder -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding HumanCoderApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- Nopecha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding NopechaApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- NoCaptcha AI -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding NoCaptchaAiApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- MetaBypass.Tech -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Client ID</Label>
                                <TextBox Text="{Binding MetaBypassTechClientId}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Client Secret</Label>
                                <TextBox Text="{Binding MetaBypassTechClientSecret}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Username</Label>
                                <TextBox Text="{Binding MetaBypassTechUsername}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Password</Label>
                                <TextBox Text="{Binding MetaBypassTechPassword}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- CaptchaAI -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding CaptchaAiApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- NextCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding NextCaptchaApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- EzCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding EzCaptchaApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- EndCaptcha -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Username</Label>
                                <TextBox Text="{Binding EndCaptchaUsername}"
                                Width="400"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Password</Label>
                                <TextBox Text="{Binding EndCaptchaPassword}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- BestCaptchaSolver -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding BestCaptchaSolverApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- CapGuru -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding CapGuruApiKey}"
                                Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    
                    <!-- AYCD -->
                    <TabItem>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                                <Label>Api Key</Label>
                                <TextBox Text="{Binding AycdApiKey}"
                                         Width="400"></TextBox>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                
                        <!-- Check Balance Button -->
                        <Button x:Name="checkBalanceButton" 
                                Click="CheckCaptchaBalance" 
                                Margin="0,16,0,0"
                                Width="200"
                                HorizontalAlignment="Left"
                                Style="{StaticResource StyledPrimaryButton}"
                                Background="#FF28A745"
                                BorderBrush="#FF34CE57"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CurrencyUsd" Width="16" Height="16"/>
                                <TextBlock Text="Check Balance" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Puppeteer Settings Section -->
                <Border Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="GoogleChrome" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Puppeteer Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Chrome Binary Path -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Chrome Binary Path:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PuppeteerChromeBinaryLocation}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Playwright Settings Section -->
                <Border Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="Theater" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Playwright Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Browser Type Selection -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Browser Type:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PlaywrightBrowserTypes}"
                                      SelectedValue="{Binding Path=PlaywrightBrowserType}"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource CleanComboBox}"/>
                        </Grid>
                        
                        <!-- Chromium Binary Path -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Chromium Binary Path:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlaywrightChromiumBinaryLocation}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <!-- Firefox Binary Path -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Firefox Binary Path:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlaywrightFirefoxBinaryLocation}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <!-- Webkit Binary Path -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Webkit Binary Path:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlaywrightWebkitBinaryLocation}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <!-- Headless Mode -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Headless Mode:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding PlaywrightHeadless}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Draw Mouse Movement -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Draw Mouse Movement:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding PlaywrightDrawMouseMovement}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Timeout -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Timeout (ms):" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlaywrightTimeoutMilliseconds}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="200" HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <!-- Ignore HTTPS Errors -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Ignore HTTPS Errors:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding PlaywrightIgnoreHTTPSErrors}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- CAPTCHA Solving Settings -->
                        <Border Background="#FF2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,16">

                        </Border>
                        
                        <!-- Extra Args -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Extra Arguments:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlaywrightExtraArgs}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Selenium Settings Section -->
                <Border Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="Web" Width="24" Height="24" Foreground="#FF1E90FF" Margin="0,0,12,0"/>
                            <TextBlock Text="Selenium Settings" FontSize="20" FontWeight="Bold" Foreground="#FF1E90FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Browser Type Selection -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Browser Type:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SeleniumBrowserTypes}"
                                      SelectedValue="{Binding Path=SeleniumBrowserType}"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource CleanComboBox}"/>
                        </Grid>
                        
                        <!-- Chrome Binary Path -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Chrome Binary Path:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SeleniumChromeBinaryLocation}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <!-- Firefox Binary Path -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Firefox Binary Path:" Foreground="White" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SeleniumFirefoxBinaryLocation}"
                                     Background="#FF333333" Foreground="White" BorderBrush="#FF1E90FF" BorderThickness="1" Padding="8"
                                     Width="500" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Modern Action Buttons -->
        <Border Grid.Row="1" Background="#C0353535" CornerRadius="8" Padding="16" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="saveButton" 
                Click="Save" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Padding="16,10"
                        Margin="0,0,12,0"
                        Background="#FF28A745"
                        BorderBrush="#FF34CE57">
            <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16"/>
                        <TextBlock Text="Save" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <Button x:Name="resetButton" 
                Click="Reset" 
                        Style="{StaticResource StyledDangerButton}"
                        Padding="16,10"
                        Background="#FFDC3545"
                        BorderBrush="#FFFF6B6B">
            <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16"/>
                        <TextBlock Text="Reset" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
