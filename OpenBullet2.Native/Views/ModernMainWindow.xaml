<mah:MetroWindow x:Class="OpenBullet2.Native.Views.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBullet2.Native"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
        mc:Ignorable="d"
        Title="OpenBullet 2 - Modern UI" Width="1200" Height="800"
        Background="{StaticResource Modern.BackgroundMain}"
        BorderThickness="0"
        GlowBrush="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowTitleBrush="{StaticResource Modern.BackgroundSecondary}"
        WindowTransitionsEnabled="False"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        Icon="/Images/logohq_square_padded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Modern Sidebar Navigation -->
        <Border Grid.Column="0" 
                Style="{StaticResource ModernCardLite}"
                CornerRadius="0,8,8,0"
                Margin="0,0,8,0"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" 
                           Margin="20,20,20,32" HorizontalAlignment="Left">
                    <Image Source="/Images/logohq_square_padded.png" 
                           Width="32" Height="32" 
                           VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OpenBullet 2" 
                                  Style="{StaticResource ModernHeading3}" />
                        <TextBlock Text="Modern Edition" 
                                  Style="{StaticResource ModernCaptionText}" 
                                  Margin="0,-4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource ModernScrollViewer}"
                             UseLayoutRounding="True"
                             SnapsToDevicePixels="True">
                    <StackPanel Margin="12,0,12,0">
                        
                        <!-- Primary Navigation -->
                        <TextBlock Text="MAIN" 
                                  Style="{StaticResource ModernCaptionText}" 
                                  Margin="8,0,0,8" />
                        
                        <Button x:Name="navHome" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Home" Width="16" Height="16" />
                                <TextBlock Text="Home" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="navJobs" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Play" Width="16" Height="16" />
                                <TextBlock Text="Jobs" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="navMonitor" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MonitorDashboard" Width="16" Height="16" />
                                <TextBlock Text="Monitor" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Resources Section -->
                        <TextBlock Text="RESOURCES" 
                                  Style="{StaticResource ModernCaptionText}" 
                                  Margin="8,24,0,8" />

                        <Button x:Name="navProxies" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Lan" Width="16" Height="16" />
                                <TextBlock Text="Proxies" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="navWordlists" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FileDocument" Width="16" Height="16" />
                                <TextBlock Text="Wordlists" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="navConfigs" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4"
                               MouseEnter="ConfigsMenuOptionMouseEnter"
                               MouseLeave="ConfigsMenuOptionMouseLeave">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" />
                                <TextBlock Text="Configs" Margin="12,0,0,0" />
                                <iconPacks:PackIconMaterial Kind="ChevronDown" Width="12" Height="12" 
                                                          Margin="8,0,0,0"
                                                          Visibility="{Binding IsConfigSelected, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>

                        <!-- Results Section -->
                        <TextBlock Text="RESULTS" 
                                  Style="{StaticResource ModernCaptionText}" 
                                  Margin="8,24,0,8" />

                        <Button x:Name="navHits" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Target" Width="16" Height="16" />
                                <TextBlock Text="Hits" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Tools Section -->
                        <TextBlock Text="TOOLS" 
                                  Style="{StaticResource ModernCaptionText}" 
                                  Margin="8,24,0,8" />

                        <Button x:Name="navPlugins" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Puzzle" Width="16" Height="16" />
                                <TextBlock Text="Plugins" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Settings Section -->
                        <TextBlock Text="SETTINGS" 
                                  Style="{StaticResource ModernCaptionText}" 
                                  Margin="8,24,0,8" />

                        <Button x:Name="navOBSettings" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Settings" Width="16" Height="16" />
                                <TextBlock Text="OB Settings" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="navRLSettings" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="SettingsHelper" Width="16" Height="16" />
                                <TextBlock Text="RL Settings" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="navAbout" Style="{StaticResource ModernNavButton}" 
                               Click="HandleNavigation" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Information" Width="16" Height="16" />
                                <TextBlock Text="About" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="2" Margin="12,0,12,20">
                    <Separator Margin="0,0,0,16" Background="{StaticResource Modern.BorderMain}" />
                    
                    <Button x:Name="screenshotButton" 
                           Style="{StaticResource ModernButton}"
                           Click="TakeScreenshot" 
                           ToolTip="Take a screenshot"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Camera" Width="16" Height="16" />
                            <TextBlock Text="Screenshot" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Update notification -->
                    <Button x:Name="updateButton" 
                           Style="{StaticResource ModernWarningButton}"
                           Click="ShowUpdateConfirmation"
                           Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Update" Width="16" Height="16" />
                            <TextBlock Text="Update Available" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" 
                   Background="{StaticResource Modern.BackgroundCard}"
                   BorderBrush="{StaticResource Modern.BorderMain}"
                   BorderThickness="0,0,0,1"
                   Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <TextBlock x:Name="pageTitle" 
                              Text="Home" 
                              Style="{StaticResource ModernHeading2}"
                              VerticalAlignment="Center" />

                    <!-- Quick Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                        <Button Style="{StaticResource ModernButton}" 
                               ToolTip="New Config (Ctrl+N)"
                               Margin="0,0,4,0">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource ModernButton}" 
                               ToolTip="Open Config (Ctrl+O)"
                               Margin="0,0,4,0">
                            <iconPacks:PackIconMaterial Kind="FolderOpen" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource ModernButton}" 
                               ToolTip="Save Config (Ctrl+S)">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Border Grid.Row="1" 
                   Background="{StaticResource Modern.BackgroundMain}"
                   Padding="20"
                   UseLayoutRounding="True"
                   SnapsToDevicePixels="True">
                <Frame x:Name="mainFrame" 
                      NavigationUIVisibility="Hidden"
                      Background="Transparent"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True" />
            </Border>

            <!-- Loading Indicator -->
            <mah:ProgressRing x:Name="loadingIndicator"
                            Grid.Row="1"
                            IsActive="{Binding IsLoading}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ModernProgressRing}"
                            Width="48" Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>

        <!-- Config Submenu Overlay -->
        <Border x:Name="configSubmenu"
               Grid.Column="0"
               Background="{StaticResource Modern.BackgroundCard}"
               BorderBrush="{StaticResource Modern.BorderMain}"
               BorderThickness="1"
               CornerRadius="8"
               Padding="8"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               Visibility="Collapsed"
               Width="160"
               Height="Auto"
               Panel.ZIndex="1000"
               MouseEnter="ConfigSubmenuMouseEnter"
               MouseLeave="ConfigSubmenuMouseLeave">
            <StackPanel>
                <Button x:Name="menuOptionMetadata" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="TagText" Width="14" Height="14" />
                        <TextBlock Text="Metadata" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionReadme" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentEdit" Width="14" Height="14" />
                        <TextBlock Text="Readme" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionStacker" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ViewModule" Width="14" Height="14" />
                        <TextBlock Text="Stacker" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionLoliCode" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CodeBraces" Width="14" Height="14" />
                        <TextBlock Text="LoliCode" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionConfigSettings" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Tune" Width="14" Height="14" />
                        <TextBlock Text="Settings" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionCSharpCode" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="LanguageCsharp" Width="14" Height="14" />
                        <TextBlock Text="C# Code" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuOptionLoliScript" Style="{StaticResource ModernNavButton}" 
                       Click="HandleNavigation">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Script" Width="14" Height="14" />
                        <TextBlock Text="LoliScript" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</mah:MetroWindow>