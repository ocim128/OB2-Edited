<Page x:Class="Flux.Native.Views.Pages.Configs.ConfigCSharpCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flux.Native.Views.Pages"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="C# Code">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource Modern.BackgroundTertiary}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
            <Button Click="ToggleUsings"
                        Style="{StaticResource StyledPrimaryButton}"
                        Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconRadixIcons Kind="ActivityLog" Width="16" Height="16"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Toggle Usings</TextBlock>
                </StackPanel>
            </Button>
            <Button Click="ToggleStartup"
                        Style="{StaticResource StyledPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconRadixIcons Kind="Code" Width="16" Height="16"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">Toggle Startup C#</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
        </Border>

        <!-- Modern Using Statements Section -->
        <Border Grid.Row="1"
            x:Name="usingsContainer"
                Height="120"
                Background="{DynamicResource Modern.BackgroundSecondary}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
            Visibility="Collapsed">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Using Statements (Read-Only)" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Modern.ThemeMain}" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
            <TextBox x:Name="usingsTextBox"
                         Background="{DynamicResource Modern.BackgroundTertiary}" 
                         Foreground="{DynamicResource Modern.ForegroundSecondary}" 
                FontFamily="Consolas"
                         FontSize="12"
                Grid.Row="1"
                AcceptsReturn="True"
                IsReadOnly="True"
                VerticalContentAlignment="Top"
                         BorderThickness="0"
                         Padding="8"
                Text="{Binding UsingsString}" />
        </Grid>
        </Border>

        <!-- Modern Startup Code Section -->
        <Border Grid.Row="2"
            x:Name="startupEditorContainer"
                Height="220"
                Background="{DynamicResource Modern.BackgroundSecondary}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
            Visibility="Collapsed">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Startup C# Code (Read-Only)" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Modern.ThemeMain}" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{DynamicResource Modern.BackgroundInput}" CornerRadius="4">
                    <avalonEdit:TextEditor x:Name="startupEditor"
                FontFamily="Consolas"
                                           FontSize="11pt"
                                           Foreground="{DynamicResource Modern.ForegroundSecondary}"
                                           Background="{DynamicResource Modern.BackgroundInput}"
                HorizontalAlignment="Stretch"
                ShowLineNumbers="True"
                IsReadOnly="True"
                WordWrap="{Binding WordWrap}"
                MaxWidth="{Binding ActualWidth, ElementName=dockParent}"
                MaxHeight="{Binding ActualHeight, ElementName=dockParent}"/>
                </Border>
        </Grid>
        </Border>

        <!-- Modern Main C# Editor -->
        <Border Grid.Row="3" Background="{DynamicResource Modern.BackgroundSecondary}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Generated C# Code (Read-Only)" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Modern.ThemeMain}" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{DynamicResource Modern.BackgroundInput}" CornerRadius="4">
                    <avalonEdit:TextEditor x:Name="editor"
            FontFamily="Consolas"
                                           FontSize="11pt"
                                           Foreground="{DynamicResource Modern.ForegroundSecondary}"
                                           Background="{DynamicResource Modern.BackgroundInput}"
            HorizontalAlignment="Stretch"
            IsReadOnly="True"
            ShowLineNumbers="True"
            WordWrap="{Binding WordWrap}"
            MaxWidth="{Binding ActualWidth, ElementName=dockParent}"
            MaxHeight="{Binding ActualHeight, ElementName=dockParent}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>


