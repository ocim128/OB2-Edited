<UserControl x:Class="OpenBullet2.Native.Controls.FloatSettingViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBullet2.Native.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converters="clr-namespace:OpenBullet2.Native.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToTextWrappingConverter x:Key="BoolToWrap" />
        
        <!-- Consistent Mode Switch Button Style -->
        <Style x:Key="ConsistentModeButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Label 
            Content="{Binding Name}"
            ToolTip="{Binding Description}"
            VerticalAlignment="Center"
            Grid.Column="0" />

        <TabControl x:Name="tabControl" Grid.Column="1">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem>
                <ComboBox 
                    IsEditable="True"
                    Background="#112"
                    Height="30"
                    ItemsSource="{Binding Suggestions}"
                    Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>
            <TabItem>
                <mah:NumericUpDown Minimum="-3.40282347E+38"
                        Maximum="3.40282347E+38"
                        Interval="0.1"
                        Background="#111"
                        NumericInputMode="Decimal"
                        StringFormat="#.#"
                        Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                        Height="30"/>
            </TabItem>
        </TabControl>

        <TabControl x:Name="buttonTabControl" Grid.Column="2">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem>
                <!-- Variable -> Constant -->
                <Button Click="ConstantMode"
                        Style="{StaticResource ConsistentModeButton}"
                        Background="#2563EB" 
                        Foreground="White"
                        ToolTip="Switch to constant mode">
                    <TextBlock FontSize="9" Foreground="White">VAR</TextBlock>
                </Button>
            </TabItem>
            <TabItem>
                <!-- Constant -> Variable -->
                <Button Click="VariableMode"
                        Style="{StaticResource ConsistentModeButton}"
                        Background="#10B981" 
                        Foreground="White"
                        ToolTip="Switch to variable mode">
                    <TextBlock FontSize="9" Foreground="White">CON</TextBlock>
                </Button>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
