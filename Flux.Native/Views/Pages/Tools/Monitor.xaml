<Page x:Class="Flux.Native.Views.Pages.Tools.Monitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Tools"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="Transparent" Margin="20">
        <ScrollViewer x:Name="ToolsScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource ModernScrollViewer}"
                      CanContentScroll="False"
                      Loaded="ToolsScrollViewer_Loaded"
                      SizeChanged="ToolsScrollViewer_SizeChanged">
            <DockPanel LastChildFill="True">
                <Border Style="{StaticResource ModernCardLite}"
                        Background="{DynamicResource Modern.BackgroundSecondary}"
                        Margin="0,0,0,20"
                        Padding="20"
                        DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock Text="Tool Command Center"
                                   Style="{StaticResource H3TextStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Search, filter, and jump straight to your favorite automation helpers."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource Modern.ForegroundMuted}"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ToolSearchTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     mah:TextBoxHelper.Watermark="Search tools..."
                                     mah:TextBoxHelper.UseFloatingWatermark="False"
                                     Margin="0,0,16,0"
                                     TextChanged="ToolSearchTextChanged"
                                     AutomationProperties.Name="Search tools box"/>
                            <ComboBox x:Name="ToolCategoryComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource CleanComboBox}"
                                      SelectionChanged="ToolCategorySelectionChanged"
                                      Margin="0,0,16,0"
                                      AutomationProperties.Name="Tool category filter"/>
                            <Button x:Name="ResetToolFiltersButton"
                                    Grid.Column="2"
                                    Style="{StaticResource StyledButton}"
                                    Content="Reset"
                                    Width="90"
                                    Click="ResetToolFilters"
                                    AutomationProperties.Name="Reset tool filters button"/>
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource StyledButton}"
                                    Content="OTP toolkit"
                                    Margin="0,0,10,10"
                                    Tag="OTP Toolkit"
                                    Click="NavigateToToolCard"
                                    AutomationProperties.Name="Jump to OTP Toolkit"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Bookmarklet parser"
                                    Margin="0,0,10,10"
                                    Tag="Bookmarklet Parser"
                                    Click="NavigateToToolCard"
                                    AutomationProperties.Name="Jump to Bookmarklet Parser"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Text cleaner"
                                    Margin="0,0,10,10"
                                    Tag="Text Cleaner"
                                    Click="NavigateToToolCard"
                                    AutomationProperties.Name="Jump to Text Cleaner"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Firefox switcher"
                                    Margin="0,0,10,10"
                                    Tag="Firefox Switcher"
                                    Click="NavigateToToolCard"
                                    AutomationProperties.Name="Jump to Firefox Switcher"/>
                            <Button Style="{StaticResource StyledButton}"
                                    Content="Performance bench"
                                    Margin="0,0,10,10"
                                    Tag="Performance Benchmark"
                                    Click="NavigateToToolCard"
                                    AutomationProperties.Name="Jump to Performance Benchmark"/>
                        </WrapPanel>

                        <TextBlock x:Name="ToolFilterStatusTextBlock"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource Modern.ForegroundMuted}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border x:Name="AutomationBannerCard"
                        Style="{StaticResource ModernCardLite}"
                        Background="{DynamicResource Modern.BackgroundTertiary}"
                        Margin="0,0,0,20"
                        Padding="16"
                        DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Toolbox" 
                                                   Width="24" 
                                                   Height="24" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Foreground="{StaticResource Modern.ThemeMain}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Automation Toolkit"
                                       Style="{StaticResource H3TextStyle}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Quick automation suite for power users"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel x:Name="ToolCardPanel"
                           ItemWidth="360"
                           Margin="0"
                           Orientation="Horizontal">
                    <Border x:Name="OtpToolCard"
                            Style="{StaticResource ModernCardLite}"
                            Background="{DynamicResource Modern.BackgroundSecondary}"
                            Padding="20"
                            Margin="0,0,16,16"
                            MinWidth="300"
                            MaxWidth="420"
                            Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                            Tag="Security">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="ShieldKey" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Modern.Success}"/>
                                <TextBlock Text="OTP Toolkit"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Drop in a Base32 secret and stay synced with rolling 30-second codes."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBox x:Name="SecretKeyTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     Margin="0,0,0,10"
                                     AutomationProperties.Name="Secret key"
                                     ToolTip="Enter a Base32 encoded secret key"
                                     CharacterCasing="Upper"
                                     Text="{Binding Secret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="False"
                                     VerticalContentAlignment="Center"
                                     Height="34"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearSecretButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear"
                                        Width="80"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ClearSecretCommand}"
                                        AutomationProperties.Name="Clear secret"
                                        ToolTip="Clear the current secret"/>
                                <Button x:Name="PasteSecretButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Paste"
                                        Width="80"
                                        Grid.Column="1"
                                        Command="{Binding PasteSecretCommand}"
                                        AutomationProperties.Name="Paste secret"
                                        ToolTip="Paste a secret from the clipboard"/>
                            </Grid>

                            <Border x:Name="SecretErrorBorder"
                                    Background="{DynamicResource Modern.Error}"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="SecretErrorTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.TextOnAccent}"
                                           Text="{Binding ErrorMessage}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Current OTP"
                                               Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock x:Name="OtpTextBlock"
                                               Grid.Row="1"
                                               Text="{Binding CurrentOtp}"
                                               FontSize="36"
                                               FontFamily="Segoe UI Semibold"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,6"
                                               AutomationProperties.Name="One-time password"/>
                                    <ProgressBar x:Name="OtpProgressBar"
                                                 Grid.Row="2"
                                                 Height="6"
                                                 Minimum="0"
                                                 Maximum="30"
                                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                                 AutomationProperties.Name="OTP progress"/>
                                    <Grid Grid.Row="3" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OtpStatusTextBlock"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding StatusMessage}"/>
                                        <Button x:Name="CopyOtpButton"
                                                Grid.Column="1"
                                                Style="{StaticResource StyledSuccessButton}"
                                                Content="Copy"
                                                Width="70"
                                                Margin="12,0,0,0"
                                                Command="{Binding CopyOtpCommand}"
                                                IsEnabled="{Binding CanCopy}"
                                                AutomationProperties.Name="Copy OTP button"
                                                ToolTip="Copy the current OTP to the clipboard"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BookmarkletToolCard"
                            Style="{StaticResource ModernCardLite}"
                            Background="{DynamicResource Modern.BackgroundSecondary}"
                            Padding="20"
                            Margin="0,0,16,16"
                            MinWidth="300"
                            MaxWidth="420"
                            Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                            Tag="Automation">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Bookmark" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Modern.Warning}"/>
                                <TextBlock Text="Bookmarklet Parser"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Paste bookmarklet dumps; we strip comments and surface the useful payload."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBox x:Name="BookmarkletInputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     Height="120"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Bookmarklet input"
                                     KeyDown="BookmarkletInputKeyDown"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="ClearBookmarkletButton"
                                            Style="{StaticResource StyledWarningButton}"
                                            Content="Clear"
                                            Width="80"
                                            Click="ClearBookmarklet"
                                            AutomationProperties.Name="Clear bookmarklet input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="ParseBookmarkletButton"
                                            Style="{StaticResource StyledPrimaryButton}"
                                            Content="Parse"
                                            Width="80"
                                            Margin="0,0,8,0"
                                            Click="ParseBookmarklet"
                                            AutomationProperties.Name="Parse bookmarklet"/>
                                    <Button x:Name="CopyBookmarkletButton"
                                            Style="{StaticResource StyledSuccessButton}"
                                            Content="Copy"
                                            Width="80"
                                            Click="CopyBookmarkletOutput"
                                            AutomationProperties.Name="Copy bookmarklet output"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="BookmarkletStatusBorder"
                                    Background="{DynamicResource Modern.Success}"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,10,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="BookmarkletStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.TextOnAccent}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBox x:Name="BookmarkletOutputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Bookmarklet output"
                                     Cursor="IBeam"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TextCleanerToolCard"
                            Style="{StaticResource ModernCardLite}"
                            Background="{DynamicResource Modern.BackgroundSecondary}"
                            Padding="20"
                            Margin="0,0,16,16"
                            MinWidth="300"
                            MaxWidth="420"
                            Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                            Tag="Text">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="TextBoxRemove" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Modern.ThemeAccent}"/>
                                <TextBlock Text="Text Cleaner"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Normalize chaotic dumps, compress whitespace, and rank by 'T' markers instantly."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBox x:Name="TextCleanerInputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Text cleaner input"
                                     KeyDown="TextCleanerInputKeyDown"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="ClearTextCleanerButton"
                                            Style="{StaticResource StyledWarningButton}"
                                            Content="Clear"
                                            Width="80"
                                            Click="ClearTextCleaner"
                                            AutomationProperties.Name="Clear text cleaner"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CleanTextButton"
                                            Style="{StaticResource StyledPrimaryButton}"
                                            Content="Clean"
                                            Width="80"
                                            Margin="0,0,8,0"
                                            Click="CleanTextInput"
                                            AutomationProperties.Name="Clean text"/>
                                    <Button x:Name="CopyTextCleanerButton"
                                            Style="{StaticResource StyledSuccessButton}"
                                            Content="Copy"
                                            Width="80"
                                            Click="CopyTextCleanerOutput"
                                            AutomationProperties.Name="Copy text cleaner output"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="TextCleanerStatusBorder"
                                    Background="{DynamicResource Modern.Success}"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,10,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TextCleanerStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.TextOnAccent}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBox x:Name="TextCleanerOutputTextBox"
                                     Style="{StaticResource MatchingTextBox}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Text cleaner output"
                                     Cursor="IBeam"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FirefoxToolCard"
                            Style="{StaticResource ModernCardLite}"
                            Background="{DynamicResource Modern.BackgroundSecondary}"
                            Padding="20"
                            Margin="0,0,16,16"
                            MinWidth="300"
                            MaxWidth="420"
                            Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                            Tag="Browsers">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="FolderZip" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Modern.Warning}"/>
                                <TextBlock Text="Firefox Switcher"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Quickly switch between Firefox profiles or launch new instances with different configurations."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearZipOptionsButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear"
                                        Width="80"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Click="ClearZipOptions"
                                        AutomationProperties.Name="Clear zip options"/>
                                <Button x:Name="LoadZipOptionsButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Load .zip"
                                        Width="100"
                                        Grid.Column="1"
                                        Click="SelectZipForOptions"
                                        AutomationProperties.Name="Load zip archive"/>
                            </Grid>

                            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Selected Archive"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource Modern.ForegroundMuted}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ZipOptionFileTextBlock"
                                               Text="No file loaded"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{DynamicResource Modern.ForegroundMain}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ZipOptionStatusBorder"
                                    Background="{DynamicResource Modern.ThemeMain}"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ZipOptionStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.TextOnAccent}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    MinHeight="160">
                                <ListBox x:Name="ZipOptionListBox"
                                         Foreground="{DynamicResource Modern.ForegroundMain}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Modern.BackgroundElevated}"
                                                        BorderBrush="{DynamicResource Modern.BorderMain}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,8"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               Foreground="{DynamicResource Modern.ForegroundMain}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource StyledPrimaryButton}"
                                                        Width="40"
                                                        Height="34"
                                                        Padding="4"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding}"
                                                        Click="CopyZipOptionName"
                                                        ToolTip="Copy folder name">
                                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18"/>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource StyledSuccessButton}"
                                                        Width="44"
                                                        Height="34"
                                                        Padding="4"
                                                        Tag="{Binding}"
                                                        Click="LaunchZipOption"
                                                        ToolTip="Launch Firefox profile">
                                                    <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LineReducerToolCard"
                            Style="{StaticResource ModernCardLite}"
                            Background="{DynamicResource Modern.BackgroundSecondary}"
                            Padding="20"
                            Margin="0,0,16,16"
                            MinWidth="300"
                            MaxWidth="420"
                            Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                            Tag="Text">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="FileDocument"
                                                           Width="20"
                                                           Height="20"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Modern.Success}"/>
                                <TextBlock Text="Line Reducer"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Remove every line from a source file that appears in one or more comparison files using streaming-safe fingerprints."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Main file (.txt)"
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LineReducerSourcePathTextBox"
                                             Style="{StaticResource MatchingTextBox}"
                                             Grid.Column="0"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="Line reducer main file"/>
                                    <Button x:Name="BrowseLineReducerSourceButton"
                                            Style="{StaticResource StyledButton}"
                                            Grid.Column="1"
                                            Width="100"
                                            Content="Browse"
                                            Click="BrowseLineReducerSource"
                                            AutomationProperties.Name="Browse main text file"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Comparison file(s)"
                                               Style="{StaticResource BodyTextStyle}"
                                               Margin="0,0,0,4"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="AddLineReducerCompareButton"
                                            Grid.Column="1"
                                            Style="{StaticResource StyledPrimaryButton}"
                                            Content="Add file(s)"
                                            Width="110"
                                            Margin="8,0,0,0"
                                            Click="AddLineReducerCompareFiles"
                                            AutomationProperties.Name="Add comparison files"/>
                                    <Button x:Name="ClearLineReducerCompareButton"
                                            Grid.Column="2"
                                            Style="{StaticResource StyledWarningButton}"
                                            Content="Clear"
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Click="ClearLineReducerCompareFiles"
                                            AutomationProperties.Name="Clear comparison files"/>
                                </Grid>
                                <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                                        BorderBrush="{DynamicResource Modern.BorderSecondary}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="0,8,0,4"
                                        MinHeight="120">
                                    <ListBox x:Name="LineReducerCompareFilesListBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource Modern.ForegroundMain}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   Foreground="{DynamicResource Modern.ForegroundMain}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Details}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource Modern.ForegroundMuted}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource StyledWarningButton}"
                                                            Width="80"
                                                            Content="Remove"
                                                            Tag="{Binding}"
                                                            Click="RemoveLineReducerCompareFile"
                                                            AutomationProperties.Name="Remove comparison file"
                                                            Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock x:Name="LineReducerCompareSummaryTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMuted}"
                                           Text="No comparison files selected."
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Output file"
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LineReducerOutputPathTextBox"
                                             Style="{StaticResource MatchingTextBox}"
                                             Grid.Column="0"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="Line reducer output file"/>
                                    <Button x:Name="BrowseLineReducerOutputButton"
                                            Style="{StaticResource StyledButton}"
                                            Grid.Column="1"
                                            Width="110"
                                            Content="Choose..."
                                            Click="BrowseLineReducerOutput"
                                            AutomationProperties.Name="Choose line reducer output file"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="LineReducerTrimCheckBox"
                                              Content="Trim whitespace before comparing"
                                              Margin="0,0,16,0"
                                              IsChecked="True"/>
                                    <CheckBox x:Name="LineReducerIgnoreCaseCheckBox"
                                              Content="Ignore case (abc = ABC)"
                                              IsChecked="False"/>
                                </StackPanel>
                                <TextBlock Text="Comparison is performed via 128-bit fingerprints, keeping memory usage predictable even for huge files."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RunLineReducerButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Process file"
                                        Width="130"
                                        Click="RunLineReducer"
                                        AutomationProperties.Name="Run line reducer"/>
                                <Button x:Name="CancelLineReducerButton"
                                        Grid.Column="1"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Cancel"
                                        Width="100"
                                        Margin="12,0,0,0"
                                        Visibility="Collapsed"
                                        Click="CancelLineReducer"
                                        AutomationProperties.Name="Cancel line reducer"/>
                            </Grid>

                            <ProgressBar x:Name="LineReducerProgressBar"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,0,0,8"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="LineReducerProgressTextBlock"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       Text="Idle."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <Border x:Name="LineReducerStatusBorder"
                                    Background="{DynamicResource Modern.BackgroundElevated}"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="LineReducerStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMain}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <TextBlock x:Name="LineReducerStatsTextBlock"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMain}"
                                           TextWrapping="Wrap"
                                           Text="Awaiting first run."/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BenchmarkToolCard"
                            Style="{StaticResource ModernCardLite}"
                            Background="{DynamicResource Modern.BackgroundSecondary}"
                            Padding="20"
                            Margin="0,0,16,16"
                            MinWidth="300"
                            MaxWidth="420"
                            Width="{Binding ElementName=ToolCardPanel, Path=ItemWidth}"
                            Tag="Performance">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Speedometer" 
                                                           Width="20" 
                                                           Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Modern.ThemeAccent}"/>
                                <TextBlock Text="Performance Benchmark"
                                           Style="{StaticResource H3TextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Test application performance and monitor system resources in real-time."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource Modern.ForegroundMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Memory Usage:"
                                           Style="{StaticResource BodyTextStyle}"
                                           Grid.Row="0"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="MemoryUsageTextBlock"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.ThemeMain}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="MemoryUsageValue"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMain}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                                
                                <TextBlock Text="CPU Usage:"
                                           Style="{StaticResource BodyTextStyle}"
                                           Grid.Row="1"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="CpuUsageTextBlock"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.Success}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="CpuUsageValue"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMain}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                                
                                <TextBlock Text="System Status:"
                                           Style="{StaticResource BodyTextStyle}"
                                           Grid.Row="2"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="SystemStatusTextBlock"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.Success}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="SystemStatusValue"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{DynamicResource Modern.ForegroundMain}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearBenchmarkButton"
                                        Style="{StaticResource StyledWarningButton}"
                                        Content="Clear Stats"
                                        Width="100"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Click="ClearBenchmarkStats"
                                        AutomationProperties.Name="Clear benchmark statistics"/>
                                <Button x:Name="RunBenchmarkButton"
                                        Style="{StaticResource StyledPrimaryButton}"
                                        Content="Run Test"
                                        Width="100"
                                        Grid.Column="1"
                                        Click="RunPerformanceBenchmark"
                                        AutomationProperties.Name="Run performance benchmark"/>
                            </Grid>

                            <Border x:Name="BenchmarkStatusBorder"
                                    Background="{DynamicResource Modern.Success}"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="BenchmarkStatusTextBlock"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Modern.TextOnAccent}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource Modern.BackgroundTertiary}"
                                    BorderBrush="{DynamicResource Modern.BorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    MinHeight="120">
                                <TextBox x:Name="BenchmarkOutputTextBox"
                                         Style="{StaticResource MatchingTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         Height="120"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Benchmark output"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NoToolMatchesTextBlock"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource Modern.Error}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0"
                               Visibility="Collapsed"
                               Text="No tools match your filters. Adjust the search or reset filters to show every tool."/>
                </WrapPanel>
            </DockPanel>
        </ScrollViewer>
    </Grid>
</Page>



