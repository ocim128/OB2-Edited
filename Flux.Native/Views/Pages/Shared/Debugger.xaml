<Page x:Class="Flux.Native.Views.Pages.Shared.Debugger"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Flux.Native.Views.Pages.Shared"
      xmlns:converters="clr-namespace:Flux.Native.Converters"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
      xmlns:uc="clr-namespace:Flux.Native.Controls"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"

      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Debugger">
    <Page.Resources>
        <!-- Hide auxiliary panels when window is narrow -->
        <Style x:Key="ResponsiveHideStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dedicated search TextBox styling for debugger -->
        <Style x:Key="DebuggerSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Modern.BackgroundInput}" />
            <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Modern.BorderFocus}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="CaretBrush" Value="{DynamicResource Modern.ForegroundMain}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Modern.ThemeMain}" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="10" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=720}"
                             Value="True">
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="FontSize" Value="12.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid Margin="16,12,16,16"
          HorizontalAlignment="Center"
          MaxWidth="1180"
          MinWidth="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- Give more space to results area by increasing its min height -->
            <RowDefinition Height="*"
                           MinHeight="320" />
        </Grid.RowDefinitions>
        <!-- Debugger toggles -->
        <Border x:Name="DebuggerTogglesBorder"
                Grid.Row="0"
                Style="{StaticResource DebuggerSectionBorder}"
                Padding="12"
                Margin="0,0,0,12">
            <WrapPanel HorizontalAlignment="Left">
                <Button x:Name="TabToggleButton"
                        Click="ToggleTabButtons"
                        Style="{StaticResource DebuggerCommandButton}"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Background="{StaticResource Modern.Success}"
                        Foreground="{StaticResource Modern.TextOnAccent}"
                        ToolTip="Toggle UI elements visibility"
                        AutomationProperties.Name="Toggle debugger UI"
                        AutomationProperties.AutomationId="DbgToggleUi">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconUnicons x:Name="TabToggleIcon"
                                                   Kind="Eye"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0" />
                        <TextBlock Text="Show UI"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="OptionsToggleButton"
                        Click="ToggleOptions"
                        Style="{StaticResource DebuggerCommandButton}"
                        MinWidth="130"
                        Margin="0,0,8,0"
                        Background="{StaticResource Modern.ThemeAccent}"
                        Foreground="{StaticResource Modern.TextOnAccent}"
                        ToolTip="Toggle options visibility"
                        AutomationProperties.Name="Toggle options"
                        AutomationProperties.AutomationId="DbgToggleOptions">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconUnicons x:Name="OptionsToggleIcon"
                                                   Kind="Eye"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0" />
                        <TextBlock Text="Show Options"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="StackerToggleButton"
                        Click="ToggleStacker"
                        Style="{StaticResource DebuggerCommandButton}"
                        MinWidth="130"
                        Background="{StaticResource Modern.Success}"
                        Foreground="{StaticResource Modern.TextOnAccent}"
                        ToolTip="Toggle stacker visibility"
                        AutomationProperties.Name="Toggle stacker"
                        AutomationProperties.AutomationId="DbgToggleStacker">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconUnicons x:Name="StackerToggleIcon"
                                                   Kind="Eye"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0" />
                        <TextBlock Text="Show Stacker"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="FocusModeButton"
                        Click="ToggleFocusMode"
                        Style="{StaticResource DebuggerCommandButton}"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Background="{DynamicResource Modern.Warning}"
                        Foreground="{StaticResource Modern.TextOnAccent}"
                        ToolTip="Show only the essentials (block inspector, input &amp; log)"
                        AutomationProperties.Name="Toggle focus mode"
                        AutomationProperties.AutomationId="DbgToggleFocus">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconUnicons x:Name="FocusModeIcon"
                                                   Kind="Crosshair"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0" />
                        <TextBlock x:Name="FocusModeText"
                                   Text="Focus Mode"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <!-- Configuration Panel -->
        <Border Grid.Row="1"
                x:Name="ConfigurationPanel"
                Style="{StaticResource DebuggerSectionBorder}"
                Padding="16,12">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <!-- Reduce spacing when window is small -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                                         Value="True">
                                <Setter Property="Margin"
                                        Value="0,-4,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10"
                                   x:Name="SpacingRow" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Main Configuration -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Input Data - Primary Focus - Enhanced to prevent text truncation -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="INPUT DATA"
                                   Foreground="{DynamicResource Modern.ForegroundMuted}"
                                   FontFamily="Segoe UI"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="inputDataTextBox" Text="{Binding TestData, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MatchingTextBox}"
                                 MinHeight="38"
                                 MaxHeight="38"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Hidden"
                                 AutomationProperties.Name="Input data"
                                 AutomationProperties.AutomationId="DbgInputData" />
                    </StackPanel>
                    <!-- Perfect Start Button -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=900}"
                                                 Value="True">
                                        <Setter Property="Orientation" Value="Vertical" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,12,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button x:Name="StartButton" Click="Start"
                                Style="{StaticResource PerfectStartButton}"
                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                Width="80"
                                Height="32"
                                Margin="0,0,6,0"
                                Padding="10,6"
                                AutomationProperties.Name="Start debugging"
                                AutomationProperties.AutomationId="DbgStart" />
                        <Button x:Name="StopButton"
                                Click="Stop"
                                Style="{StaticResource PerfectStopButton}"
                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}"
                                Width="80"
                                Height="32"
                                Margin="0,0,6,0"
                                Padding="10,6"
                                AutomationProperties.Name="Stop debugging"
                                AutomationProperties.AutomationId="DbgStop" />
                        <Button x:Name="StepButton"
                                Click="TakeStep"
                                Style="{StaticResource StyledPrimaryButton}"
                                Visibility="{Binding CanTakeStep, Converter={StaticResource BoolToVis}}"
                                Width="75"
                                Height="32"
                                Margin="0,0,6,0"
                                FontSize="11"
                                AutomationProperties.Name="Step execution"
                                AutomationProperties.AutomationId="DbgStep">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconEntypo Kind="ControllerPlay"
                                                          Width="12"
                                                          Height="12"
                                                          Margin="0,0,4,0" />
                                <TextBlock Text="Step"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Secondary Options - Well Positioned -->
                <Grid Grid.Row="2"
                      x:Name="SecondaryOptionsGrid"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Collapsible Secondary Options Panel -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Grid.ColumnSpan="11"
                                  MaxHeight="40"
                                  CanContentScroll="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,0">
                            <!-- Square Step-by-Step Checkbox -->
                            <CheckBox IsChecked="{Binding StepByStep}"
                                      Style="{StaticResource SquareCheckBox}"
                                      Content="Step-by-Step"
                                      Margin="0,0,24,0" />
                            <!-- Wordlist Type with Clean ComboBox -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,24,0">
                                <TextBlock Text="Type"
                                           Foreground="{DynamicResource Modern.ForegroundMuted}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Style="{StaticResource ResponsiveHideStyle}" />
                                <ComboBox ItemsSource="{Binding WordlistTypes}"
                                          SelectedItem="{Binding WordlistType}"
                                          Style="{StaticResource CleanComboBox}"
                                          Width="95"
                                          MinHeight="34" />
                            </StackPanel>
                            <!-- Square Proxy Checkbox -->
                            <CheckBox IsChecked="{Binding UseProxy}"
                                      Style="{StaticResource SquareCheckBox}"
                                      Content="Proxy"
                                      Margin="0,0,12,0" />
                            <!-- Proxy Configuration with Clean ComboBox -->
                            <StackPanel Orientation="Horizontal"
                                        IsEnabled="{Binding UseProxy}"
                                        Margin="0,0,24,0">
                                <TextBox Text="{Binding TestProxy}"
                                         Style="{StaticResource MatchingTextBox}"
                                         Width="130"
                                         MinHeight="38"
                                         Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding ProxyTypes}"
                                          SelectedItem="{Binding ProxyType}"
                                          Style="{StaticResource CleanComboBox}"
                                          Width="75"
                                          MinHeight="38" />
                            </StackPanel>
                            <!-- Square Persist Log Checkbox -->
                            <CheckBox IsChecked="{Binding PersistLog}"
                                      Style="{StaticResource SquareCheckBox}"
                                      Content="Persist Log" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Triggers for responsive behavior -->
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ResponsiveHideStyle}" />
                    </Grid.Style>
                </Grid>
            </Grid>
        </Border>
        <!-- Results Panel -->
        <Border Grid.Row="3"
                Background="{DynamicResource Modern.BackgroundTertiary}"
                CornerRadius="8"
                Padding="0"
                MinHeight="320">
            <TabControl x:Name="tabControl" Background="Transparent" BorderThickness="0"
                        RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        SnapsToDevicePixels="True">
                <!-- Log Tab -->
                <TabItem x:Name="LogTabItem">
                    <TabItem.Header>
                        <Button Click="ShowLog"
                                Width="95"
                                Height="36"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                x:Name="LogTabButton"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DebuggerTabButton}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Modern.ThemeMain}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Modern.TextOnAccent}" />
                                    <Style.Triggers>
                                        <!-- Hide tab buttons when window is small -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconRadixIcons Kind="ActivityLog"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,6,0" />
                                <TextBlock Text="Log"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </TabItem.Header>
                    <Grid Margin="16">

                        <Grid.RowDefinitions>
                            <!-- Allocate more space to the log content row -->
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Optimized Log Content with virtualization -->
                        <Border Grid.Row="0" Background="{StaticResource Modern.BackgroundSecondary}" BorderBrush="{StaticResource Modern.BorderSecondary}" BorderThickness="1" CornerRadius="8" Padding="0"
                                RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <!-- AvalonEdit Log -->
                            <avalonEdit:TextEditor x:Name="logRTB" IsReadOnly="True"
                                                   ShowLineNumbers="False"
                                                   FontFamily="Consolas" FontSize="13.5"
                                                   Background="{DynamicResource Modern.BackgroundInput}" Foreground="{DynamicResource Modern.ForegroundMain}"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Visible"
                                                   WordWrap="True"
                                                   Padding="12,10"
                                                   RenderOptions.ClearTypeHint="Enabled">
                                <avalonEdit:TextEditor.Options>
                                    <avalonEdit:TextEditorOptions EnableHyperlinks="True" 
                                                                 EnableEmailHyperlinks="True" 
                                                                 HighlightCurrentLine="True"/>
                                </avalonEdit:TextEditor.Options>
                            </avalonEdit:TextEditor>
                        </Border>

                        <!-- Search Controls - Reshaped UI -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource Modern.BackgroundTertiary}"
                                CornerRadius="10"
                                Padding="18,16"
                                BorderBrush="{DynamicResource Modern.BorderMain}"
                                BorderThickness="1"
                                x:Name="SearchControlsArea"
                                Visibility="Collapsed">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ResponsiveHideStyle}" />
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Search Box + Button -->
                                <Grid Grid.Row="0"
                                      Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="searchTextBox"
                                             Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             Style="{StaticResource DebuggerSearchTextBox}"
                                             ToolTip="Search logs (Ctrl+F)"
                                             RenderOptions.ClearTypeHint="Enabled"
                                             UseLayoutRounding="True"
                                             SpellCheck.IsEnabled="False"
                                             AutomationProperties.Name="Search logs"
                                             AutomationProperties.AutomationId="DbgSearchInput" />
                                    <Button Grid.Column="1"
                                            Click="Search"
                                            Style="{StaticResource DebuggerCommandButton}"
                                            MinWidth="88"
                                            Height="36"
                                            Margin="12,0,0,0"
                                            Background="{StaticResource Modern.Success}"
                                            Foreground="{StaticResource Modern.TextOnAccent}"
                                            Content="Search"
                                            FontSize="12"
                                            AutomationProperties.Name="Execute search"
                                            AutomationProperties.AutomationId="DbgSearchButton" />
                                </Grid>

                                <!-- Match navigation -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Background="{DynamicResource Modern.BackgroundTertiary}"
                                        CornerRadius="8"
                                        Padding="6,4"
                                        BorderBrush="{DynamicResource Modern.BorderMain}"
                                        BorderThickness="1"
                                        Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="PreviousMatch"
                                                Style="{StaticResource DebuggerToolbarButton}"
                                                Width="36"
                                                Height="32"
                                                Background="Transparent"
                                                Foreground="{StaticResource Modern.ForegroundMain}"
                                                ToolTip="Previous Match (Shift+F3)"
                                                AutomationProperties.Name="Previous match"
                                                AutomationProperties.AutomationId="DbgSearchPrevious">
                                            <iconPacks:PackIconUnicons Kind="AngleLeft"
                                                                       Width="16"
                                                                       Height="16" />
                                        </Button>
                                        <Border Width="84"
                                                Height="32"
                                                Margin="6,0"
                                                Background="{DynamicResource Modern.BackgroundElevated}"
                                                CornerRadius="6"
                                                BorderBrush="{DynamicResource Modern.BorderMain}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding MatchInfo}"
                                                       Foreground="{StaticResource Modern.ForegroundMain}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Click="NextMatch"
                                                Style="{StaticResource DebuggerToolbarButton}"
                                                Width="36"
                                                Height="32"
                                                Background="Transparent"
                                                Foreground="{StaticResource Modern.ForegroundMain}"
                                                ToolTip="Next Match (F3)"
                                                AutomationProperties.Name="Next match"
                                                AutomationProperties.AutomationId="DbgSearchNext">
                                            <iconPacks:PackIconUnicons Kind="AngleRight"
                                                                       Width="16"
                                                                       Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Click="ClearSearch"
                                            Style="{StaticResource DebuggerToolbarButton}"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource Modern.Error}"
                                            Foreground="{StaticResource Modern.TextOnAccent}"
                                            ToolTip="Clear Search (Esc)"
                                            AutomationProperties.Name="Clear search"
                                            AutomationProperties.AutomationId="DbgSearchClear">
                                        <iconPacks:PackIconMaterialDesign Kind="Close"
                                                                          Width="14"
                                                                          Height="14" />
                                    </Button>
                                    <Button Click="ToggleAutoScroll"
                                            Style="{StaticResource DebuggerToolbarButton}"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,10,0"
                                            Background="{Binding IsAutoScrollEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#059669|#DC2626'}"
                                            Foreground="{StaticResource Modern.TextOnAccent}"
                                            ToolTip="{Binding AutoScrollButtonText}"
                                            AutomationProperties.Name="Toggle auto scroll"
                                            AutomationProperties.AutomationId="DbgToggleAutoScroll">
                                        <iconPacks:PackIconMaterial Kind="{Binding IsAutoScrollEnabled, Converter={StaticResource BoolToIconConverter}, ConverterParameter='Pause|Play'}"
                                                                    Width="14"
                                                                    Height="14" />
                                    </Button>
                                    <Button Click="PreviousBlock"
                                            Style="{StaticResource DebuggerToolbarButton}"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource Modern.ThemeSecondary}"
                                            Foreground="{StaticResource Modern.TextOnAccent}"
                                            ToolTip="Previous Block (Ctrl+Up)"
                                            AutomationProperties.Name="Previous block"
                                            AutomationProperties.AutomationId="DbgBlockPrevious">
                                        <iconPacks:PackIconUnicons Kind="AngleDoubleLeft"
                                                                   Width="14"
                                                                   Height="14" />
                                    </Button>
                                    <Button Click="NextBlock"
                                            Style="{StaticResource DebuggerToolbarButton}"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource Modern.ThemeSecondary}"
                                            Foreground="{StaticResource Modern.TextOnAccent}"
                                            ToolTip="Next Block (Ctrl+Down)"
                                            AutomationProperties.Name="Next block"
                                            AutomationProperties.AutomationId="DbgBlockNext">
                                        <iconPacks:PackIconUnicons Kind="AngleDoubleRight"
                                                                   Width="14"
                                                                   Height="14" />
                                    </Button>
                                    <Button Click="ClearLog"
                                            Style="{StaticResource DebuggerToolbarButton}"
                                            Width="36"
                                            Height="36"
                                            Background="{StaticResource Modern.BackgroundInput}"
                                            Foreground="{StaticResource Modern.ForegroundMain}"
                                            ToolTip="Clear All Logs (Ctrl+L)"
                                            AutomationProperties.Name="Clear log"
                                            AutomationProperties.AutomationId="DbgClearLog">
                                        <iconPacks:PackIconMaterialDesign Kind="DeleteSweep"
                                                                          Width="14"
                                                                          Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- Variables Tab -->
                <TabItem x:Name="VariablesTabItem">
                    <TabItem.Header>
                        <Button Click="ShowVariables"
                                Width="105"
                                Height="36"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                x:Name="VariablesTabButton"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DebuggerTabButton}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Modern.ThemeAccent}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Modern.TextOnAccent}" />
                                    <Style.Triggers>
                                        <!-- Hide tab buttons when window is small -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Variable"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,6,0" />
                                <TextBlock Text="Variables"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </TabItem.Header>
                    <Grid Margin="16">
                        <!-- Optimized Variables Content with performance enhancements -->
                        <Border Background="{StaticResource Modern.BackgroundSecondary}"
                                BorderBrush="{StaticResource Modern.BorderSecondary}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="1"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                UseLayoutRounding="True">
                            <Border Background="{StaticResource Modern.BackgroundTertiary}"
                                    CornerRadius="7"
                                    Padding="0">
                                <Grid>
                                    <!-- Optimized Variable Count Indicator -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Modern.BackgroundTertiary}"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            Margin="0,8,8,0"
                                            Panel.ZIndex="10"
                                            RenderOptions.ClearTypeHint="Enabled">
                                        <TextBlock Text="{Binding Variables.Count, StringFormat='Variables: {0}', Mode=OneWay}"
                                                   Foreground="{DynamicResource Modern.ThemeAccent}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   RenderOptions.ClearTypeHint="Enabled" />
                                    </Border>
                                    <!-- Remove outer ScrollViewer to avoid double scrollbars; rely on inner WinForms RichTextBox scrollbar -->
                                    <!-- AvalonEdit Variables -->
                                    <ListView ItemsSource="{Binding Variables}"
                                              Background="{DynamicResource Modern.BackgroundInput}"
                                              Foreground="{DynamicResource Modern.ForegroundMain}"
                                              BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              Padding="0">
                                        <ListView.Resources>
                                            <Style TargetType="GridViewColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Setter Property="Background" Value="{DynamicResource Modern.BackgroundTertiary}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Modern.ForegroundMuted}" />
                                                <Setter Property="Padding" Value="8,6" />
                                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Modern.BorderMain}" />
                                            </Style>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Modern.BackgroundHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Modern.ThemeMain}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Modern.TextOnAccent}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding MarkedForCapture}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Modern.Error}" /> 
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.Resources>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Type}" />
                                                <GridViewColumn Header="Value" Width="800">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- HTML Tab -->
                <TabItem x:Name="HtmlTabItem">
                    <TabItem.Header>
                        <Button Click="ShowHTML"
                                Width="95"
                                Height="36"
                                Padding="12,8"
                                x:Name="HtmlTabButton"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DebuggerTabButton}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Modern.Error}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Modern.TextOnAccent}" />
                                    <Style.Triggers>
                                        <!-- Hide tab buttons when window is small -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=600}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconEntypo Kind="Browser"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="HTML"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </TabItem.Header>
                    <Grid Margin="16">
                        <!-- Optimized HTML Content with performance enhancements -->
                        <Border Background="{StaticResource Modern.BackgroundSecondary}"
                                BorderBrush="{StaticResource Modern.BorderSecondary}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="1"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                UseLayoutRounding="True">
                            <Border Background="{StaticResource Modern.BackgroundTertiary}"
                                    CornerRadius="7"
                                    Padding="2">
                                <Grid>
                                    <!-- Optimized HTML Status Indicator -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Modern.BackgroundTertiary}"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            Margin="0,8,8,0"
                                            Panel.ZIndex="10"
                                            RenderOptions.ClearTypeHint="Enabled">
                                        <TextBlock Text="HTML Preview"
                                                   Foreground="{DynamicResource Modern.Error}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   RenderOptions.ClearTypeHint="Enabled" />
                                    </Border>
                                    <uc:HTMLViewer x:Name="htmlViewer"
                                                   HTML="{Binding LastHtml, Mode=OneWay}"
                                                   VerticalAlignment="Stretch"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   UseLayoutRounding="True" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>













