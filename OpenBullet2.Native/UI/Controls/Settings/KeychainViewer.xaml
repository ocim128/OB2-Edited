<UserControl x:Class="OpenBullet2.Native.Controls.KeychainViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBullet2.Native.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Consistent Keycheck Button Style -->
        <Style x:Key="ConsistentKeycheckButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="8,4">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="4"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" 
                                                  Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" 
                                           Text="{TemplateBinding Content}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" Opacity="0.4" BlurRadius="6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.5" BlurRadius="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border 
        Margin="5 2 0 2"
        BorderThickness="3"
        BorderBrush="{Binding BorderBrush}"
        CornerRadius="10"
        Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Result status:" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Statuses}"
                    SelectedValue="{Binding ResultStatus}" />

                <Label Grid.Column="2" Content="Mode:" />
                <ComboBox
                    Grid.Column="3"
                    ItemsSource="{Binding Modes}"
                    SelectedValue="{Binding Mode}" />

                <Button Click="MoveUp" 
                        Grid.Column="5"
                        Width="32" Height="28"
                        ToolTip="Move the keychain up"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#2563EB" 
                        Foreground="White"
                        Content="">
                    <Button.Tag>
                        <iconPacks:PackIconUnicons Kind="AngleUp" Width="14" Height="14" Foreground="White"/>
                    </Button.Tag>
                </Button>
                <Button Click="MoveDown" 
                        Grid.Column="6"
                        Width="32" Height="28"
                        ToolTip="Move the keychain down"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#2563EB" 
                        Foreground="White"
                        Content="">
                    <Button.Tag>
                        <iconPacks:PackIconUnicons Kind="AngleDown" Width="14" Height="14" Foreground="White"/>
                    </Button.Tag>
                </Button>
                <Button Click="Delete" 
                        Grid.Column="7"
                        Width="32" Height="28"
                        ToolTip="Remove the keychain"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#DC2626" 
                        Foreground="White"
                        Content="">
                    <Button.Tag>
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="White"/>
                    </Button.Tag>
                </Button>

            </Grid>

            <StackPanel Orientation="Horizontal" 
                        Margin="0 8"
                        Grid.Row="1">
                <Button Click="AddStringKey" 
                        Margin="0 0 8 0" 
                        Width="70"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#10B981" 
                        Foreground="White"
                        Content="String">
                    <Button.Tag>
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" Foreground="White"/>
                    </Button.Tag>
                </Button>
                
                <Button Click="AddBoolKey" 
                        Margin="0 0 8 0" 
                        Width="60"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#10B981" 
                        Foreground="White"
                        Content="Bool">
                    <Button.Tag>
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" Foreground="White"/>
                    </Button.Tag>
                </Button>
                
                <Button Click="AddIntKey" 
                        Margin="0 0 8 0" 
                        Width="50"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#10B981" 
                        Foreground="White"
                        Content="Int">
                    <Button.Tag>
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" Foreground="White"/>
                    </Button.Tag>
                </Button>
                
                <Button Click="AddFloatKey" 
                        Margin="0 0 8 0" 
                        Width="60"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#10B981" 
                        Foreground="White"
                        Content="Float">
                    <Button.Tag>
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" Foreground="White"/>
                    </Button.Tag>
                </Button>
                
                <Button Click="AddListKey" 
                        Margin="0 0 8 0" 
                        Width="60"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#10B981" 
                        Foreground="White"
                        Content="List">
                    <Button.Tag>
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" Foreground="White"/>
                    </Button.Tag>
                </Button>
                
                <Button Click="AddDictionaryKey" 
                        Margin="0 0 8 0" 
                        Width="90"
                        Style="{StaticResource ConsistentKeycheckButton}"
                        Background="#10B981" 
                        Foreground="White"
                        Content="Dictionary">
                    <Button.Tag>
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" Foreground="White"/>
                    </Button.Tag>
                </Button>
            </StackPanel>

            <StackPanel x:Name="keysPanel" Grid.Row="2" />

        </Grid>
    </Border>
</UserControl>
