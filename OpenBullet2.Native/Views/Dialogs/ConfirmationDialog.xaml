<UserControl x:Class="OpenBullet2.Native.Views.Dialogs.ConfirmationDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    
    <Border Background="#FF2A2A2A" 
            CornerRadius="8" 
            BorderBrush="#FF404040" 
            BorderThickness="1"
            MinWidth="500"
            MaxWidth="700"
            MinHeight="200">
        <Grid Margin="20">
        <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding Title}"
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="White" 
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"/>

            <!-- Icon -->
            <iconPacks:PackIconMaterial Grid.Row="1"
                                        Kind="HelpCircle"
                                        Width="48"
                                        Height="48"
                                        Foreground="#FF1E90FF"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,20"/>

            <!-- Message -->
            <TextBlock Grid.Row="2" 
                       Text="{Binding Message}"
                       FontSize="13" 
                       Foreground="#FFCCCCCC" 
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"
                       LineHeight="18"/>

        <!-- Buttons using consistent styling -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                
                <Button Name="YesButton"
                        Content="Yes"
                        Click="YesButton_Click"
                        Style="{StaticResource StyledPrimaryButton}"
                        Width="100"
                        Margin="0,0,10,0"/>

                <Button Name="NoButton"
                        Content="No"
                        Click="NoButton_Click"
                        Style="{StaticResource StyledButton}"
                        Width="100"/>
            </StackPanel>
    </Grid>
    </Border>
</UserControl>