<Page x:Class="OpenBullet2.Native.Views.Pages.OBSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenBullet2.Native.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d" 
      d:DesignHeight="1550" d:DesignWidth="800"
      Title="OBSettings">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Premium Settings Card Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Modern.BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernHeading3}">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource Modern.ThemeMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Setting Label Style -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernBodyText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,16,8"/>
        </Style>

        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernCaptionText}">
             <Setter Property="Foreground" Value="{StaticResource Modern.ForegroundSecondary}"/>
             <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Page.Resources>
    
    <!-- Modern OpenBullet Settings Layout -->
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      ScrollViewer.IsDeferredScrollingEnabled="False">
            <StackPanel Margin="0,0,0,20">
                
                <!-- General Settings Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1E3A5F" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="{StaticResource Modern.ThemeMain}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="General Settings" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Config Edit Navigation -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="On config edit, navigate to:" Style="{StaticResource SettingLabelStyle}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="configSectionOnLoadCombobox" SelectedValue="{Binding Path=ConfigSectionOnLoad}" Width="250" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource CleanComboBox}"/>

                            <!-- Default Author -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Default author for new configs:" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultAuthor}" Width="250" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource MatchingTextBox}"/>

                            <!-- Log Buffer Size -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Job log buffer size:" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="20" Maximum="10000" Interval="1" Value="{Binding LogBufferSize}" Width="150" HorizontalAlignment="Left" Margin="0,8"/>

                            <!-- Auto-save Interval -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Auto-save interval (seconds):" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="5" Maximum="3600" Interval="1" Value="{Binding AutoSaveInterval}" Width="150" HorizontalAlignment="Left" Margin="0,8"/>

                            <!-- Checkboxes -->
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Automatically set Recommended Bots" IsChecked="{Binding AutoSetRecommendedBots}" Margin="0,4"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="View warning when config is not saved" IsChecked="{Binding WarnConfigNotSaved}" Margin="0,4"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Enable logging in the job viewer page" IsChecked="{Binding EnableJobLogging}" Margin="0,4"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Group captures in debugger" IsChecked="{Binding GroupCapturesInDebugger}" Margin="0,4"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Ignore wordlist name when removing duplicates from hits" IsChecked="{Binding IgnoreWordlistNameOnHitsDedupe}" Margin="0,4"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,8">
                                <CheckBox Content="Ask for confirmation before destructive actions" IsChecked="{Binding PerformConfirmationOnDestructiveActions}" Margin="0,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Proxy Check Targets Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#064E3B" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Target" Width="16" Height="16" Foreground="{StaticResource Modern.Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Proxy Check Targets" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Define the targets used to check proxies functionality." Style="{StaticResource SettingDescriptionStyle}"/>
                        
                        <Button Click="AddProxyCheckTarget" 
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Target" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ItemsControl x:Name="proxyCheckTargetsControl" ItemsSource="{Binding ProxyCheckTargetsCollection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Url" Margin="0,0,8,0" Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Url}" Margin="0,0,16,0" Style="{StaticResource MatchingTextBox}" />
                                            
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Success Key" Margin="0,0,8,0" Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                                            <TextBox Grid.Column="3" Text="{Binding SuccessKey}" Margin="0,0,16,0" Style="{StaticResource MatchingTextBox}" />
                                            
                                            <Button x:Name="removeProxyCheckTargetButton" Tag="{Binding}" Grid.Column="4" 
                                                    Click="RemoveProxyCheckTarget" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Modern.BorderSecondary}" Margin="0,24"/>

                        <TextBlock Text="Custom Editor Snippets" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Modern.ForegroundMain}" Margin="0,0,0,4"/>
                        <TextBlock Text="(requires restart)" Style="{StaticResource SettingDescriptionStyle}"/>
                        
                        <Button Click="AddCustomSnippet" 
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Snippet" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <ItemsControl ItemsSource="{Binding CustomSnippetsCollection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="100" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Name" Margin="0,0,8,0" Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,16,8" Style="{StaticResource MatchingTextBox}" />
                                            
                                            <Button Tag="{Binding}" Grid.Row="0" Grid.Column="2" 
                                                    Click="RemoveCustomSnippet" Style="{StaticResource ModernDangerButton}" Padding="8" VerticalAlignment="Top">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                            </Button>
                                            
                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Desc" Margin="0,0,8,0" Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" Margin="0,0,0,8" Style="{StaticResource MatchingTextBox}" />
                                            
                                            <TextBox Grid.Row="2" Grid.ColumnSpan="3" VerticalContentAlignment="Top" AcceptsReturn="True" Text="{Binding Body}" Style="{StaticResource MatchingTextBox}" 
                                                     FontFamily="Consolas"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Remote Configuration Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#78350F" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="CloudDownload" Width="16" Height="16" Foreground="{StaticResource Modern.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Remote Configuration" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Manage remote endpoints to fetch configurations." Style="{StaticResource SettingDescriptionStyle}"/>
                        
                        <Button Click="AddRemoteConfigsEndpoint" 
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Endpoint" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <ItemsControl x:Name="remoteConfigsEndpointsControl" 
                                      ItemsSource="{Binding RemoteConfigsEndpointsCollection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Modern.BackgroundTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Url" Margin="0,0,8,0" Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Url}" Margin="0,0,16,0" Style="{StaticResource MatchingTextBox}" />
                                            
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Key" Margin="0,0,8,0" Foreground="{StaticResource Modern.ForegroundSecondary}"/>
                                            <TextBox Grid.Column="3" Text="{Binding ApiKey}" Margin="0,0,16,0" Style="{StaticResource MatchingTextBox}" />
                                            
                                            <Button x:Name="removeRemoteConfigsEndpointButton" Tag="{Binding}" Grid.Column="4" 
                                                    Click="RemoveRemoteConfigsEndpoint" Style="{StaticResource ModernDangerButton}" Padding="8">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Customization Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#7F1D1D" Margin="0,0,12,0">
                                <iconPacks:PackIconMaterial Kind="Palette" Width="16" Height="16" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="UI Customization" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </StackPanel>
                        
                        <!-- Customization Options -->
                        <CheckBox Content="Play a sound when a hit is found" IsChecked="{Binding PlaySoundOnHit}" Margin="0,8"/>
                        <CheckBox Content="Enable Word Wrap in text editor" IsChecked="{Binding WordWrap}" Margin="0,8,0,24"/>

                        <TextBlock Text="Background Colors" Style="{StaticResource SettingLabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Main" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding BackgroundMain}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Secondary" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding BackgroundSecondary}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Inputs" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding BackgroundInput}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Foreground Colors" Style="{StaticResource SettingLabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Main" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundMain}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                                <TextBlock Text="Good" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundGood}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,12">
                                <TextBlock Text="Bad" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundBad}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Custom" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundCustom}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12">
                                <TextBlock Text="Retry" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundRetry}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,12">
                                <TextBlock Text="Banned" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundBanned}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="To Check" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundToCheck}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,12">
                                <TextBlock Text="Menu Selected" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundMenuSelected}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,12">
                                <TextBlock Text="Inputs" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundInput}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Button Colors" Style="{StaticResource SettingLabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Success" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding SuccessButton}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                                <TextBlock Text="Primary" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding PrimaryButton}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,12">
                                <TextBlock Text="Warning" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding WarningButton}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Danger" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding DangerButton}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12">
                                <TextBlock Text="Foreground" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding ForegroundButton}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,12">
                                <TextBlock Text="Background" Style="{StaticResource ModernCaptionText}" Margin="0,0,0,4"/>
                                <mah:ColorPicker SelectedColor="{Binding BackgroundButton}" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                        
                        <Separator Background="{StaticResource Modern.BorderSecondary}" Margin="0,24"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Background Image" Margin="0,0,16,0" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding BackgroundImagePath, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MatchingTextBox}" />
                            
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Opacity" Margin="16,0,8,0" Style="{StaticResource SettingLabelStyle}"/>
                            <mah:NumericUpDown Grid.Column="3" Minimum="0" Maximum="100" Interval="1" Value="{Binding BackgroundOpacity}" Width="80"/>
                            
                            <Button Grid.Column="4" Margin="16,0,0,0" Click="ChooseBackgroundImage" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconForkAwesome Kind="File" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Choose" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        
                        <Image Source="{Binding BackgroundImage}" MaxWidth="150" MaxHeight="150" HorizontalAlignment="Left"
                               Visibility="{Binding ShowBackgroundImage, Converter={StaticResource ResourceKey=BoolToVis}}"
                               Margin="0,16,0,0"/>

                        <Button Click="ResetCustomization" 
                                Style="{StaticResource ModernWarningButton}"
                                HorizontalAlignment="Left"
                                Margin="0,24,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset Customization" VerticalAlignment="Center" Foreground="#1F2937"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons Footer -->
        <Border Grid.Row="1" 
                Background="{StaticResource Modern.BackgroundSecondary}" 
                BorderBrush="{StaticResource Modern.BorderSecondary}"
                BorderThickness="1"
                CornerRadius="12" 
                Padding="16" 
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="resetButton" Click="Reset" Style="{StaticResource ModernDangerButton}" Margin="0,0,12,0" Width="100">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Reset" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="saveButton" Click="Save" Style="{StaticResource ModernPrimaryButton}" Width="120">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Save Changes" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
